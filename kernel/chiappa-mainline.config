# reMarkable Paper Pro Move (chiappa) on mainline Linux.
# Merged over the arm64 defconfig; see kernel/mainline/README.md.

CONFIG_LOCALVERSION="-chiappa"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_PREEMPT=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
CONFIG_DEBUG_INFO_NONE=y

# Only the i.MX93 platform is relevant; dropping the rest keeps the build
# (which NixOS runs under emulation) tractable.
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_ARTPEC is not set
# CONFIG_ARCH_ASPEED is not set
# CONFIG_ARCH_AXIADO is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_BLAIZE is not set
# CONFIG_ARCH_BST is not set
# CONFIG_ARCH_CIX is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_MICROCHIP is not set
# CONFIG_ARCH_SPARX5 is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_MA35 is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_QCOM is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_TESLA_FSD is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set
CONFIG_ARCH_NXP=y
CONFIG_ARCH_MXC=y

# Not present on this board
# CONFIG_PCI is not set
# CONFIG_ACPI is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_XEN is not set
# CONFIG_NUMA is not set
# CONFIG_SOUND is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_DRM_FBDEV_EMULATION is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# CONFIG_LOGO is not set
# CONFIG_NFS_FS is not set
# CONFIG_ROOT_NFS is not set

# The Cortex-A55 implements neither pointer authentication, BTI nor MTE.
# CONFIG_ARM64_PTR_AUTH_KERNEL is not set
# CONFIG_ARM64_BTI_KERNEL is not set
# CONFIG_ARM64_MTE is not set

# i.MX93 SoC
CONFIG_CLK_IMX93=y
CONFIG_PINCTRL_IMX93=y
CONFIG_IMX93_ADC=y
CONFIG_I2C_IMX_LPI2C=y
CONFIG_SPI_FSL_LPSPI=y
CONFIG_SERIAL_FSL_LPUART=y
CONFIG_SERIAL_FSL_LPUART_CONSOLE=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_IMX7ULP_WDT=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_ESDHC_IMX=y
CONFIG_PWRSEQ_SIMPLE=y
CONFIG_DMADEVICES=y
CONFIG_FSL_EDMA=y
CONFIG_NVMEM=y
CONFIG_NVMEM_IMX_OCOTP_ELE=y
CONFIG_NVMEM_SNVS_LPGPR=y
CONFIG_NVMEM_REBOOT_MODE=y
CONFIG_RTC_DRV_BBNSM=y
CONFIG_INPUT_BBNSM_PWRKEY=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_PCA9450=y
CONFIG_REGULATOR_USERSPACE_CONSUMER=y
CONFIG_CPU_FREQ=y
CONFIG_CPUFREQ_DT=y
CONFIG_ARM_IMX_CPUFREQ_DT=y
CONFIG_CPU_IDLE=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_THERMAL=y
CONFIG_QORIQ_THERMAL=y
CONFIG_HWMON=y
CONFIG_SENSORS_NTC_THERMISTOR=y
CONFIG_IIO=y
CONFIG_IIO_ST_ACCEL_3AXIS=m
CONFIG_IIO_ST_ACCEL_I2C_3AXIS=m
CONFIG_GPIO_CDEV_V1=y
CONFIG_I2C_CHARDEV=y
CONFIG_SPI_SPIDEV=m

# reMarkable board drivers (ported from the vendor BSP)
CONFIG_REMARKABLE_PLATFORM=y
CONFIG_REMARKABLE_LPGPR=y
CONFIG_SLG46824_WAKEUP=m
CONFIG_MFD_SLG46824=m
CONFIG_GPIO_SLG46824=m
CONFIG_REGULATOR_SLG46824=m
CONFIG_MFD_MAX77818=y
CONFIG_BATTERY_MAX77818=y
CONFIG_CHARGER_MAX77818=m
CONFIG_REGULATOR_G2194=y
CONFIG_TYPEC=y
CONFIG_TYPEC_FUSB303B=m
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_ELAN_SPI=m
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_AW99703=m
CONFIG_NFC=m
CONFIG_NFC_NXP_CTN730_RM=m
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=m
CONFIG_KEYBOARD_GPIO=y

# Display: LCDIF -> parallel display format converter -> cumulus panel,
# plus VKMS for the Wayland-on-e-ink bridge.
CONFIG_DRM=y
CONFIG_DRM_MXS=y
CONFIG_DRM_IMX_LCDIF=y
CONFIG_DRM_IMX93_PDFC=y
CONFIG_DRM_PANEL_REMARKABLE_CUMULUS=y
CONFIG_DRM_VKMS=m

# USB: ChipIdea OTG with the configfs ECM gadget built in, so the headless
# USB link needs no module loading.
CONFIG_USB=y
CONFIG_USB_OTG=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_CHIPIDEA=y
CONFIG_USB_CHIPIDEA_UDC=y
CONFIG_USB_CHIPIDEA_HOST=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_F_FS=y
# CONFIG_USB_ETH is not set
CONFIG_USB_HID=m

# Wireless: NXP IW611 (out-of-tree driver) + Bluetooth over UART
CONFIG_WLAN=y
CONFIG_CFG80211=m
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=m
CONFIG_RFKILL=m
CONFIG_BT=m
CONFIG_BT_NXPUART=m

# Networking: nftables firewall, WireGuard
CONFIG_NETFILTER_NETLINK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_REJECT_INET=m
CONFIG_NFT_FIB=m
CONFIG_NFT_FIB_INET=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_COMPAT=m
CONFIG_WIREGUARD=m
CONFIG_TUN=m

# NixOS / systemd requirements
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_DMIID=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_FHANDLE=y
CONFIG_SECCOMP=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_SHA256=y
CONFIG_BINFMT_MISC=m
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_OVERLAY_FS=m
CONFIG_FUSE_FS=m
CONFIG_VFAT_FS=y
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# The vendor U-Boot passes dm-mod.create= for its encrypted swap on p4;
# with DM_INIT off those arguments are ignored and p4 stays free.
# CONFIG_DM_INIT is not set

# Debugging without a UART: crash logs survive in RAM for the next boot.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_MAGIC_SYSRQ=y

# Trim defconfig drivers this board cannot have (build time under emulation).
# CONFIG_WLAN_VENDOR_ADMTEK is not set
# CONFIG_WLAN_VENDOR_ATH is not set
# CONFIG_WLAN_VENDOR_ATMEL is not set
# CONFIG_WLAN_VENDOR_BROADCOM is not set
# CONFIG_WLAN_VENDOR_INTEL is not set
# CONFIG_WLAN_VENDOR_INTERSIL is not set
# CONFIG_WLAN_VENDOR_MARVELL is not set
# CONFIG_WLAN_VENDOR_MEDIATEK is not set
# CONFIG_WLAN_VENDOR_MICROCHIP is not set
# CONFIG_WLAN_VENDOR_PURELIFI is not set
# CONFIG_WLAN_VENDOR_RALINK is not set
# CONFIG_WLAN_VENDOR_REALTEK is not set
# CONFIG_WLAN_VENDOR_RSI is not set
# CONFIG_WLAN_VENDOR_SILABS is not set
# CONFIG_WLAN_VENDOR_ST is not set
# CONFIG_WLAN_VENDOR_TI is not set
# CONFIG_WLAN_VENDOR_ZYDAS is not set
# CONFIG_WLAN_VENDOR_QUANTENNA is not set
# CONFIG_DRM_HDLCD is not set
# CONFIG_DRM_MALI_DISPLAY is not set
# CONFIG_DRM_KOMEDA is not set
# CONFIG_DRM_ETNAVIV is not set
# CONFIG_DRM_HISI_KIRIN is not set
# CONFIG_DRM_POWERVR is not set
# CONFIG_DRM_IMX_DCSS is not set
# CONFIG_DRM_LIMA is not set
# CONFIG_DRM_MXSFB is not set
# CONFIG_DRM_PANFROST is not set
# CONFIG_DRM_PANTHOR is not set
# CONFIG_DRM_PL111 is not set
# CONFIG_DRM_TIDSS is not set
# CONFIG_DRM_NWL_MIPI_DSI is not set
# CONFIG_DRM_SAMSUNG_DSIM is not set
# CONFIG_DRM_CDNS_DSI is not set
# CONFIG_DRM_CDNS_MHDP8546 is not set
# CONFIG_DRM_DW_HDMI is not set
# CONFIG_DRM_IMX8MP_DW_HDMI_BRIDGE is not set
# CONFIG_DRM_IMX8MP_HDMI_PAI is not set
# CONFIG_DRM_IMX8MP_HDMI_PVI is not set
# CONFIG_DRM_FSL_LDB is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_UBIFS_FS is not set
# CONFIG_9P_FS is not set
# CONFIG_STAGING is not set
# CONFIG_ATA is not set
# CONFIG_MD is not set
# CONFIG_FPGA is not set
# CONFIG_REMOTEPROC is not set
# CONFIG_VIRTIO_MENU is not set
