From c7274cfa218ba2841f00287d64f8a63c8a644de5 Mon Sep 17 00:00:00 2001
From: gitman-101111 <development@spamfolder.xyz>
Date: Mon, 12 Oct 2026 10:23:08 -0600
Subject: [PATCH] usb: chipidea: publish the gadget on the legacy USB PHY

Register the gadget with the usb_phy's OTG descriptor when a gadget
driver binds, and clear it when it unbinds, as the downstream i.MX tree
does. Type-C port controllers that are not part of the TCPM framework
(the FUSB303B here) read usb_phy->otg->gadget->state to tell a
configured bus-powered connection from a bare attach when choosing the
charger input current.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 drivers/usb/chipidea/udc.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/drivers/usb/chipidea/udc.c b/drivers/usb/chipidea/udc.c
index d52f89489..47e5df661 100644
--- a/drivers/usb/chipidea/udc.c
+++ b/drivers/usb/chipidea/udc.c
@@ -2148,6 +2148,9 @@ static int ci_udc_start(struct usb_gadget *gadget,
 
 	ci->driver = driver;
 
+	if (!IS_ERR_OR_NULL(ci->usb_phy))
+		otg_set_peripheral(ci->usb_phy->otg, &ci->gadget);
+
 	/* Start otg fsm for B-device */
 	if (ci_otg_is_fsm_mode(ci) && ci->fsm.id) {
 		ci_hdrc_otg_fsm_start(ci);
@@ -2189,6 +2192,9 @@ static int ci_udc_stop(struct usb_gadget *gadget)
 	spin_lock_irqsave(&ci->lock, flags);
 	ci->driver = NULL;
 
+	if (!IS_ERR_OR_NULL(ci->usb_phy))
+		otg_set_peripheral(ci->usb_phy->otg, NULL);
+
 	if (ci->vbus_active) {
 		hw_device_state(ci, 0);
 		spin_unlock_irqrestore(&ci->lock, flags);
