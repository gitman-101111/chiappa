diff --git a/drivers/regulator/slg46824-regulator.c b/drivers/regulator/slg46824-regulator.c
new file mode 100644
index 000000000..0c900b494
--- /dev/null
+++ b/drivers/regulator/slg46824-regulator.c
@@ -0,0 +1,151 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (C) 2025 reMarkable
+ * Current limiter for use with the slg46824-mfd
+ */
+
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/regulator/driver.h>
+
+#define SLG46824_REG_ACMP1L_VREF	0x8C
+#define SLG46824_ACMP1L_VREF_MASK	GENMASK(7, 2)
+#define SLG46824_ACMP1L_VREF_SHIFT	2
+#define SLG46824_COMPARATOR_STEPSIZE	32
+
+struct slg46824 {
+	u32 acmp1_input_factor;
+};
+
+static int slg46824_regulator_set_current_limit(struct regulator_dev *rdev,
+						int min_uA, int max_uA)
+{
+	struct slg46824 *priv = rdev_get_drvdata(rdev);
+	u64 step_vref = max_uA;
+	u64 step_rem;
+
+	/* vref = (current(ma) * acmp1_input_factor) / (1000000 * stepsize) */
+	do_div(step_vref, 1000);
+	step_vref *= priv->acmp1_input_factor;
+	do_div(step_vref, 1000000);
+	step_rem = do_div(step_vref, SLG46824_COMPARATOR_STEPSIZE);
+
+	/* In case of reminder, check if we should round up vref */
+	if (step_rem) {
+		step_rem *= 10;
+		do_div(step_rem, SLG46824_COMPARATOR_STEPSIZE);
+		if (step_rem >= 5)
+			step_vref += 1;
+	}
+
+	step_vref <<= SLG46824_ACMP1L_VREF_SHIFT;
+
+	dev_info(&rdev->dev, "%s ua %d vref %llx\n", __func__, max_uA, step_vref);
+
+	return regmap_update_bits(rdev->regmap, SLG46824_REG_ACMP1L_VREF,
+				  SLG46824_ACMP1L_VREF_MASK, step_vref);
+}
+
+static int slg46824_regulator_get_current_limit(struct regulator_dev *rdev)
+{
+	struct slg46824 *priv = rdev_get_drvdata(rdev);
+	unsigned int vref;
+	u64 current_ma;
+	int ret;
+
+	ret = regmap_read(rdev->regmap, SLG46824_REG_ACMP1L_VREF, &vref);
+	if (ret)
+		return ret;
+
+	vref >>= SLG46824_ACMP1L_VREF_SHIFT;
+
+	/* 0 = 32mV */
+	vref = (vref + 1) * SLG46824_COMPARATOR_STEPSIZE;
+
+	current_ma = vref * 1000000;
+	do_div(current_ma, priv->acmp1_input_factor);
+
+	/* report in uA */
+	return current_ma * 1000;
+}
+
+static int slg46824_regulator_acmp1_of_parse_cb(struct device_node *np,
+						const struct regulator_desc *desc,
+						struct regulator_config *cfg)
+{
+	struct slg46824 *priv = cfg->driver_data;
+	u32 input_factor;
+	int ret;
+
+	ret = of_property_read_u32(np, "acmp1,input-factor", &input_factor);
+	if (ret)
+		return ret;
+
+	priv->acmp1_input_factor = input_factor;
+
+	return ret;
+}
+
+static const struct regulator_ops slg46824_current_acmp1_ops = {
+	.set_current_limit = slg46824_regulator_set_current_limit,
+	.get_current_limit = slg46824_regulator_get_current_limit
+};
+
+static struct regulator_desc slg46824_acmp1_desc = {
+	.name = "acmp1",
+	.id = 0,
+	.ops = &slg46824_current_acmp1_ops,
+	.type = REGULATOR_CURRENT,
+	.owner = THIS_MODULE,
+	.regulators_node = of_match_ptr("regulators"),
+	.of_match = of_match_ptr("acmp1"),
+	.of_parse_cb = slg46824_regulator_acmp1_of_parse_cb,
+};
+
+static int slg46824_regulator_probe(struct platform_device *pdev)
+{
+	struct regulator_config config = { };
+	struct regulator_dev *rdev;
+	struct regmap *regmap;
+	struct slg46824 *priv;
+
+	priv = devm_kzalloc(&pdev->dev, sizeof(struct slg46824), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	regmap = dev_get_regmap(pdev->dev.parent, NULL);
+	if (!regmap)
+		return dev_err_probe(&pdev->dev, -ENODEV, "Parent device not found\n");
+
+	config.dev = &pdev->dev;
+	config.driver_data = priv;
+	config.regmap = regmap;
+
+	rdev = devm_regulator_register(&pdev->dev, &slg46824_acmp1_desc, &config);
+	if (IS_ERR(rdev))
+		return dev_err_probe(pdev->dev.parent, PTR_ERR(rdev),
+				     "Failed to register %s regulator\n",
+				     pdev->name);
+
+	return 0;
+}
+
+static const struct of_device_id slg46824_regulator_of_match[] = {
+	{ .compatible = "renesas,slg46824-regulator", },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, slg46824_regulator_of_match);
+
+static struct platform_driver slg46824_regulator_driver = {
+	.driver = {
+		.name = "slg46824-regulator",
+		.of_match_table = slg46824_regulator_of_match,
+	},
+	.probe = slg46824_regulator_probe,
+};
+module_platform_driver(slg46824_regulator_driver);
+
+MODULE_AUTHOR("Morten Schade Fla <morten.schade.fla@remarkable.no>");
+MODULE_DESCRIPTION("SLG46824 Regulator Controller");
+MODULE_LICENSE("GPL");
