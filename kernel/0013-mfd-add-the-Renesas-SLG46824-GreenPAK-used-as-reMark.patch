diff --git a/drivers/gpio/gpio-slg46824.c b/drivers/gpio/gpio-slg46824.c
new file mode 100644
index 000000000..89593c2aa
--- /dev/null
+++ b/drivers/gpio/gpio-slg46824.c
@@ -0,0 +1,123 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (C) 2024 reMarkable
+ * GPIO driver for controlling the i2c virtual inputs (output from cpu pov)
+ */
+
+#include <linux/gpio/driver.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/kernel.h>
+
+#define SLG46824_REG_I2C_VIRTUAL_INPUT	0x7A
+
+/* gpio0 is MSB */
+#define SLG46824_GPIO(x) BIT(7-x)
+
+struct slg46824_gpio {
+	struct device *dev;
+	struct regmap *regmap;
+	struct gpio_chip chip;
+};
+
+static int slg46824_gpio_get_direction(struct gpio_chip *chip, unsigned int offset)
+{
+	/* This device is output only */
+	return GPIO_LINE_DIRECTION_OUT;
+}
+
+static int slg46824_gpio_direction_input(struct gpio_chip *chip, unsigned int offset)
+{
+	/* This device is output only */
+	return -EINVAL;
+}
+
+static int slg46824_gpio_direction_output(struct gpio_chip *chip, unsigned int offset, int value)
+{
+	struct slg46824_gpio *priv = gpiochip_get_data(chip);
+
+	return regmap_update_bits(priv->regmap, SLG46824_REG_I2C_VIRTUAL_INPUT,
+				  SLG46824_GPIO(offset), value ? SLG46824_GPIO(offset) : 0);
+}
+
+static int slg46824_gpio_get(struct gpio_chip *chip, unsigned int offset)
+{
+	struct slg46824_gpio *priv = gpiochip_get_data(chip);
+	int ret, val;
+
+	ret = regmap_read(priv->regmap, SLG46824_REG_I2C_VIRTUAL_INPUT, &val);
+	if (ret < 0)
+		return ret;
+
+	return val & SLG46824_GPIO(offset);
+}
+
+static int slg46824_gpio_set(struct gpio_chip *chip, unsigned int offset, int value)
+{
+	return slg46824_gpio_direction_output(chip, offset, value);
+}
+
+static const struct gpio_chip slg46824_chip = {
+	.label = "slg46824-gpio",
+	.owner = THIS_MODULE,
+	.get_direction		= slg46824_gpio_get_direction,
+	.direction_input	= slg46824_gpio_direction_input,
+	.direction_output	= slg46824_gpio_direction_output,
+	.get			= slg46824_gpio_get,
+	.set			= slg46824_gpio_set,
+	.base			= -1,
+	.ngpio			= 8,
+	.can_sleep		= true,
+};
+
+static int slg46824_gpio_probe(struct platform_device *pdev)
+{
+	struct slg46824_gpio *priv;
+	struct regmap *regmap;
+	int ret;
+
+	regmap = dev_get_regmap(pdev->dev.parent, NULL);
+	if (!regmap) {
+		dev_err(&pdev->dev, "Parent device not found\n");
+		return -ENODEV;
+	}
+
+	priv = devm_kzalloc(&pdev->dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->chip = slg46824_chip;
+	priv->chip.parent = &pdev->dev;
+
+	priv->dev = &pdev->dev;
+	priv->regmap = regmap;
+
+	ret = devm_gpiochip_add_data(&pdev->dev, &priv->chip, priv);
+	if (ret) {
+		dev_err(&pdev->dev, "Failed to register gpiochip: %d\n", ret);
+		return ret;
+	}
+
+	platform_set_drvdata(pdev, priv);
+	return 0;
+}
+
+static const struct of_device_id slg46824_gpio_of_match[] = {
+	{ .compatible = "renesas,slg46824-gpio", },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, slg46824_gpio_of_match);
+
+static struct platform_driver slg46824_gpio_driver = {
+	.driver = {
+		.name = "slg46824-gpio",
+		.of_match_table = slg46824_gpio_of_match,
+	},
+	.probe = slg46824_gpio_probe,
+};
+module_platform_driver(slg46824_gpio_driver);
+
+MODULE_AUTHOR("Morten Schade Fla <morten.schade.fla@remarkable.no>");
+MODULE_DESCRIPTION("Renesas SLG46824 GPIO driver for i2c virtual inputs");
+MODULE_LICENSE("GPL v2");
