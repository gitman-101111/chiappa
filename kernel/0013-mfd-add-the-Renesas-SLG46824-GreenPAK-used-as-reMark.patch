diff --git a/drivers/mfd/slg46824-mfd.c b/drivers/mfd/slg46824-mfd.c
new file mode 100644
index 000000000..47a05c1e4
--- /dev/null
+++ b/drivers/mfd/slg46824-mfd.c
@@ -0,0 +1,135 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (C) 2025 reMarkable
+ * MFD driver for SLG46824
+ */
+
+#include <linux/i2c.h>
+#include <linux/kernel.h>
+#include <linux/mfd/core.h>
+#include <linux/module.h>
+#include <linux/of_platform.h>
+#include <linux/regmap.h>
+
+#define SLG46824_REG_PATTERN_ID 0xCB
+
+struct slg46824 {
+	struct device *dev;
+	struct regmap *regmap;
+	u8 pattern_id;
+};
+
+static const struct regmap_config slg46824_regmap_config = {
+	.reg_bits = 8,
+	.val_bits = 8,
+};
+
+static ssize_t pattern_id_show(struct device *dev,
+			       struct device_attribute *attr, char *buf)
+{
+	struct slg46824 *priv = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "0x%02x\n", priv->pattern_id);
+}
+
+static DEVICE_ATTR_RO(pattern_id);
+
+static struct attribute *slg46824_attrs[] = {
+	&dev_attr_pattern_id.attr,
+	NULL,
+};
+
+static const struct attribute_group slg46824_attr_group = {
+	.attrs = slg46824_attrs,
+};
+
+static const struct mfd_cell slg46824_cells[] = {
+	{
+		.name = "slg46824-wakeup",
+		.of_compatible = "renesas,slg46824-wakeup",
+	},
+	{
+		.name = "slg46824-gpio",
+		.of_compatible = "renesas,slg46824-gpio",
+	},
+	{
+		.name = "slg46824-regulator",
+		.of_compatible = "renesas,slg46824-regulator",
+	},
+};
+
+static int slg46824_i2c_probe(struct i2c_client *i2c)
+{
+	struct slg46824 *priv;
+	int ret;
+
+	priv = devm_kzalloc(&i2c->dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	i2c_set_clientdata(i2c, priv);
+	priv->dev = &i2c->dev;
+
+	priv->regmap = devm_regmap_init_i2c(i2c, &slg46824_regmap_config);
+	if (IS_ERR(priv->regmap)) {
+		dev_err(&i2c->dev, "Failed to initialize regmap: %d\n", ret);
+		return PTR_ERR(priv->regmap);
+	}
+
+	/* Read pattern ID */
+	ret = regmap_read(priv->regmap, SLG46824_REG_PATTERN_ID, (int *)&priv->pattern_id);
+	if (ret) {
+		dev_err(&i2c->dev, "Failed to read pattern ID: %d\n", ret);
+		return ret;
+	}
+
+	/*
+	 * Clear DMA mask to avoid quirk with MFD system and the OF-parser. If
+	 * the mask is set, the OF-parser assumes the device will use DMA, and
+	 * will warn when it doesn't find the expected DMA entries in the DTS
+	 * node. This mask is inherited. By clearing it for the MFD top-level
+	 * device, sub-devices will also have their masks cleared. Note: this
+	 * does not affect parent devices/buses. F.ex. the I2C bus will use DMA
+	 * independent of the DMA mask of this device and its sub-devices.
+	 */
+	i2c->dev.coherent_dma_mask = 0;
+	i2c->dev.dma_mask = &i2c->dev.coherent_dma_mask;
+
+	ret = devm_mfd_add_devices(priv->dev, PLATFORM_DEVID_AUTO, slg46824_cells,
+				   ARRAY_SIZE(slg46824_cells), NULL, 0, NULL);
+	if (ret) {
+		dev_err(&i2c->dev, "Failed to add MFD devices: %d\n", ret);
+		return ret;
+	}
+
+	ret = sysfs_create_group(&i2c->dev.kobj, &slg46824_attr_group);
+	if (ret)
+		dev_err(&i2c->dev, "Failed to create sysfs group: %d\n", ret);
+
+	return ret;
+}
+
+static void slg46824_i2c_remove(struct i2c_client *i2c)
+{
+	sysfs_remove_group(&i2c->dev.kobj, &slg46824_attr_group);
+}
+
+static const struct of_device_id slg46824_of_match[] = {
+	{ .compatible = "renesas,slg46824" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, slg46824_of_match);
+
+static struct i2c_driver slg46824_i2c_driver = {
+	.driver = {
+		.name = "slg46824",
+		.of_match_table = of_match_ptr(slg46824_of_match),
+	},
+	.probe = slg46824_i2c_probe,
+	.remove = slg46824_i2c_remove,
+};
+module_i2c_driver(slg46824_i2c_driver);
+
+MODULE_AUTHOR("Viktor Korsnes <viktor.korsnes@remarkable.no>");
+MODULE_DESCRIPTION("MFD driver for SLG46824");
+MODULE_LICENSE("GPL");
