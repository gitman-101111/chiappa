diff --git a/drivers/platform/remarkable/slg46824_wakeup.c b/drivers/platform/remarkable/slg46824_wakeup.c
new file mode 100644
index 000000000..84dad5071
--- /dev/null
+++ b/drivers/platform/remarkable/slg46824_wakeup.c
@@ -0,0 +1,314 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (C) 2025 reMarkable
+ * Wakeup controller for use with the slg46824-mfg
+ */
+
+#include <linux/kernel.h>
+#include <linux/regmap.h>
+#include <linux/platform_device.h>
+#include <linux/of_platform.h>
+#include <linux/sysfs.h>
+#include <linux/gpio/consumer.h>
+#include <linux/reboot.h>
+#include <linux/suspend.h>
+
+#define SLG46824_REG_LATCH_STATUS       0x76
+
+#define SLG46824_WAKEUP_MASK		GENMASK(5, 2)
+
+enum wakeup_reason {
+	wakeup_reason_powerbutton	= BIT(2),
+	wakeup_reason_folio		= BIT(3),
+	wakeup_reason_marker		= BIT(4),
+	wakeup_reason_charger_connected	= BIT(5),
+};
+
+struct slg46824_wakeup {
+	struct device *dev;
+	struct regmap *regmap;
+	u8 wakeup_mask;
+	struct notifier_block pm_notifier;
+	bool hibernate;
+	struct gpio_desc *irq_mask_folio;
+	struct gpio_desc *irq_mask_pen;
+	struct gpio_desc *en_1v8_periph;
+	struct gpio_desc *irq_mask_low_battery;
+	struct gpio_desc *flag_soc_is_in_suspend;
+	struct gpio_desc *latch_reset;
+};
+
+static int slg46824_get_wakeup_mask(struct slg46824_wakeup *priv)
+{
+	unsigned int reg = 0;
+	int ret;
+
+	ret = regmap_read(priv->regmap, SLG46824_REG_LATCH_STATUS, &reg);
+	if (ret < 0)
+		return ret;
+
+	priv->wakeup_mask = (u8)reg & SLG46824_WAKEUP_MASK;
+
+	return ret;
+}
+
+static void slg46824_reset_wakeup_latches(struct slg46824_wakeup *priv)
+{
+	gpiod_set_value_cansleep(priv->latch_reset, 1);
+	gpiod_set_value_cansleep(priv->latch_reset, 0);
+}
+
+static void slg46824_unmask_wakeup_irqs(struct slg46824_wakeup *priv)
+{
+	gpiod_set_value_cansleep(priv->irq_mask_folio, 0);
+	gpiod_set_value_cansleep(priv->irq_mask_pen, 0);
+	gpiod_set_value_cansleep(priv->irq_mask_low_battery, 0);
+}
+
+static void slg46824_mask_wakeup_irqs(struct slg46824_wakeup *priv)
+{
+	gpiod_set_value_cansleep(priv->irq_mask_folio, 1);
+	gpiod_set_value_cansleep(priv->irq_mask_pen, 1);
+	gpiod_set_value_cansleep(priv->irq_mask_low_battery, 1);
+}
+
+static void slg46824_wakeup_mask_to_string(u8 mask, char *string, size_t len)
+{
+	if (mask == 0) {
+		strlcat(string, "N/A ", len);
+		return;
+	}
+
+	if (mask & wakeup_reason_powerbutton)
+		strlcat(string, "powerbutton ", len);
+	if (mask & wakeup_reason_folio)
+		strlcat(string, "folio ", len);
+	if (mask & wakeup_reason_marker)
+		strlcat(string, "marker ", len);
+	if (mask & wakeup_reason_charger_connected)
+		strlcat(string, "charger_connected ", len);
+}
+
+static ssize_t wakeup_reason_show(struct device *dev,
+				  struct device_attribute *attr, char *buf)
+{
+	struct slg46824_wakeup *priv = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "0x%02x\n", priv->wakeup_mask);
+}
+
+static DEVICE_ATTR_RO(wakeup_reason);
+
+static struct attribute *slg46824_wakeup_attrs[] = {
+	&dev_attr_wakeup_reason.attr,
+	NULL,
+};
+
+static const struct attribute_group slg46824_wakeup_attr_group = {
+	.attrs = slg46824_wakeup_attrs,
+};
+
+static int slg46824_wakeup_pm_notifier(struct notifier_block *nb,
+				       unsigned long pm_event, void *_unused)
+{
+	struct slg46824_wakeup *priv =
+		container_of(nb, struct slg46824_wakeup, pm_notifier);
+
+	switch (pm_event) {
+	case PM_HIBERNATION_PREPARE:
+		priv->hibernate = true;
+		break;
+	case PM_POST_HIBERNATION:
+		priv->hibernate = false;
+		break;
+	default:
+		break;
+	}
+
+	return NOTIFY_DONE;
+}
+
+static void slg46824_prepare_for_suspend(struct slg46824_wakeup *priv)
+{
+	slg46824_reset_wakeup_latches(priv);
+	slg46824_unmask_wakeup_irqs(priv);
+	gpiod_set_value_cansleep(priv->en_1v8_periph, 1);
+	gpiod_set_value_cansleep(priv->flag_soc_is_in_suspend, 1);
+}
+
+static int slg46824_poweroff_handler(struct sys_off_data *data)
+{
+	struct slg46824_wakeup *priv = data->cb_data;
+
+	if (!priv->hibernate)
+		return NOTIFY_DONE;
+
+	slg46824_prepare_for_suspend(priv);
+
+	return NOTIFY_DONE;
+}
+
+static void slg46824_wakeup_initialize(struct slg46824_wakeup *priv)
+{
+	slg46824_reset_wakeup_latches(priv);
+	slg46824_mask_wakeup_irqs(priv);
+	gpiod_set_value_cansleep(priv->en_1v8_periph, 0);
+	gpiod_set_value_cansleep(priv->flag_soc_is_in_suspend, 0);
+}
+
+static int slg46824_wakeup_probe(struct platform_device *pdev)
+{
+	struct slg46824_wakeup *priv;
+	struct regmap *regmap;
+	int ret;
+
+	regmap = dev_get_regmap(pdev->dev.parent, NULL);
+	if (!regmap) {
+		dev_err(&pdev->dev, "Parent device not found\n");
+		return -ENODEV;
+	}
+
+	priv = devm_kzalloc(&pdev->dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->dev = &pdev->dev;
+	priv->regmap = regmap;
+
+	priv->irq_mask_folio = devm_gpiod_get(&pdev->dev, "irq-mask-folio", GPIOD_OUT_LOW);
+	if (IS_ERR(priv->irq_mask_folio)) {
+		dev_err(&pdev->dev, "Failed to get irq-mask-folio gpio\n");
+		return PTR_ERR(priv->irq_mask_folio);
+	}
+
+	priv->irq_mask_pen = devm_gpiod_get(&pdev->dev, "irq-mask-pen", GPIOD_OUT_LOW);
+	if (IS_ERR(priv->irq_mask_pen)) {
+		dev_err(&pdev->dev, "Failed to get irq-mask-pen gpio\n");
+		return PTR_ERR(priv->irq_mask_pen);
+	}
+
+	priv->en_1v8_periph = devm_gpiod_get(&pdev->dev, "en-1v8-periph", GPIOD_OUT_LOW);
+	if (IS_ERR(priv->en_1v8_periph)) {
+		dev_err(&pdev->dev, "Failed to get en-1v8-periph gpio\n");
+		return PTR_ERR(priv->en_1v8_periph);
+	}
+
+	priv->irq_mask_low_battery = devm_gpiod_get(&pdev->dev, "irq-mask-low-bat", GPIOD_OUT_LOW);
+	if (IS_ERR(priv->irq_mask_low_battery)) {
+		dev_err(&pdev->dev, "Failed to get irq-mask-low-battery gpio\n");
+		return PTR_ERR(priv->irq_mask_low_battery);
+	}
+
+	priv->flag_soc_is_in_suspend =
+		devm_gpiod_get(&pdev->dev, "flag-soc-in-suspend", GPIOD_OUT_LOW);
+	if (IS_ERR(priv->flag_soc_is_in_suspend)) {
+		dev_err(&pdev->dev, "Failed to get flag-soc-is-in-suspend gpio\n");
+		return PTR_ERR(priv->flag_soc_is_in_suspend);
+	}
+
+	priv->latch_reset = devm_gpiod_get(&pdev->dev, "latch-reset", GPIOD_OUT_LOW);
+	if (IS_ERR(priv->latch_reset)) {
+		dev_err(&pdev->dev, "Failed to get latch-reset gpio\n");
+		return PTR_ERR(priv->latch_reset);
+	}
+
+	ret = slg46824_get_wakeup_mask(priv);
+	if (ret) {
+		dev_err(&pdev->dev, "Failed to get wakeup mask: %d\n", ret);
+		return ret;
+	}
+
+	slg46824_reset_wakeup_latches(priv);
+
+	ret = devm_register_sys_off_handler(priv->dev,
+					    SYS_OFF_MODE_POWER_OFF_PREPARE,
+					    SYS_OFF_PRIO_DEFAULT,
+					    slg46824_poweroff_handler, priv);
+	if (ret) {
+		dev_err(&pdev->dev, "Failed to register poweroff handler: %d\n", ret);
+		return ret;
+	}
+
+	priv->pm_notifier.notifier_call = slg46824_wakeup_pm_notifier;
+	ret = register_pm_notifier(&priv->pm_notifier);
+	if (ret)
+		return ret;
+
+	ret = sysfs_create_group(&pdev->dev.kobj, &slg46824_wakeup_attr_group);
+	if (ret) {
+		dev_err(&pdev->dev, "Failed to create sysfs group: %d\n", ret);
+		unregister_pm_notifier(&priv->pm_notifier);
+		return ret;
+	}
+
+	slg46824_wakeup_initialize(priv);
+
+	platform_set_drvdata(pdev, priv);
+	return 0;
+}
+
+static int slg46824_wakeup_suspend_hibernate(struct device *dev)
+{
+	struct platform_device *pdev = to_platform_device(dev);
+	struct slg46824_wakeup *priv = platform_get_drvdata(pdev);
+
+	slg46824_reset_wakeup_latches(priv);
+
+	slg46824_prepare_for_suspend(priv);
+
+	return 0;
+}
+
+static int slg46824_wakeup_resume_restore(struct device *dev)
+{
+	struct platform_device *pdev = to_platform_device(dev);
+	struct slg46824_wakeup *priv = platform_get_drvdata(pdev);
+	char log_buf[40] = {0};
+	int ret;
+
+	ret = slg46824_get_wakeup_mask(priv);
+	if (ret) {
+		dev_warn(dev, "unable to get wakeup reason\n");
+	} else {
+		slg46824_wakeup_mask_to_string(priv->wakeup_mask, log_buf, sizeof(log_buf));
+		dev_info(dev, "SPLD wakeup-reason (0x%02x): %s\n",
+			 priv->wakeup_mask, log_buf);
+	}
+
+	slg46824_wakeup_initialize(priv);
+
+	return 0;
+}
+
+static void slg46824_wakeup_remove(struct platform_device *pdev)
+{
+	struct slg46824_wakeup *priv = platform_get_drvdata(pdev);
+
+	sysfs_remove_group(&pdev->dev.kobj, &slg46824_wakeup_attr_group);
+	unregister_pm_notifier(&priv->pm_notifier);
+}
+
+static const struct dev_pm_ops slg46824_wakeup_pm_ops = {
+	SYSTEM_SLEEP_PM_OPS(slg46824_wakeup_suspend_hibernate, slg46824_wakeup_resume_restore)
+};
+
+static const struct of_device_id slg46824_wakeup_of_match[] = {
+	{ .compatible = "renesas,slg46824-wakeup", },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, slg46824_wakeup_of_match);
+
+static struct platform_driver slg46824_wakeup_driver = {
+	.driver = {
+		.name = "slg46824-wakeup",
+		.of_match_table = slg46824_wakeup_of_match,
+		.pm = &slg46824_wakeup_pm_ops,
+	},
+	.probe = slg46824_wakeup_probe,
+	.remove = slg46824_wakeup_remove,
+};
+module_platform_driver(slg46824_wakeup_driver);
+
+MODULE_AUTHOR("Viktor Korsnes <viktor.korsnes@remarkable.no>");
+MODULE_DESCRIPTION("SLG46824 Wakeup Controller");
+MODULE_LICENSE("GPL");
