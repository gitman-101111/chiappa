+	{ .temp_c	= 20, .ohm	= 12090 },
+	{ .temp_c	= 25, .ohm	= 10000 },
+	{ .temp_c	= 30, .ohm	= 8312 },
+	{ .temp_c	= 35, .ohm	= 6942 },
+	{ .temp_c	= 40, .ohm	= 5826 },
+	{ .temp_c	= 45, .ohm	= 4911 },
