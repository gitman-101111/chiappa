From 402d11eae9e5ce9c82591f36dae71adfd89655cc Mon Sep 17 00:00:00 2001
From: gitman-101111 <development@spamfolder.xyz>
Date: Mon, 12 Oct 2026 10:23:09 -0600
Subject: [PATCH] arm64: dts: freescale: add the reMarkable Paper Pro Move
 (chiappa)

NXP i.MX93 e-reader: eMMC root, IW611 WiFi on SDIO with Bluetooth over
LPUART3, ChipIdea USB-C gadget behind a FUSB303B, MAX77818 charger and
fuel gauge, PCA9451A system PMIC, G2194 EPD PMIC feeding the cumulus
e-paper panel over the 16-bit parallel display bus, Elan SPI touch/pen,
AW99703 front light, LIS2DW12 accelerometer, SLG46824 wake controller,
CTN730 marker charger, and the BBNSM GPR cells reMarkable's U-Boot uses
for A/B slot selection. Rewritten against the mainline SoC description
from reMarkable's downstream chiappa.dtsi; a ramoops region is reserved
since the serial console is only reachable by teardown.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/freescale/Makefile        |    1 +
 .../freescale/imx93-remarkable-chiappa.dts    | 1386 +++++++++++++++++
 2 files changed, 1387 insertions(+)
 create mode 100644 arch/arm64/boot/dts/freescale/imx93-remarkable-chiappa.dts

diff --git a/arch/arm64/boot/dts/freescale/Makefile b/arch/arm64/boot/dts/freescale/Makefile
index 8ddaab127..7232ac6c8 100644
--- a/arch/arm64/boot/dts/freescale/Makefile
+++ b/arch/arm64/boot/dts/freescale/Makefile
@@ -597,6 +597,7 @@ dtb-$(CONFIG_ARCH_MXC) += imx93-14x14-evk.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx93-kontron-bl-osm-s.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx93-phyboard-nash.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx93-phyboard-segin.dtb
+dtb-$(CONFIG_ARCH_MXC) += imx93-remarkable-chiappa.dtb
 
 imx93-phyboard-nash-jtag-dtbs += imx93-phyboard-nash.dtb imx93-phyboard-nash-jtag.dtbo
 imx93-phyboard-nash-peb-wlbt-07-dtbs += imx93-phyboard-nash.dtb imx93-phyboard-nash-peb-wlbt-07.dtbo
diff --git a/arch/arm64/boot/dts/freescale/imx93-remarkable-chiappa.dts b/arch/arm64/boot/dts/freescale/imx93-remarkable-chiappa.dts
new file mode 100644
index 000000000..22b05eb5d
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx93-remarkable-chiappa.dts
@@ -0,0 +1,1386 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * reMarkable Paper Pro Move (codename chiappa)
+ *
+ * Board support derived from reMarkable's downstream chiappa.dtsi
+ * (Copyright 2022 NXP, Copyright 2025 reMarkable AS), rewritten against
+ * the mainline i.MX93 SoC description.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/clock/imx93-clock.h>
+#include <dt-bindings/input/input.h>
+#include "imx93.dtsi"
+
+/ {
+	/*
+	 * Keep the vendor DT's model string: userspace (KoReader among others)
+	 * identifies the device through /sys/devices/soc0/machine.
+	 */
+	model = "reMarkable Chiappa";
+	compatible = "remarkable,chiappa", "fsl,imx93";
+
+	aliases {
+		gpio0 = &gpio1;
+		gpio1 = &gpio2;
+		gpio2 = &gpio3;
+		gpio3 = &gpio4;
+		i2c0 = &lpi2c1;
+		i2c1 = &lpi2c2;
+		i2c4 = &lpi2c5;
+		mmc0 = &usdhc1;
+		mmc2 = &usdhc3;
+		rtc0 = &bbnsm_rtc;
+		serial1 = &lpuart2;
+		serial2 = &lpuart3;
+	};
+
+	chosen {
+		stdout-path = &lpuart2;
+	};
+
+	a55_opp_table: opp-table {
+		compatible = "operating-points-v2";
+		opp-shared;
+
+		opp-900000000 {
+			opp-hz = /bits/ 64 <900000000>;
+		};
+
+		opp-1700000000 {
+			opp-hz = /bits/ 64 <1700000000>;
+		};
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		linux,cma {
+			compatible = "shared-dma-pool";
+			reusable;
+			alloc-ranges = <0 0x80000000 0 0x40000000>;
+			size = <0 0x8000000>;
+			linux,cma-default;
+		};
+
+		/*
+		 * Crash log store. The device has no accessible UART, so a
+		 * panic is only readable through pstore on the next boot.
+		 */
+		ramoops@a4000000 {
+			compatible = "ramoops";
+			reg = <0 0xa4000000 0 0x100000>;
+			record-size = <0x20000>;
+			console-size = <0x80000>;
+			pmsg-size = <0x20000>;
+			ecc-size = <16>;
+		};
+
+		/* EdgeLock Enclave firmware communication area. */
+		ele_reserved: ele-reserved@a4120000 {
+			compatible = "shared-dma-pool";
+			reg = <0 0xa4120000 0 0x100000>;
+			no-map;
+		};
+	};
+
+	/*
+	 * A/B slot state, boot error counters and rescue flags shared with
+	 * the vendor U-Boot through the BBNSM general purpose registers.
+	 */
+	lpgpr {
+		compatible = "remarkable,lpgpr";
+		nvmem-cells = <&shutdown_state>,
+			      <&boot_flow>,
+			      <&root_state>,
+			      <&boot_id>,
+			      <&factory_mode>,
+			      <&secboot>,
+			      <&lock_dirty>,
+			      <&arb_index>,
+			      <&swu_status>,
+			      <&swu_recovery>,
+			      <&swu_applied>,
+			      <&wake_splash>,
+			      <&device_type>,
+			      <&srk_hash>,
+			      <&srk_revoke>,
+			      <&usb_vid_pid_ipl>;
+		nvmem-cell-names = "shutdown_state",
+				   "boot_flow",
+				   "root_state",
+				   "boot_id",
+				   "factory_mode",
+				   "secboot",
+				   "lock_dirty",
+				   "arb_index",
+				   "swu_status",
+				   "swu_recovery",
+				   "swu_applied",
+				   "wake_splash",
+				   "device_type",
+				   "srk_hash",
+				   "srk_revoke",
+				   "usb_vid_pid_ipl";
+	};
+
+	reboot-mode {
+		compatible = "nvmem-reboot-mode";
+		nvmem-cells = <&reboot_mode>;
+		nvmem-cell-names = "reboot-mode";
+		mode-normal = <0>;
+		mode-verity = <1>;
+		mode-factory-reset = <2>;
+		mode-bootloader = <4>;
+		mode-recovery = <8>;
+		mode-unlock = <12>;
+		mode-lock = <13>;
+	};
+
+	reg_vref_1v8: regulator-adc-vref {
+		compatible = "regulator-fixed";
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_adcref>;
+		regulator-name = "vref_1v8";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		gpio = <&gpio4 0 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		startup-delay-us = <10000>;
+	};
+
+	reg_epd_pmic: regulator-epd-pmic {
+		compatible = "regulator-fixed";
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_g2194_ps>;
+		regulator-name = "G2194_PS";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		gpio = <&gpio4 19 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	reg_nfc: regulator-nfc {
+		compatible = "regulator-fixed";
+		regulator-name = "NFC_PWR_EN";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&spld_gpio 6 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		startup-delay-us = <1000>;
+		off-on-delay-us = <15000>;
+	};
+
+	reg_touch: regulator-touch {
+		compatible = "regulator-fixed";
+		regulator-name = "VDD_TOUCH_3V3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_touch_pwr>;
+		gpio = <&gpio4 3 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&buck4>;
+		startup-delay-us = <500>;
+	};
+
+	reg_wifi: regulator-wifi {
+		compatible = "regulator-fixed";
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_wifi_reg>;
+		regulator-name = "WIFI_3V3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&gpio4 1 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&buck4>;
+	};
+
+	wifi_pwrseq: wifi-pwrseq {
+		compatible = "mmc-pwrseq-simple";
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_wifi_pwrseq>;
+		reset-gpios = <&gpio4 15 GPIO_ACTIVE_LOW>;
+	};
+
+	/* Allow userspace to control NVCC_SD2 via sysfs */
+	nvcc-sd2-regulator {
+		compatible = "regulator-output";
+		vout-supply = <&ldo5>;
+	};
+
+	gpio_hall_sensors: gpio-hall-sensors {
+		compatible = "gpio-keys";
+		label = "Hall effect sensors";
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_hall_sensors>;
+
+		hall1: hall-sensor-1 {
+			label = "Folio sensor";
+			gpios = <&gpio3 7 GPIO_ACTIVE_HIGH>;
+			linux,input-type = <EV_SW>;
+			linux,code = <SW_LID>;
+			linux,can-disable;
+			wakeup-source;
+		};
+
+		hall2: hall-sensor-2 {
+			label = "Pen holder Sensor (NFC)";
+			gpios = <&gpio3 6 GPIO_ACTIVE_HIGH>;
+			linux,input-type = <EV_SW>;
+			linux,code = <SW_PEN_INSERTED>;
+			linux,can-disable;
+			wakeup-source;
+		};
+	};
+
+	/*
+	 * E Ink Gallery 3 panel behind reMarkable's "cumulus" controller,
+	 * fed RGB565 over the 16-bit parallel display interface. The node
+	 * name is part of the userspace ABI (/sys/devices/platform/cumulus-panel).
+	 */
+	cumulus-panel {
+		compatible = "remarkable,cumulus-panel";
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_cumulus>;
+		oeh-gpios = <&gpio2 20 GPIO_ACTIVE_HIGH>;
+		oev-gpios = <&gpio2 21 GPIO_ACTIVE_HIGH>;
+		vgl-supply = <&vgl_reg>;
+		vneg3-supply = <&vneg3_reg>;
+		vneg2-supply = <&vneg2_reg>;
+		vneg1-supply = <&vneg1_reg>;
+		vpos3-supply = <&vpos3_reg>;
+		vpos2-supply = <&vpos2_reg>;
+		vpos1-supply = <&vpos1_reg>;
+		vgh2-supply = <&vgh2_reg>;
+		vpdd-supply = <&vpdd_reg>;
+		vcom-supply = <&vcom_reg>;
+		vcom-voltage = <500000>;
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&dpi_to_panel>;
+			};
+		};
+
+		display-timings {
+			native-mode = <&timing0>;
+			timing0: timing {
+				clock-frequency = <56000000>;
+				hactive = <365>;
+				vactive = <1700>;
+				hfront-porch = <1>;
+				hback-porch = <1>;
+				hsync-len = <1>;
+				vback-porch = <1>;
+				vfront-porch = <88>;
+				vsync-len = <1>;
+				hsync-active = <0>;
+				vsync-active = <0>;
+				de-active = <0>;
+				pixelclk-active = <0>;
+			};
+		};
+	};
+
+	ntc: temp-sense1 {
+		compatible = "tdk,ntcg103jf103ft1";
+		io-channels = <&adc1 2>;
+		pullup-uv = <1800000>;
+		pullup-ohm = <10000>;
+		pulldown-ohm = <0>;
+		#thermal-sensor-cells = <0>;
+	};
+
+	thermal-zones {
+		batt_thermal_ntc: batt-thermal-ntc {
+			thermal-sensors = <&max77818_fg>;
+
+			trips {
+				batt_glacial: trip0 {
+					temperature = <0>;
+					hysteresis = <0>;
+					type = "passive";
+				};
+
+				batt_cold: trip1 {
+					temperature = <5000>;
+					hysteresis = <0>;
+					type = "passive";
+				};
+
+				batt_cool: trip2 {
+					temperature = <15000>;
+					hysteresis = <0>;
+					type = "passive";
+				};
+
+				batt_warm: trip3 {
+					temperature = <45000>;
+					hysteresis = <0>;
+					type = "passive";
+				};
+
+				batt_hot: trip4 {
+					temperature = <53000>;
+					hysteresis = <0>;
+					type = "passive";
+				};
+
+				/* HW protection shutdown at 55 C */
+				batt_critical: trip5 {
+					temperature = <55000>;
+					hysteresis = <0>;
+					type = "critical";
+				};
+			};
+
+			cooling-maps {
+				map0 {
+					trip = <&batt_glacial>;
+					cooling-device = <&max77818_chg 0 0>;
+				};
+
+				map1 {
+					trip = <&batt_cold>;
+					cooling-device = <&max77818_chg 1 1>;
+				};
+
+				map2 {
+					trip = <&batt_cool>;
+					cooling-device = <&max77818_chg 2 2>;
+				};
+
+				map3 {
+					trip = <&batt_warm>;
+					cooling-device = <&max77818_chg 3 3>;
+				};
+
+				map4 {
+					trip = <&batt_hot>;
+					cooling-device = <&max77818_chg 4 4>;
+				};
+			};
+		};
+	};
+};
+
+&A55_0 {
+	clocks = <&clk IMX93_CLK_A55_CORE>;
+	operating-points-v2 = <&a55_opp_table>;
+};
+
+&A55_1 {
+	clocks = <&clk IMX93_CLK_A55_CORE>;
+	operating-points-v2 = <&a55_opp_table>;
+};
+
+&adc1 {
+	vref-supply = <&reg_vref_1v8>;
+	#io-channel-cells = <1>;
+	status = "okay";
+};
+
+&bbnsm {
+	bbnsm_gpr: gpr {
+		compatible = "fsl,imx93-bbnsm-gpr";
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		reboot_mode: reboot-mode@0 {
+			/* GPR0[3:0] */
+			reg = <0x0 0x4>;
+			bits = <0 4>;
+		};
+
+		root_state: root-state@0 {
+			/* GPR0[9:4] */
+			reg = <0x0 0x4>;
+			bits = <4 6>;
+		};
+
+		boot_flow: boot-flow@0 {
+			/* GPR0[10] */
+			reg = <0x0 0x4>;
+			bits = <10 1>;
+		};
+
+		factory_mode: fac-mode@0 {
+			/* GPR0[13:12] */
+			reg = <0x0 0x4>;
+			bits = <12 2>;
+		};
+
+		secboot: secboot@0 {
+			/* GPR0[14] */
+			reg = <0x0 0x4>;
+			bits = <14 1>;
+		};
+
+		shutdown_state: shutdown-state@0 {
+			/* GPR0[17:16] */
+			reg = <0x0 0x4>;
+			bits = <16 2>;
+		};
+
+		swu_status: swu-status@0 {
+			/* GPR0[20:18] */
+			reg = <0x0 0x4>;
+			bits = <18 3>;
+		};
+
+		swu_recovery: swu-recovery@0 {
+			/* GPR0[21] */
+			reg = <0x0 0x4>;
+			bits = <21 1>;
+		};
+
+		swu_applied: swu-applied@0 {
+			/* GPR0[22] */
+			reg = <0x0 0x4>;
+			bits = <22 1>;
+		};
+
+		wake_splash: wake-splash@0 {
+			/* GPR0[24] */
+			reg = <0x0 0x4>;
+			bits = <24 1>;
+		};
+
+		boot_id: boot-id@8 {
+			/* GPR2[31:0] + GPR3[31:0] */
+			reg = <0x8 0x8>;
+		};
+	};
+};
+
+&bbnsm_pwrkey {
+	linux,keycode = <KEY_POWER>;
+	wakeup-source;
+};
+
+&dpi_bridge {
+	pinctrl-names = "default", "gpio";
+	pinctrl-0 = <&pinctrl_parallel_disp>;
+	pinctrl-1 = <&pinctrl_parallel_disp_gpio>;
+	status = "okay";
+};
+
+&dpi_to_panel {
+	remote-endpoint = <&panel_in>;
+};
+
+&gpio2 {
+	/* avoid power leakage */
+	disp-clk-hog {
+		gpio-hog;
+		gpios = <0 GPIO_ACTIVE_HIGH>;
+		output-low;
+	};
+};
+
+&gpio4 {
+	gpio-line-names =
+		"ADC_EN",
+		"WIFI_PWR_EN",
+		"LIGHT_SENSE_C",
+		"TOUCH_PWR_EN",
+		"BT_UART_RTS",
+		"BT_UART_TXD",
+		"IND_RST_BT",
+		"IND_RST_WL",
+		"BT_HOST_WAKE",
+		"BT_DEV_WAKE",
+		"BT_UART_RXD",
+		"BT_UART_CTS",
+		"WIFI_DEV_WAKE",
+		"WIFI_HOST_WAKE",
+		"LED_EN",
+		"WIFI_PWDN_N",
+		"I2S_DOUT",
+		"G2194_EN",
+		"G2194_PG",
+		"G2194_PS",
+		"I2S_LRCLK",
+		"I2S_BCLK",
+		"I2S_DIN",
+		"G2194_VCOM_TOGGLE_SEL1",
+		"TOUCH_RESET_1V8",
+		"G2194_VCOM_EN",
+		"I2S_CCLK",
+		"G2194_VCOM_TOGGLE_SEL0";
+};
+
+&lcdif {
+	/* 56 MHz panel clock = video PLL at 168 MHz / 3 */
+	assigned-clocks = <&clk IMX93_CLK_VIDEO_PLL>,
+			  <&clk IMX93_CLK_MEDIA_DISP_PIX>;
+	assigned-clock-rates = <168000000>, <56000000>;
+	status = "okay";
+};
+
+&lpi2c1 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	clock-frequency = <400000>;
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&pinctrl_lpi2c1>;
+	pinctrl-1 = <&pinctrl_lpi2c1>;
+	status = "okay";
+
+	max77818: pmic@66 {
+		compatible = "maxim,max77818";
+		reg = <0x66>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_max77818>;
+		interrupt-parent = <&gpio3>;
+		interrupts = <2 IRQ_TYPE_LEVEL_HIGH>;
+
+		max77818_chg: charger {
+			compatible = "maxim,max77818-charger";
+			fast_charge_current = <2300>; /* mA */
+			fast_charge_timer = <16>; /* 16h */
+			charge_termination_voltage = <4400>; /* mV */
+			vsys_min = <3400>; /* mV */
+			default_current_limit = <900>; /* mA */
+			input_current_limit_chgin = <3000>; /* mA */
+			topoff_current = <100>; /* mA */
+			#cooling-cells = <2>;
+			thermal-charge-table = <0 100 3650>,  /* glacial (below 5 C): not charge */
+					       <1 700 4400>,  /* cold (5 ~ 15 C): 700mA 4.4V */
+					       <2 2300 4400>, /* cool (15 ~ 45 C): 2300mA 4.4V */
+					       <3 800 4100>,  /* warm (45 ~ 53 C): 800mA 4.1V */
+					       <4 100 3650>;  /* hot (53 ~ 55 C): not charge */
+		};
+
+		max77818_fg: fuelgauge {
+			compatible = "maxim,max77818-fuelgauge";
+			#thermal-sensor-cells = <0>;
+			usb_safe_max_current = <500>; /* mA */
+			maxim,over-heat-temp = <600>; /* tenths of degree Celsius */
+			maxim,cold-temp = <(-200)>;
+			maxim,over-volt = <4400>; /* mV */
+			maxim,dead-volt = <3000>;
+			maxim,valrtth = /bits/ 16 <0xFF00>; /* 0xFF00 == Disable */
+			maxim,min-soc-alert = /bits/ 8 <10>; /* in percent, 0 means disable */
+			maxim,max-soc-alert = /bits/ 8 <255>; /* in percent, 255 means disable */
+			maxim,critical-soc = /bits/ 8 <6>; /* force shutdown if SOC goes below it */
+			maxim,at-rate = /bits/ 16 <0x1900>;
+			maxim,design-cap = /bits/ 16 <0x11f1>;
+			maxim,config = /bits/ 16 <0x0214>; /* FGCC disabled */
+			maxim,config2 = /bits/ 16 <0x0010>;
+			maxim,convgcfg = /bits/ 16 <0x2241>;
+			maxim,dpacc = /bits/ 16 <0x3200>;
+			maxim,dqacc = /bits/ 16 <0x047c>;
+			maxim,filter-cfg = /bits/ 16 <0xcea4>;
+			maxim,fullcapnom = /bits/ 16 <0x11f0>;
+			maxim,fullcaprep = /bits/ 16 <0x11f0>;
+			maxim,full-soc-threshold = /bits/ 16 <0x5f00>;
+			maxim,iavg-empty = /bits/ 16 <0x0e5a>;
+			maxim,ichg-term = /bits/ 16 <0x0780>;
+			maxim,learn-cfg = /bits/ 16 <0x2602>;
+			maxim,misc-cfg = /bits/ 16 <0x3870>;
+			maxim,qresidual00 = /bits/ 16 <0x2200>;
+			maxim,qresidual10 = /bits/ 16 <0x1080>;
+			maxim,qresidual20 = /bits/ 16 <0x0780>;
+			maxim,qresidual30 = /bits/ 16 <0x0580>;
+			maxim,rcomp0 = /bits/ 16 <0x0026>;
