+	usb_vid_pid_ipl: usb-vid-pid-ipl@4e0 {
+		/* Fused USB VID/PID, bank 39 word 0 => word 312 */
+		reg = <0x4e0 4>;
+	};
+
+	device_type: device-type@5e4 {
+		/* GP2 bit 34 => GP2.1 bit 2 => word 377 */
+		reg = <0x5e4 4>;
+		bits = <2 1>;
+	};
+
+	lock_dirty: lock-dirty@5e4 {
+		/* GP2 bit 35 => GP2.1 bit 3 => word 377 */
+		reg = <0x5e4 4>;
+		bits = <3 1>;
+	};
+
+	arb_index: arb-index@5e8 {
+		/* GP2, bank 47 word 2 => word 378, 384 bits */
+		reg = <0x5e8 48>;
+	};
+};
