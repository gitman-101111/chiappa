+static int shutdown_state_init(struct platform_device *pdev)
+{
+	struct lpgpr_priv *priv = platform_get_drvdata(pdev);
+	size_t len;
+	u8 *sds_buf;
+	u8 sds;
+	int ret;
+
+	priv->sds_cell = devm_nvmem_cell_get(&pdev->dev, "shutdown_state");
+	if (IS_ERR(priv->sds_cell)) {
+		dev_err(&pdev->dev, "failed to get cell shutdown_state\n");
+		return PTR_ERR(priv->sds_cell);
+	}
+
+	/* Cache shutdown state */
+	sds_buf = nvmem_cell_read(priv->sds_cell, &len);
+	if (IS_ERR(sds_buf)) {
+		dev_err(&pdev->dev, "failed to read sds_cell\n");
+		return PTR_ERR(sds_buf);
+	}
+
+	priv->sds_cache = *sds_buf;
+	kfree(sds_buf);
+
+	/*
+	 * Clear hardware state considering the possible unexpected shutdown
+	 * like forcing shutdown from crashes etc.
+	 */
+	sds = SDS_UNKNOWN;
+	ret = nvmem_cell_write(priv->sds_cell, &sds, sizeof(sds));
+	if (ret < 0) {
+		dev_err(&pdev->dev, "failed to write sds_cell\n");
+		return ret;
+	}
+
+	return 0;
+}
+
+static int boot_flow_init(struct platform_device *pdev)
+{
+	struct lpgpr_priv *priv = platform_get_drvdata(pdev);
+	size_t len;
+	int ret;
+	u8 *pbf;
+
+	priv->bf_cell = devm_nvmem_cell_get(&pdev->dev, "boot_flow");
+	if (IS_ERR(priv->bf_cell)) {
+		dev_err(&pdev->dev, "failed to get cell boot_flow\n");
+		return PTR_ERR(priv->bf_cell);
+	}
+
+	pbf = nvmem_cell_read(priv->bf_cell, &len);
+	if (IS_ERR(pbf)) {
+		dev_err(&pdev->dev, "failed to read bf_cell\n");
+		return PTR_ERR(pbf);
+	}
+
+	/* Always do regular boot, unless xochitl explicitly requests falcon */
+	*pbf = BF_REGULAR;
+	ret = nvmem_cell_write(priv->bf_cell, pbf, len);
+	if (ret < 0) {
+		dev_err(&pdev->dev, "failed to write bf_cell\n");
+		return ret;
+	}
+
+	kfree(pbf);
+
+	return 0;
+}
