+static ssize_t bootrom_usb_vidpid_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct nvmem_cell *cell;
+	uint32_t *val;
+	int ret;
+
+	cell = nvmem_cell_get(dev, "usb_vid_pid_ipl");
+	if (IS_ERR(cell))
+		return PTR_ERR(cell);
+
+	val = nvmem_cell_read(cell, NULL);
+	if (IS_ERR(val)) {
+		nvmem_cell_put(cell);
+		return PTR_ERR(val);
+	}
+
+	ret = sprintf(buf, "0x%08x\n", *val);
+
+	kfree(val);
+	nvmem_cell_put(cell);
+
+	return ret;
+}
