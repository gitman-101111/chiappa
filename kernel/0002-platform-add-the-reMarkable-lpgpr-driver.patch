+
+	ret = sprintf(buf, "%u\n", *value);
+
+	kfree(value);
+
+	return ret;
+}
+
+static ssize_t swu_recovery_store(struct device *dev, struct device_attribute *attr,
+				  const char *buf, size_t count)
+{
+	struct lpgpr_priv *priv = dev_get_drvdata(dev);
