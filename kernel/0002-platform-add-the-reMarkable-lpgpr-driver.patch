+static int lpgpr_pm_notifier(struct notifier_block *notifier,
+			     unsigned long pm_event, void *unused)
+{
+	struct lpgpr_priv *priv = container_of(notifier, struct lpgpr_priv, pm_notifier);
+
+	switch (pm_event) {
+	case PM_HIBERNATION_PREPARE:
+		priv->hibernate = true;
+		break;
+	case PM_POST_HIBERNATION:
+		priv->hibernate = false;
+		break;
+	default:
+		break;
+	}
+
+	return NOTIFY_DONE;
+}
+
+static int lpgpr_poweroff_handler(struct sys_off_data *data)
+{
+	struct lpgpr_priv *priv = data->cb_data;
+	u8 sds = priv->hibernate ? SDS_HIBERNATE : SDS_POWEROFF;
+	int ret;
+
+	ret = nvmem_cell_write(priv->sds_cell, &sds, sizeof(sds));
+	if (ret < 0)
+		dev_err(priv->dev, "failed to set up %s state: %d\n",
+			priv->hibernate ? "hibernate" : "poweroff", ret);
+
+	return NOTIFY_DONE;
+}
+
+static int lpgpr_reboot_handler(struct sys_off_data *data)
+{
+	struct lpgpr_priv *priv = data->cb_data;
+	u8 sds = SDS_REBOOT;
+	int ret;
+
+	ret = nvmem_cell_write(priv->sds_cell, &sds, sizeof(sds));
+	if (ret < 0)
+		dev_err(priv->dev, "failed to set up reboot state: %d\n", ret);
+
+	return NOTIFY_DONE;
+}
+
+static void log_lpgpr_info(struct lpgpr_priv *priv)
+{
+	size_t len;
+	u8 *buf;
+	s8 roota_errcnt = S8_MIN;
+	s8 rootb_errcnt = S8_MIN;
+	const char *root_part = root_parts[PART_UNKNOWN];
+
+	buf = nvmem_cell_read(priv->root_cell, &len);
+	if (!IS_ERR(buf)) {
+		roota_errcnt = ((*buf & ROOTA_ERR_MASK) >> ROOTA_ERR_SHIFT);
+		rootb_errcnt = ((*buf & ROOTB_ERR_MASK) >> ROOTB_ERR_SHIFT);
+		root_part = root_parts[*buf & ROOT_PART_MASK];
+		kfree(buf);
+	}
+
+	dev_info(priv->dev, "root partition %s (a|b), part-a-errcnt %d, part-b-errcnt %d (0..3)\n",
+		 root_part, roota_errcnt, rootb_errcnt);
+}
+
+static int lpgpr_probe(struct platform_device *pdev)
+{
+	struct lpgpr_priv *priv;
+	int ret;
+
+	priv = devm_kzalloc(&pdev->dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->dev = &pdev->dev;
+	platform_set_drvdata(pdev, priv);
+
+	ret = shutdown_state_init(pdev);
+	if (ret)
+		return ret;
+
+	ret = boot_flow_init(pdev);
+	if (ret)
+		return ret;
+
+	ret = root_state_init(pdev);
+	if (ret)
+		return ret;
+
+	ret = factory_mode_init(pdev);
+	if (ret)
+		return ret;
+
+	ret = secureboot_init(pdev);
+	if (ret)
+		return ret;
+
+	ret = swu_init(pdev);
+	if (ret)
+		return ret;
+
+	ret = wake_splash_init(pdev);
+	if (ret)
+		return ret;
+
+	ret = devm_register_sys_off_handler(priv->dev,
+					    SYS_OFF_MODE_RESTART_PREPARE,
+					    SYS_OFF_PRIO_DEFAULT,
+					    lpgpr_reboot_handler, priv);
+	if (ret)
+		return ret;
+
+	ret = devm_register_sys_off_handler(priv->dev,
+					    SYS_OFF_MODE_POWER_OFF_PREPARE,
+					    SYS_OFF_PRIO_DEFAULT,
+					    lpgpr_poweroff_handler, priv);
+	if (ret)
+		return ret;
+
+	priv->pm_notifier.notifier_call = lpgpr_pm_notifier;
+	ret = register_pm_notifier(&priv->pm_notifier);
+	if (ret)
+		return ret;
+
+	ret = sysfs_create_group(&pdev->dev.kobj, &lpgpr_attr_group);
+	if (ret)
+		goto pm_notifier_unreg;
+
+	/* 'Commit' lpgpr content */
+	wmb();
+	lpgpr_main = priv;
+
+	log_lpgpr_info(priv);
+
+	return 0;
+
+pm_notifier_unreg:
+	unregister_pm_notifier(&priv->pm_notifier);
+	return ret;
+}
+
+static void lpgpr_remove(struct platform_device *pdev)
+{
+	struct lpgpr_priv *priv = platform_get_drvdata(pdev);
+
+	lpgpr_main = NULL; /* no locking... */
+
+	sysfs_remove_group(&pdev->dev.kobj, &lpgpr_attr_group);
+
+	unregister_pm_notifier(&priv->pm_notifier);
+
+}
