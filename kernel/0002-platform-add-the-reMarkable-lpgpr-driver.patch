+
+	return ret;
+}
+
+static ssize_t wake_splash_store(struct device *dev, struct device_attribute *attr,
+				 const char *buf, size_t count)
+{
+	struct lpgpr_priv *priv = dev_get_drvdata(dev);
+	u8 value;
+	int ret;
+
+	if (kstrtou8(buf, 0, &value))
+		return -EINVAL;
+
+	if (value != 0 && value != 1)
+		return -EINVAL;
+
+	ret = nvmem_cell_write(priv->wake_splash_cell, &value, sizeof(value));
+	if (ret < 0)
+		return ret;
+
+	return count;
+}
