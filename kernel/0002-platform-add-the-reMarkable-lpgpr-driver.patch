diff --git a/drivers/platform/remarkable/lpgpr.c b/drivers/platform/remarkable/lpgpr.c
new file mode 100644
index 000000000..b8abd349f
--- /dev/null
+++ b/drivers/platform/remarkable/lpgpr.c
@@ -0,0 +1,1019 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * (C) Copyright 2022
+ * reMarkable AS - http://www.remarkable.com
+ */
+
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/module.h>
+#include <linux/nvmem-consumer.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/reboot.h>
+#include <linux/slab.h>
+#include <linux/suspend.h>
+
+struct lpgpr_priv {
+	struct device *dev;
+	struct nvmem_cell *sds_cell;
+	u8 sds_cache;
+	struct nvmem_cell *bf_cell;
+	struct nvmem_cell *root_cell;
+	struct nvmem_cell *facmode_cell;
+	struct nvmem_cell *secboot_cell;
+	struct nvmem_cell *swu_status_cell;
+	struct nvmem_cell *swu_recovery_cell;
+	struct nvmem_cell *swu_applied_cell;
+	struct nvmem_cell *wake_splash_cell;
+	struct notifier_block pm_notifier;
+	bool hibernate;
+};
+
+/* There is normally only one instance of LPGPR (platform register) */
+static struct lpgpr_priv *lpgpr_main;
+
+enum shutdown_state {
+	SDS_UNKNOWN,
+	SDS_POWEROFF,
+	SDS_REBOOT,
+	SDS_HIBERNATE,
+	SDS_NUM,
+};
+
+static const char *const shutdown_states[SDS_NUM] = {
+	[SDS_UNKNOWN] = "unknown",
+	[SDS_POWEROFF] = "poweroff",
+	[SDS_REBOOT] = "reboot",
+	[SDS_HIBERNATE] = "hibernate",
+};
+
+static ssize_t shutdown_state_show(struct device *dev,
+				   struct device_attribute *attr, char *buf)
+{
+	struct lpgpr_priv *priv = dev_get_drvdata(dev);
+	u8 sds = SDS_UNKNOWN;
+
+	for (sds = SDS_UNKNOWN; sds < SDS_NUM; sds++) {
+		if (sds == priv->sds_cache)
+			break;
+	}
+
+	return sprintf(buf, "%s\n", shutdown_states[sds]);
+}
+
+static DEVICE_ATTR_RO(shutdown_state);
+
+enum boot_flow {
+	BF_REGULAR,
+	BF_FALCON,
+	BF_NUM,
+};
+
+static const char *const boot_flows[BF_NUM] = {
+	[BF_REGULAR] = "regular",
+	[BF_FALCON] = "falcon",
+};
+
+static ssize_t boot_flow_show(struct device *dev,
+			      struct device_attribute *attr, char *buf)
+{
+	struct lpgpr_priv *priv = dev_get_drvdata(dev);
+	u8 *pbf, bf;
+
+	pbf = nvmem_cell_read(priv->bf_cell, NULL);
+	if (IS_ERR(pbf))
+		return PTR_ERR(pbf);
+
+	bf = *pbf;
+	kfree(pbf);
+
+	return (bf < BF_NUM) ? sprintf(buf, "%s\n", boot_flows[bf]) : -EINVAL;
+}
+
+static ssize_t boot_flow_store(struct device *dev,
+			       struct device_attribute *attr,
+			       const char *buf, size_t count)
+{
+	struct lpgpr_priv *priv = dev_get_drvdata(dev);
+	int ret = -EINVAL;
+	u8 *pbf, bf;
+	size_t len;
+
+	pbf = nvmem_cell_read(priv->bf_cell, &len);
+	if (IS_ERR(pbf))
+		return PTR_ERR(pbf);
+
+	for (bf = BF_REGULAR; bf < BF_NUM; bf++) {
+		if (sysfs_streq(boot_flows[bf], buf)) {
+			*pbf = bf;
+			ret = nvmem_cell_write(priv->bf_cell, pbf, len);
+			if (ret >= 0)
+				ret = count;
+			break;
+		}
+	}
+
+	kfree(pbf);
+
+	return ret;
+}
+
+static DEVICE_ATTR_RW(boot_flow);
+
+enum root_part {
+	PART_UNKNOWN,
+	PART_A,
+	PART_B,
+	PART_RESERVED,
+};
+
+static const char *const root_parts[SDS_NUM] = {
+	[PART_UNKNOWN] = "unknown",
+	[PART_A] = "a",
+	[PART_B] = "b",
+	[PART_RESERVED] = "reserved",
+};
+
+#define ROOT_PART_MASK	0x03
+#define ROOTA_ERR_MASK	0x0C
+#define ROOTA_ERR_SHIFT	2
+#define ROOTB_ERR_MASK	0x30
+#define ROOTB_ERR_SHIFT	4
+
+static ssize_t root_part_show(struct device *dev,
+			      struct device_attribute *attr, char *buf)
+{
+	struct lpgpr_priv *priv = dev_get_drvdata(dev);
+	u8 *root_state;
+	size_t len;
+	int ret;
+
+	root_state = nvmem_cell_read(priv->root_cell, &len);
+	if (IS_ERR(root_state))
+		return PTR_ERR(root_state);
+
+	ret = sprintf(buf, "%s\n", root_parts[*root_state & ROOT_PART_MASK]);
+
+	kfree(root_state);
+
+	return ret;
+}
+
+static DEVICE_ATTR_RO(root_part);
+
+static struct device_attribute dev_attr_roota_errcnt;
+static struct device_attribute dev_attr_rootb_errcnt;
+
+static ssize_t rootx_errcnt_show(struct device *dev, struct device_attribute *attr,
+				 char *buf)
+{
+	struct lpgpr_priv *priv = dev_get_drvdata(dev);
+	u32 errmask, errshift;
+	u8 *root_state;
+	size_t len;
+	int ret;
+
+	if (attr == &dev_attr_roota_errcnt) {
+		errmask = ROOTA_ERR_MASK;
+		errshift = ROOTA_ERR_SHIFT;
+	} else {
+		errmask = ROOTB_ERR_MASK;
+		errshift = ROOTB_ERR_SHIFT;
+	}
+
+	root_state = nvmem_cell_read(priv->root_cell, &len);
+	if (IS_ERR(root_state))
+		return PTR_ERR(root_state);
+
+	ret = sprintf(buf, "%u\n", (*root_state & errmask) >> errshift);
+
+	kfree(root_state);
+
+	return ret;
+}
+
+static ssize_t rootx_errcnt_store(struct device *dev, struct device_attribute *attr,
+				  const char *buf, size_t count)
+{
+	struct lpgpr_priv *priv = dev_get_drvdata(dev);
+	u32 errmask, shift;
+	u8 *root_state;
+	size_t len;
+	u8 new_err_cnt;
+	int ret;
+
+	if (attr == &dev_attr_roota_errcnt) {
+		errmask = ROOTA_ERR_MASK;
+		shift = ROOTA_ERR_SHIFT;
+	} else {
+		errmask = ROOTB_ERR_MASK;
+		shift = ROOTB_ERR_SHIFT;
+	}
+
+	if (!count)
+		return -EINVAL;
+	if (buf[0] < '0' || buf[0] > '9')
+		return -EINVAL;
+
+	/* convert and shift */
+	new_err_cnt = buf[0] - '0';
+
+	/* does it fit the available bits? */
+	if (new_err_cnt != (new_err_cnt & (errmask >> shift)))
+		return -EINVAL;
+
+	root_state = nvmem_cell_read(priv->root_cell, &len);
+	if (IS_ERR(root_state))
+		return PTR_ERR(root_state);
+
+	/* clear root_state */
+	*root_state &= ~errmask;
+	/* assign err cnt */
+	*root_state |= (new_err_cnt << shift) & errmask;
+
+	ret = nvmem_cell_write(priv->root_cell, root_state, sizeof(*root_state));
+
+	kfree(root_state);
+
+	return ret < 0 ? ret : count;
+}
+
+static DEVICE_ATTR(rootb_errcnt, S_IWUSR | S_IRUGO,
+		   rootx_errcnt_show, rootx_errcnt_store);
+static DEVICE_ATTR(roota_errcnt, S_IWUSR | S_IRUGO,
+		   rootx_errcnt_show, rootx_errcnt_store);
+
+#define FACMODE_ENABLED	BIT(0)
+#define FACMODE_DONE	BIT(1)
+
+static ssize_t facmode_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct lpgpr_priv *priv = dev_get_drvdata(dev);
+	u8 *facmode;
+	size_t len;
+	int ret;
+
+	facmode = nvmem_cell_read(priv->facmode_cell, &len);
+	if (IS_ERR(facmode))
+		return PTR_ERR(facmode);
+
+	ret = sprintf(buf, "%s\n", (*facmode & FACMODE_ENABLED) ? "on" : "off");
+
+	kfree(facmode);
+
+	return ret;
+}
+
+static ssize_t facmode_store(struct device *dev, struct device_attribute *attr,
+			     const char *buf, size_t count)
+{
+	struct lpgpr_priv *priv = dev_get_drvdata(dev);
+	u8 value;
+	int ret;
+
+	/* We can only disable factory mode */
+	if (sysfs_streq(buf, "off"))
+		value = 0;
+	else
+		return -EINVAL;
+
+	/* save facmode state persistently */
+	value |= FACMODE_DONE;
+
+	ret = nvmem_cell_write(priv->facmode_cell, &value, sizeof(value));
+	if (ret < 0)
+		return ret;
+
+	return count;
+}
+
+static DEVICE_ATTR_RW(facmode);
+
+#define SECBOOT_UNLOCKED	BIT(0)
+
+static ssize_t secboot_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct lpgpr_priv *priv = dev_get_drvdata(dev);
+	u8 *secboot;
+	size_t len;
+	int ret;
+
+	secboot = nvmem_cell_read(priv->secboot_cell, &len);
+	if (IS_ERR(secboot))
+		return PTR_ERR(secboot);
+
+	ret = sprintf(buf, "%s\n", (*secboot & SECBOOT_UNLOCKED) ? "unlocked" : "locked");
+
+	kfree(secboot);
+
+	return ret;
+}
+
+static DEVICE_ATTR_RO(secboot);
+
+static ssize_t lock_dirty_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct nvmem_cell *cell;
+	bool is_dirty;
+	uint32_t *val;
+	size_t len;
+
+	cell = nvmem_cell_get(dev, "lock_dirty");
+	if (IS_ERR(cell))
+		return PTR_ERR(cell);
+
+	val = nvmem_cell_read(cell, &len);
+	if (IS_ERR(val)) {
+		nvmem_cell_put(cell);
+		return PTR_ERR(val);
+	}
+
+	is_dirty = *val == 1;
+
+	kfree(val);
+	nvmem_cell_put(cell);
+
+	return sprintf(buf, "%s\n", is_dirty ? "dirty" : "clean");
+}
+
+static DEVICE_ATTR_RO(lock_dirty);
+
+static ssize_t arb_index_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	unsigned int arb_index = 0;
+	struct nvmem_cell *cell;
+	uint32_t *arb;
+	size_t len;
+	int i;
+
+	cell = nvmem_cell_get(dev, "arb_index");
+	if (IS_ERR(cell))
+		return PTR_ERR(cell);
+
+	arb = nvmem_cell_read(cell, &len);
+	if (IS_ERR(arb)) {
+		nvmem_cell_put(cell);
+		return PTR_ERR(arb);
+	}
+
+	/* ARB index is the position of first zero bit */
+	for (i = 0; i < len / sizeof(uint32_t); i++) {
+		uint32_t word = arb[i];
+
+		if (word == 0xFFFFFFFF) {
+			arb_index += 32;
+			continue;
+		}
+
+		while ((word & 1) != 0) {
+			word >>= 1;
+			arb_index++;
+		}
+
+		break;
+	}
+
+	kfree(arb);
+	nvmem_cell_put(cell);
+
+	return sprintf(buf, "%d\n", arb_index);
+}
+
+static DEVICE_ATTR_RO(arb_index);
+
+static ssize_t srk_hash_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct nvmem_cell *cell;
+	uint8_t *hash;
+	size_t len;
+
+	cell = nvmem_cell_get(dev, "srk_hash");
+	if (IS_ERR(cell))
+		return PTR_ERR(cell);
+
+	hash = nvmem_cell_read(cell, &len);
+	if (IS_ERR(hash)) {
+		nvmem_cell_put(cell);
+		return PTR_ERR(hash);
+	}
+
+	memcpy(buf, hash, len);
+
+	kfree(hash);
+	nvmem_cell_put(cell);
+
+	return len;
+}
+
+static DEVICE_ATTR_RO(srk_hash);
+
+static ssize_t device_type_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct nvmem_cell *cell;
+	bool is_public;
+	uint32_t *val;
+	size_t len;
+
+	cell = nvmem_cell_get(dev, "device_type");
+	if (IS_ERR(cell))
+		return PTR_ERR(cell);
+
+	val = nvmem_cell_read(cell, &len);
+	if (IS_ERR(val)) {
+		nvmem_cell_put(cell);
+		return PTR_ERR(val);
+	}
+
+	is_public = *val == 1;
+
+	kfree(val);
+	nvmem_cell_put(cell);
+
+	return sprintf(buf, "%s\n", is_public ? "public" : "engineering");
+}
+
+static DEVICE_ATTR_RO(device_type);
+
+static ssize_t srk_show(struct device *dev, char *buf, unsigned int index)
+{
+	struct nvmem_cell *cell;
+	bool is_revoked;
+	uint32_t *val;
+	size_t len;
+
+	if (index < 1 || index > 4)
+		return -EINVAL;
+
+	cell = nvmem_cell_get(dev, "srk_revoke");
+	if (IS_ERR(cell))
+		return PTR_ERR(cell);
+
+	val = nvmem_cell_read(cell, &len);
+	if (IS_ERR(val)) {
+		nvmem_cell_put(cell);
+		return PTR_ERR(val);
+	}
+
+	is_revoked = !!(*val & BIT(index - 1));
+
+	kfree(val);
+	nvmem_cell_put(cell);
+
+	return sprintf(buf, "%s\n", is_revoked ? "revoked" : "active");
+}
+
+static ssize_t srk1_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	return srk_show(dev, buf, 1);
+}
+
+static ssize_t srk2_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	return srk_show(dev, buf, 2);
+}
+
+static ssize_t srk3_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	return srk_show(dev, buf, 3);
+}
+
+static ssize_t srk4_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	return srk_show(dev, buf, 4);
+}
+
+static DEVICE_ATTR_RO(srk1);
+static DEVICE_ATTR_RO(srk2);
+static DEVICE_ATTR_RO(srk3);
+static DEVICE_ATTR_RO(srk4);
+
+static ssize_t swu_status_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct lpgpr_priv *priv = dev_get_drvdata(dev);
+	u8 *value;
+	int ret;
+
+	value = nvmem_cell_read(priv->swu_status_cell, NULL);
+	if (IS_ERR(value))
+		return PTR_ERR(value);
+
+	ret = sprintf(buf, "%u\n", *value);
+
+	kfree(value);
+
+	return ret;
+}
+
+static ssize_t swu_status_store(struct device *dev, struct device_attribute *attr,
+				const char *buf, size_t count)
+{
+	struct lpgpr_priv *priv = dev_get_drvdata(dev);
+	u8 value;
+	int ret;
+
+	if (kstrtou8(buf, 0, &value))
+		return -EINVAL;
+
+	if (value > 7)
+		return -EINVAL;
+
+	ret = nvmem_cell_write(priv->swu_status_cell, &value, sizeof(value));
+	if (ret < 0)
+		return ret;
+
+	return count;
+}
+
+static DEVICE_ATTR_RW(swu_status);
+
+static ssize_t swu_recovery_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct lpgpr_priv *priv = dev_get_drvdata(dev);
