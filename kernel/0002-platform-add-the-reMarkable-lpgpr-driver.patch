 drivers/platform/Makefile            |    1 +
 drivers/platform/remarkable/Kconfig  |   24 +
 drivers/platform/remarkable/Makefile |    5 +
 drivers/platform/remarkable/lpgpr.c  | 1019 ++++++++++++++++++++++++++
 5 files changed, 1051 insertions(+)
 create mode 100644 drivers/platform/remarkable/Kconfig
