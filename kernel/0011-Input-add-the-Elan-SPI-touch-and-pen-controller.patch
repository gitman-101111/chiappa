+/* SPDX-License-Identifier: GPL-2.0 */
+#undef TRACE_SYSTEM
+#define TRACE_SYSTEM elants_spi
+
+#if !defined(_TRACE_ELANTS_SPI_H) || defined(TRACE_HEADER_MULTI_READ)
+#define _TRACE_ELANTS_SPI_H
+
+#include <linux/tracepoint.h>
+
+TRACE_EVENT(marker_event,
+	    TP_PROTO(struct marker_packet *packet),
+	    TP_ARGS(packet),
+	    TP_STRUCT__entry(
+			     __field(u8, state)
+			    ),
+	    TP_fast_assign(
+			   __entry->state = packet->eraser << 1 | packet->tip;
+			  ),
+	    TP_printk("elants_spi marker event [tip:%d,eraser:%d]",
+		      (__entry->state & 0x1) != 0,
+		      (__entry->state & 0x2) != 0)
+);
+
+TRACE_EVENT(touch_event,
+	    TP_PROTO(int finger_count, int palm_count),
+	    TP_ARGS(finger_count, palm_count),
+	    TP_STRUCT__entry(
+			     __field(u8, finger_count)
+			     __field(u8, palm_count)
+			    ),
+	    TP_fast_assign(
+			   __entry->finger_count = finger_count;
+			   __entry->palm_count = palm_count;
+			  ),
+	    TP_printk("elants_spi touch event [finger_count:%d,palm_count:%d]",
+		      __entry->finger_count,
+		      __entry->palm_count)
+);
+
+#endif /* if !defined(_TRACE_ELANTS_SPI_H) || defined(TRACE_HEADER_MULTI_READ) */
+
+/* This part must be outside protection */
+#include <trace/define_trace.h>
