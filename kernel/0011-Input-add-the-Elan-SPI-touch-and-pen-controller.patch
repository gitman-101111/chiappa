From d198394c3c400b20ff33a8809904bbb1e4871f34 Mon Sep 17 00:00:00 2001
From: gitman-101111 <development@spamfolder.xyz>
Date: Mon, 12 Oct 2026 10:23:08 -0600
Subject: [PATCH] Input: add the Elan SPI touch and pen controller

SPI variant of the Elan touch controller as used by reMarkable, serving
both finger touch and the electromagnetic pen (with its own resolution,
pressure and tilt reporting, and a battery power supply for the marker).
Ported from reMarkable's linux-imx-rm 6.12 tree; the i.MX bus-frequency
boost calls are dropped.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 drivers/input/touchscreen/Kconfig      |   12 +
 drivers/input/touchscreen/Makefile     |    1 +
 drivers/input/touchscreen/elants_spi.c | 1816 ++++++++++++++++++++++++
 include/trace/events/elants_spi.h      |   43 +
 4 files changed, 1872 insertions(+)
 create mode 100644 drivers/input/touchscreen/elants_spi.c
 create mode 100644 include/trace/events/elants_spi.h

diff --git a/drivers/input/touchscreen/Kconfig b/drivers/input/touchscreen/Kconfig
index 9b9ae8ac3..6da474b43 100644
--- a/drivers/input/touchscreen/Kconfig
+++ b/drivers/input/touchscreen/Kconfig
@@ -370,6 +370,18 @@ config TOUCHSCREEN_EXC3000
 	  To compile this driver as a module, choose M here: the
 	  module will be called exc3000.
 
+config TOUCHSCREEN_ELAN_SPI
+	tristate "ELAN touchscreen SPI input driver"
+	depends on SPI
+	help
+	  Say Y here if you have an SPI ELAN touchscreen
+	  attached.
+
+	  If unsure, say N.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called elants_spi.
+
 config TOUCHSCREEN_FUJITSU
 	tristate "Fujitsu serial touchscreen"
 	select SERIO
diff --git a/drivers/input/touchscreen/Makefile b/drivers/input/touchscreen/Makefile
index bfd9de833..79a880b03 100644
--- a/drivers/input/touchscreen/Makefile
+++ b/drivers/input/touchscreen/Makefile
@@ -39,6 +39,7 @@ obj-$(CONFIG_TOUCHSCREEN_GUNZE)		+= gunze.o
 obj-$(CONFIG_TOUCHSCREEN_EETI)		+= eeti_ts.o
 obj-$(CONFIG_TOUCHSCREEN_EKTF2127)	+= ektf2127.o
 obj-$(CONFIG_TOUCHSCREEN_ELAN)		+= elants_i2c.o
+obj-$(CONFIG_TOUCHSCREEN_ELAN_SPI)	+= elants_spi.o
 obj-$(CONFIG_TOUCHSCREEN_ELO)		+= elo.o
 obj-$(CONFIG_TOUCHSCREEN_EGALAX)	+= egalax_ts.o
 obj-$(CONFIG_TOUCHSCREEN_EGALAX_SERIAL)	+= egalax_ts_serial.o
diff --git a/drivers/input/touchscreen/elants_spi.c b/drivers/input/touchscreen/elants_spi.c
new file mode 100644
index 000000000..e4b143cf0
--- /dev/null
+++ b/drivers/input/touchscreen/elants_spi.c
@@ -0,0 +1,1816 @@
+// SPDX-License-Identifier: GPL-2.0-only
+//
+// ELAN touch controller driver for touch and marker input
+//
+// Copyright (C) 2023 reMarkable AS - http://www.remarkable.com/
+
+#include <linux/spi/spi.h>
+#include <linux/input/mt.h>
+#include <linux/interrupt.h>
+#include <linux/delay.h>
+#include <linux/module.h>
+#include <linux/gpio.h>
+#include <linux/errno.h>
+#include <linux/of.h>
+#include <linux/pm_wakeirq.h>
+#include <linux/pm_runtime.h>
+#include <linux/iopoll.h>
+#include <linux/regulator/consumer.h>
+#include <linux/firmware.h>
+#include <linux/unaligned.h>
+#include <linux/power_supply.h>
+#include <linux/miscdevice.h>
+
+struct marker_packet {
+	bool in_range;
+	bool tip;
+	bool barrel;
+	bool invert;
+	bool eraser;
+	bool second_barrel;
+	bool reserved;
+	uint16_t x;
+	uint16_t y;
+	uint16_t pressure;
+	uint8_t battery;
+	int16_t tilt_x;
+	int16_t tilt_y;
+	uint8_t tx1_intensity;
+	uint8_t tx2_intensity;
+	uint16_t gid[6];
+	uint16_t vendor_data;
+};
+
+#define CREATE_TRACE_POINTS
+#include <trace/events/elants_spi.h>
+
+#define ELAN_FW_PAGESIZE		132
+#define FW_PAGE_REWRITE_RETRY		3
+#define FW_PAGE_WRITE_TIMEOUT_US	5000
+
+#define FINGER_NUM			10
+
+#define HEADER_SIZE			4
+#define PACKET_SIZE			42
+#define PACKET_TYPE_MARKER		0x07
+#define PACKET_TYPE_TOUCH		0x62
+#define PACKET_TYPE_HELLO		0x55
+#define PACKET_TYPE_CALIB		0x66
+#define PACKET_TYPE_FINGER_WAKEUP	0x42
+#define PACKET_TYPE_NO_PACKET		0xFF
+
+#define PACKET_MARKER_CHECKSUM_FIELD 41
+#define PACKET_TOUCH_CHECKSUM_FIELD  34
+
+#define ELAN_RESET_DELAY_MSEC		20
+#define AUTOSUSPEND_DELAY		2000
+#define ELAN_CMD_TIMEOUT_US		10000
+#define ELAN_BOOT_READ_TIMEOUT_US	100000
+// trial and error up to 210-220ms, set 300ms.
+#define ELAN_CALIBRATE_TIMEOUT_US	300000
+#define ELAN_RETRY_ATTEMPTS		3
+#define ELAN_DEFAULT_IDLE_RATE		30
+
+#define ELAN_IOCTLID	0xD0
+#define IOCTL_RESET  _IOR(ELAN_IOCTLID, 4, int)
+#define IOCTL_IAP_MODE_LOCK  _IOR(ELAN_IOCTLID, 5, int)
+#define IOCTL_IAP_MODE_UNLOCK  _IOR(ELAN_IOCTLID, 12, int)
+#define IOCTL_I2C_INT  _IOR(ELAN_IOCTLID, 13, int)
+
+struct elants_spi_fw_info {
+	int fw_ver;
+	int fw_id;
+	int rx;
+	int tx;
+	int touch_x_res;
+	int touch_y_res;
+	int marker_x_res;
+	int marker_y_res;
+};
+
+struct elants_data {
+	struct spi_device *spi;
+	int spi_max_speed_hz;
+	int spi_comm_speed_hz;
+	struct input_dev *input_touch;
+	struct input_dev *input_marker;
+	uint16_t fw_version;
+	uint16_t fw_file_version;
+	uint16_t fw_file_id;
+	uint32_t fw_file_ver_offset;
+	uint32_t fw_file_id_offset;
+	const char *fw_name;
+	int mode; /* 0: normal, 1: recovery */
+	bool idle_mode;
+	struct power_supply *battery;
+	bool marker_in_range;
+	bool marker_in_contact;
+	uint8_t marker_capacity;
+	struct regulator *vcc33;
+	struct elants_spi_fw_info fw_info;
+	struct gpio_desc *irq_gpio;
+	struct gpio_desc *reset_gpio;
+	bool flip_pos_x;
+	bool flip_pos_y;
+	bool swap_axes;
+	bool inverted_tilt;
+	uint8_t sensor_pitch; /* mm per channel (x10) */
+	int idle_rate;
+	uint16_t gid[6];
+	uint16_t vendor_data;
+	const char *marker_model;
+	struct miscdevice elants_dev;
+};
+
+static inline int elants_spi_read_locked(struct spi_device *spi, void *buf, size_t len)
+{
+	struct spi_message msg;
+	struct spi_transfer t = {
+		.rx_buf = buf,
+		.len = len,
+	};
+
+	spi_message_init_with_transfers(&msg, &t, 1);
+
+	return spi_sync_locked(spi, &msg);
+}
+
+static inline int elants_spi_write_locked(struct spi_device *spi, const void *buf, size_t len)
+{
+	struct spi_message msg;
+	struct spi_transfer t = {
+		.tx_buf = buf,
+		.len = len,
+	};
+
+	spi_message_init_with_transfers(&msg, &t, 1);
+
+	return spi_sync_locked(spi, &msg);
+}
+
+static int elants_set_idle_mode_locked(struct elants_data *ts, bool enable)
+{
+	int err;
+	uint8_t cmd_idle_mode[] = {0x54, 0x2C, 0x00, 0x00, 0x00, 0x00};
+
+	if (enable)
+		cmd_idle_mode[2] = 0x2;
+
+	err = elants_spi_write_locked(ts->spi, cmd_idle_mode, sizeof(cmd_idle_mode));
+	if (err)
+		return err;
+
+	ts->idle_mode = enable;
+	return 0;
+}
+
+static int elants_set_idle_mode(struct elants_data *ts, bool enable)
+{
+	int err;
+
+	spi_bus_lock(ts->spi->controller);
+	err = elants_set_idle_mode_locked(ts, enable);
+	spi_bus_unlock(ts->spi->controller);
+
+	return err;
+}
+
+static int elants_spi_write_then_read(struct elants_data *ts, const uint8_t *txbuf,
+				      const int txlen, uint8_t *rxbuf, const int rxlen,
+				      const int timeout)
+{
+	int error = 0;
+	int tries = ELAN_RETRY_ATTEMPTS;
+	int pstatus;
+
+	spi_bus_lock(ts->spi->controller);
+
+	if (ts->idle_mode) {
+		error = elants_set_idle_mode_locked(ts, false);
+		if (error)
+			goto out;
+	}
+
+retry:
+	--tries;
+
+	error = elants_spi_write_locked(ts->spi, txbuf, txlen);
+	if (error)
+		goto out;
+
+	if (rxbuf) {
+		error = read_poll_timeout(gpiod_get_value_cansleep, pstatus, pstatus == 1,
+					  (timeout >> 8), timeout, 0, ts->irq_gpio);
+		if (error == -ETIMEDOUT) {
+			if (tries > 0) {
+				dev_info(&ts->spi->dev,
+					 "write_then_read timed out. Attempts left: %d. Retrying...\n",
+					 tries);
+				goto retry;
+			}
+		}
+		if (error)
+			goto out;
+
+		error = elants_spi_read_locked(ts->spi, rxbuf, rxlen);
+		if (error)
+			goto out;
+	}
+
+out:
+	spi_bus_unlock(ts->spi->controller);
+
+	return error;
+}
+
+static int elants_get_idle_rate(struct elants_data *ts)
+{
+	int error;
+	uint8_t rbuf[6];
+	const uint8_t cmd_idle_rate[6] = {0x53, 0xC3, 0x00, 0x00, 0x00, 0x00};
+
+	error = elants_spi_write_then_read(ts, cmd_idle_rate, sizeof(cmd_idle_rate),
+					   rbuf, sizeof(rbuf), ELAN_CMD_TIMEOUT_US);
+	if (error) {
+		dev_err(&ts->spi->dev, "get idle rate failed: %d\n", error);
+		return error;
+	}
+
+	ts->idle_rate = (rbuf[2] << 8) + rbuf[3];
+	return 0;
+}
+
+static int elants_set_idle_rate(struct elants_data *ts, uint16_t idle_rate)
+{
+	uint8_t cmd_idle_rate[] = {0x54, 0xC3, 0x00, 0x00, 0x00, 0x00};
+
+	cmd_idle_rate[2] = idle_rate << 8;
+	cmd_idle_rate[3] = idle_rate & 0xff;
+
+	return elants_spi_write_then_read(ts, cmd_idle_rate, sizeof(cmd_idle_rate),
+				   NULL, 0, ELAN_CMD_TIMEOUT_US);
+}
+
+static int elants_set_palm_reject(struct elants_data *ts, bool enable)
+{
+	uint8_t cmd_palm_reject[] = {0x54, 0xC1, 0x13, 0x10, 0x00, 0x00};
+
+	if (enable)
+		cmd_palm_reject[3] = 0x18;
+
+	return elants_spi_write_then_read(ts, cmd_palm_reject, sizeof(cmd_palm_reject),
+				   NULL, 0, ELAN_CMD_TIMEOUT_US);
+}
+
+static int elants_get_palm_reject(struct elants_data *ts, bool *enabled)
+{
+	int error;
+	uint8_t rbuf[6];
+	const uint8_t cmd_palm_reject[6] = {0x53, 0xC1, 0x00, 0x01, 0x00, 0x00};
+
+	error = elants_spi_write_then_read(ts, cmd_palm_reject, sizeof(cmd_palm_reject),
+					   rbuf, sizeof(rbuf), ELAN_CMD_TIMEOUT_US);
+	if (error) {
+		dev_err(&ts->spi->dev, "get palm reject failed: %d\n", error);
+		return error;
+	}
+
+	*enabled = (rbuf[3] == 0x18) ? true : false;
+
+	return 0;
+}
+
+static int elants_get_info(struct elants_data *ts)
+{
+	int error;
+	struct device *dev = &ts->spi->dev;
+	const uint8_t cmd_ver[6] = {0x53, 0x00, 0x00, 0x01, 0x00, 0x00};
+	const uint8_t cmd_id[6] = {0x53, 0xf0, 0x00, 0x01, 0x00, 0x00};
+	uint8_t rbuf[6] = {0x00};
+	int major;
+	int minor;
+	struct elants_spi_fw_info *fw_info = &ts->fw_info;
+	int len_ack_53 = 6;
+
+	error = elants_spi_write_then_read(ts, cmd_id, sizeof(cmd_id),
+				    rbuf, len_ack_53, ELAN_CMD_TIMEOUT_US);
+	if (error) {
+		dev_err(dev, "get fw id failed\n");
+		return error;
+	}
+	major = ((rbuf[1] & 0x0f) << 4) | ((rbuf[2] & 0xf0) >> 4);
+	minor = ((rbuf[2] & 0x0f) << 4) | ((rbuf[3] & 0xf0) >> 4);
+	fw_info->fw_id = major << 8 | minor;
+
+	error = elants_spi_write_then_read(ts, cmd_ver, sizeof(cmd_ver),
+				    rbuf, len_ack_53, ELAN_CMD_TIMEOUT_US);
+	if (error) {
+		dev_err(dev, "get fw version faile\n");
+		return error;
+	}
+	major = ((rbuf[1] & 0x0f) << 4) | ((rbuf[2] & 0xf0) >> 4);
+	minor = ((rbuf[2] & 0x0f) << 4) | ((rbuf[3] & 0xf0) >> 4);
+
+	fw_info->fw_ver =  major << 8 | minor;
+	dev_info(dev, "version: %04x\n", fw_info->fw_ver);
+
+	error = elants_get_idle_rate(ts);
+	if (error)
+		return error;
+
+	return 0;
+}
+
+static int elants_check_status(struct elants_data *ts)
+{
+	int error;
+	struct device *dev = &ts->spi->dev;
+	unsigned char rxbuf[4] = {0};
+	uint8_t normal[4] = {0x55, 0x55, 0x55, 0x55};
+	uint8_t recovery[4] = {0x55, 0x55, 0x80, 0x80};
+	int pstatus;
+
+	error = read_poll_timeout(gpiod_get_value_cansleep, pstatus, pstatus == 1,
+				  500, ELAN_BOOT_READ_TIMEOUT_US, 0, ts->irq_gpio);
+	if (error) {
+		dev_err(dev, "%s failed polling int\n", __func__);
+		return error;
+	}
+
+	error = spi_read(ts->spi, rxbuf, 4);
+	if (error) {
+		dev_err(dev, "%s error\n", __func__);
+		return error;
+	}
+
+	if (memcmp(rxbuf, normal, 4) == 0) {
+		ts->mode = 0;
+		dev_info(dev, "normal mode\n");
+	} else if (memcmp(rxbuf, recovery, 4) == 0) {
+		dev_info(dev, "recovery mode\n");
+		ts->mode = 1;
+	} else {
+		dev_err(dev, "unknown mode. SPI device not found\n");
+		return -ENODEV;
+	}
+
+	return 0;
+}
+
+static int elants_init(struct elants_data *ts)
+{
+	int error;
+	struct device *dev = &ts->spi->dev;
+
+	error = elants_check_status(ts);
+	if (error) {
+		dev_err(dev, "error check status: %d\n", error);
+		return error;
+	}
+
+	error = elants_set_idle_rate(ts, ts->idle_rate);
+	if (error) {
+		dev_err(dev, "error setting idle_rate: %d\n", error);
+		return error;
+	}
+
+	error = elants_get_info(ts);
+	if (error) {
+		dev_err(dev, "error get info: %d\n", error);
+		return error;
+	}
+
+	return 0;
+}
+
+static void elants_reset(struct elants_data *ts)
+{
+	gpiod_set_value(ts->reset_gpio, 1);
+	mdelay(1);
+	gpiod_set_value(ts->reset_gpio, 0);
+	mdelay(1);
+}
+
+static int elants_spi_locked_check_ack(struct elants_data *ts, char *rbuf,
+				       const char *ackbuf, int read_len, int ack_len)
+{
+	int error;
+	unsigned char *rxbuf;
+
+	rxbuf = kmalloc_array(read_len, 8, GFP_KERNEL);
+
+	error = elants_spi_read_locked(ts->spi, rxbuf, read_len);
+	if (error)
+		goto end;
+
+	error = memcmp(ackbuf, rxbuf, ack_len);
+	memcpy(rbuf, rxbuf, read_len);
+end:
+	kfree(rxbuf);
+	return error;
+}
+
+static int elants_calibrate(struct elants_data *ts)
+{
+	int error;
+	struct device *dev = &ts->spi->dev;
+	static const u8 w_flashkey[] = { 0x54, 0xC0, 0xE1, 0x5A, 0x00, 0x00 };
+	static const u8 rek[] = { 0x54, 0x29, 0x00, 0x01, 0x00, 0x00 };
+	static const u8 rek_resp[] = { 0x66, 0x66, 0x66, 0x66 };
+	char *rbuf;
+
+	rbuf = kmalloc(sizeof(unsigned char) * sizeof(rek_resp), GFP_KERNEL);
+
+	error = elants_spi_write_then_read(ts, w_flashkey, sizeof(w_flashkey),
+				    NULL, 0, ELAN_CMD_TIMEOUT_US);
+	if (error)
+		dev_err(dev, "send flash key failed: %d\n", error);
+
+	usleep_range(5000, 10000);
+
+	error = elants_spi_write_then_read(ts, rek, sizeof(rek),
+				    rbuf, sizeof(rek_resp), ELAN_CALIBRATE_TIMEOUT_US);
+	if (error) {
+		dev_err(dev, "send calibrate failed: %d\n", error);
+		goto end;
+	}
+
+	error = memcmp(rek_resp, rbuf, sizeof(rek_resp));
+	if (error)
+		dev_err(dev, "unexpected calibration response: %*ph\n",
+			(int)sizeof(rek_resp), rbuf);
+
+end:
+	kfree(rbuf);
+
+	return error;
+}
+
+static int elants_spi_locked_enter_isp(struct elants_data *ts, bool recovery_isp)
+{
+	int error;
+	unsigned char enter_isp_cmd[4] = {0x45, 0x49, 0x41, 0x50};
+	unsigned char enter_recovery_isp_cmd[4] = {0x54, 0x00, 0x12, 0x34};
+
+	if (recovery_isp)
+		memcpy(enter_isp_cmd, enter_recovery_isp_cmd, 4);
+
+	error = elants_spi_write_locked(ts->spi, enter_isp_cmd, sizeof(enter_isp_cmd));
+	if (error)
+		return error;
+
+	return 0;
+}
+
+static int elants_spi_locked_validate_remark_id(struct elants_data *ts, const struct firmware *fw)
+{
+	int error;
+	int pstatus;
+	int tries = ELAN_RETRY_ATTEMPTS;
+	struct device *dev = &ts->spi->dev;
+	const u8 query_remark_id_cmd[] = { 0x96, 0x80, 0x1F, 0x00, 0x00, 0x21 };
+	uint8_t resp[6];
+	uint16_t ts_remark_id;
+	uint16_t fw_remark_id;
+
+retry:
+	--tries;
+
+	error = elants_spi_write_locked(ts->spi, query_remark_id_cmd, sizeof(query_remark_id_cmd));
+	if (error)
+		return error;
+
+	error = read_poll_timeout(gpiod_get_value_cansleep, pstatus, pstatus == 1,
+				  50, ELAN_CMD_TIMEOUT_US, 0, ts->irq_gpio);
+	if (error == -ETIMEDOUT) {
+		if (tries > 0) {
+			dev_info(&ts->spi->dev,
+				 "validate_remark_id timed out. Attempts left: %d. Retrying...\n",
+				 tries);
+			goto retry;
+		}
+	}
+	if (error)
+		return error;
+
+	error = elants_spi_read_locked(ts->spi, resp, sizeof(resp));
+	if (error)
+		return error;
+
+	ts_remark_id = get_unaligned_be16(&resp[3]);
+	fw_remark_id = get_unaligned_le16(&fw->data[fw->size - 4]);
+	if (fw_remark_id != ts_remark_id) {
+		dev_err(dev, "remark id mismatch: ts=0x%04x, fw=0x%04x\n",
+			ts_remark_id, fw_remark_id);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int elants_get_fw_file_info(struct elants_data *ts, const struct firmware *fw)
+{
+	uint32_t ver_idx = ts->fw_file_ver_offset;
+	uint32_t id_idx = ts->fw_file_id_offset;
+
+	if (fw->size <= (id_idx + 1))
+		return -EINVAL;
+
+	ts->fw_file_version = (fw->data[ver_idx + 1] << 8) + fw->data[ver_idx];
+	ts->fw_file_id = (fw->data[id_idx + 1] << 8) + fw->data[id_idx];
+
+	return 0;
+}
+
+static int elants_firmware_update(struct elants_data *ts)
+{
+	int error;
+	int pstatus;
+	int i;
+	char *rbuf;
+	struct device *dev = &ts->spi->dev;
+	const char iap_page_ack[] = {0xAA, 0xAA};
+	unsigned char dummy_cmd[1] = {0x10};
+	const struct firmware *fw = NULL;
+	const u8 *fw_data;
+	unsigned char *fw_page_data;
+	int fw_size;
+	int fw_pagenum;
+	int fw_page_rewrite_cnt = 0;
+
+	rbuf = kmalloc(sizeof(unsigned char) * sizeof(iap_page_ack), GFP_KERNEL);
+	fw_page_data = kmalloc(sizeof(unsigned char) * ELAN_FW_PAGESIZE, GFP_KERNEL);
+
+	if (pm_runtime_enabled(dev)) {
+		pm_runtime_disable(dev);
+		error = elants_set_idle_mode(ts, false);
+		if (error)
+			goto out;
+	}
+
+	disable_irq(ts->spi->irq);
+
+	error = request_firmware(&fw, ts->fw_name, dev);
+	if (error) {
+		dev_err(dev, "%s: request_firmware fail, ret=%d\n", __func__, error);
+		goto out;
+	}
+
+	error = elants_get_fw_file_info(ts, fw);
+	if (error) {
+		dev_err(dev, "failed to read fw file version: %d\n", error);
+		goto out;
+	}
+
+	if ((ts->fw_info.fw_id != ts->fw_file_id) || (ts->fw_file_version == ts->fw_info.fw_ver)) {
+		dev_info(dev, "fw current: 0x%04x, file: 0x%04x, id: 0x%04x\n",
+			 ts->fw_info.fw_ver, ts->fw_file_version, ts->fw_file_id);
+
+		/* Some early firmwares has fw id set to 0x0.
+		 * Support upgrading of such firmwares.
+		 */
+		if (!ts->fw_info.fw_id)
+			dev_warn(dev, "broken firmware id detected - allowing firmware update\n");
+		else if (!ts->mode)
+			goto out;
+
+		/* We don't have valid fw version/id if current TS firmware is
+		 * broken and TS is in recovery mode, force update to recover.
+		 */
+		dev_warn(dev, "forcing firmware update in recovery mode\n");
+	}
+
+	fw_data = fw->data;
+	fw_size = fw->size;
+	fw_pagenum = (fw_size/sizeof(uint8_t)/ELAN_FW_PAGESIZE);
+
+	if (fw_size % ELAN_FW_PAGESIZE) {
+		dev_err(dev, "invalid firmware length: %zu\n", fw->size);
+		error = -EINVAL;
+		goto out;
+	}
+
+	ts->spi->max_speed_hz = ts->spi_comm_speed_hz;
+
+	spi_bus_lock(ts->spi->controller);
+
+	if (!ts->mode) {
+		elants_reset(ts);
+		msleep(30);
+	}
+
+	error = elants_spi_locked_validate_remark_id(ts, fw);
+	if (error) {
+		dev_err(dev, "%s: validate remark id failed: %d\n", __func__, error);
+		goto end;
+	}
+
+	error = elants_spi_locked_enter_isp(ts, ts->mode);
+	if (error)
+		goto end;
+
+	usleep_range(2000, 8000);
+
+	error = elants_spi_write_locked(ts->spi, dummy_cmd,  sizeof(dummy_cmd));
+	if (error)
+		goto end;
+
+	ts->spi->max_speed_hz = ts->spi_max_speed_hz;
+
+retry:
+	for (i = 0; i < fw_pagenum; i++) {
+		memcpy(fw_page_data, fw_data + i*ELAN_FW_PAGESIZE, ELAN_FW_PAGESIZE);
+
+		error = elants_spi_write_locked(ts->spi, fw_page_data, ELAN_FW_PAGESIZE);
+		if (error) {
+			dev_err(dev, "%s: IAP write page fail\n", __func__);
+			goto retry;
+		}
+
+		error = read_poll_timeout(gpiod_get_value_cansleep, pstatus, pstatus == 1,
+					  50, FW_PAGE_WRITE_TIMEOUT_US, 0, ts->irq_gpio);
+		if (error) {
+			dev_err(dev, "error polling interrupt: %d\n", error);
+			goto end;
+		}
+
+		error = elants_spi_locked_check_ack(ts, rbuf, iap_page_ack,
+					  sizeof(iap_page_ack), sizeof(iap_page_ack));
+		if (error) {
+			fw_page_rewrite_cnt++;
+			dev_err(dev, "page %d: page_ack failed %d times, (0x%02x 0x%02x)\n",
+				i, fw_page_rewrite_cnt, rbuf[0], rbuf[1]);
+			if (fw_page_rewrite_cnt == FW_PAGE_REWRITE_RETRY)
+				goto end;
+			else
+				goto retry;
+		}
+	}
+
+end:
+	spi_bus_unlock(ts->spi->controller);
+
+	if (error)
+		dev_err(dev, "fw update failed: %d\n", error);
+
+	elants_reset(ts);
+	msleep(ELAN_RESET_DELAY_MSEC);
+
+	error = elants_init(ts);
+	if (error)
+		dev_err(dev, "failed init: %d\n", error);
+
+	if (!error) {
+		msleep(50);
+		error = elants_calibrate(ts);
+		if (error)
+			dev_err(dev, "calibrate error: %d\n", error);
+	}
+
+out:
+	enable_irq(ts->spi->irq);
+
+	if (fw != NULL)
+		release_firmware(fw);
+
+	pm_runtime_enable(dev);
+
+	ts->spi->max_speed_hz = ts->spi_max_speed_hz;
+	kfree(rbuf);
+	kfree(fw_page_data);
+
+	return error;
+}
