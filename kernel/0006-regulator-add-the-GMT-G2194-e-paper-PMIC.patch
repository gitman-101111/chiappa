+};
+
+#define REGULATOR_DESC(_name, _id, _linear_range, _ops) \
+	.name = #_name, \
+	.of_match = of_match_ptr(#_name), \
+	.regulators_node = of_match_ptr("regulators"), \
+	.id = _id, \
+	.ops = &_ops, \
+	.type = REGULATOR_VOLTAGE, \
+	.n_voltages = _name ## _VOLTAGE_CTRL_MASK + 1, \
+	.linear_ranges = _linear_range, \
+	.n_linear_ranges = ARRAY_SIZE(_linear_range), \
+	.vsel_reg = G2194_REG_ ## _name ## _SETTING_BASE, \
+	.vsel_mask = _name ## _VOLTAGE_CTRL_MASK, \
+	.owner = THIS_MODULE
+
+#define REGULATOR_DESC_LDO(_name, _id, _linear_range, _ops, \
+			   _tdly_reg, _tdly_mask) { \
+	REGULATOR_DESC(_name, _id, _linear_range, _ops), \
+	.soft_start_reg = _tdly_reg, \
+	.soft_start_mask = _tdly_mask, \
+	.of_parse_cb = g2194_set_tdly_value, \
+}
