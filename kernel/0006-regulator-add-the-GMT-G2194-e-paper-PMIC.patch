+#define EPD_VDD_STABLE_BEFORE_VNEG3_US	100
+#define EPD_VDD_BEFORE_ENABLE_US	(EPD_VDD_RAMP_TIME_US + EPD_VDD_STABLE_BEFORE_VNEG3_US)
