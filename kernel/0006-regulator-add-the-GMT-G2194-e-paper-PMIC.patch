+
+static ssize_t vpdd_length_store(struct device *dev, struct device_attribute *attr,
+				 const char *buf, size_t count)
+{
+	int val;
+	int ret;
+	int match_index;
+	struct g2194_data *data = dev_get_drvdata(dev);
+
+	ret = kstrtoint(buf, 0, &val);
+	if (ret)
+		return ret;
+
+	match_index = g2194_find_closest_vpdd_length(dev, val);
+	dev_dbg(dev, "Found match index %d val: %d\n", match_index, vpdd_len[match_index]);
+
+	ret = g2194_set_vpdd_length(data, match_index);
+	if (ret)
+		return ret;
+
+	data->vpdd_timer_val_ms = vpdd_len[match_index];
+	ret = g2194_set_pdd_mode(data, !!data->vpdd_timer_val_ms);
+	if (ret)
+		return ret;
+
+	return count;
+}
+
+static ssize_t vpdd_length_show(struct device *dev,
+				struct device_attribute *attr, char *buf)
+{
+	struct g2194_data *data = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%d\n", data->vpdd_timer_val_ms);
+}
+
+static ssize_t vpdd_timeout_ms_show(struct device *dev,
+				    struct device_attribute *attr, char *buf)
+{
+	struct g2194_data *data = dev_get_drvdata(dev);
+	unsigned long delta = 0;
+
+	if (atomic_read(&data->pmic_enabled))
+		return sysfs_emit(buf, "%d\n", data->vpdd_timer_val_ms);
+
+	if (timer_pending(&data->vpdd_timer))
+		delta = data->vpdd_timer.expires - jiffies;
+
+	return sysfs_emit(buf, "%u\n", jiffies_delta_to_msecs(delta));
+}
+
+static int g2194_early_enable(struct g2194_data *data)
+{
+	/* delete potential running PDD timer */
+	if (timer_delete_sync(&data->vpdd_timer)) {
+		/* force del xon_disable_timer and disable epd vdd */
+		timer_delete_sync(&data->xon_disable_timer);
+		gpiod_set_value_cansleep(data->epd_vdd_gpio, 0);
+		usleep_range(1000, 1500);
+		/* keep wakesrc active */
+	}
+
+	__pm_stay_awake(data->wakesrc);
+
+	gpiod_set_value_cansleep(data->epd_xon_gpio, 1);
+	gpiod_set_value_cansleep(data->epd_vdd_gpio, 1);
+	usleep_range(EPD_VDD_BEFORE_ENABLE_US, EPD_VDD_BEFORE_ENABLE_US + 100);
+
+	gpiod_set_value_cansleep(data->enable_gpio, 1);
+
+	mod_timer(&data->pre_enable_timer, jiffies +
+		  msecs_to_jiffies(PRE_ENABLE_TIMEOUT_MS));
+
+	return 0;
+}
+
+static ssize_t enable_nowait_store(struct device *dev, struct device_attribute *attr,
+				   const char *buf, size_t count)
+{
+	int ret;
+	struct g2194_data *data = dev_get_drvdata(dev);
+
+	ret = g2194_check_battery(dev, data);
+	if (ret)
+		return ret;
+
+	if (!sysfs_streq(buf, "1")) {
+		dev_err(dev, "Invalid value. Only Enable allowed\n");
+		return -EINVAL;
+	}
+
+	if (!atomic_read(&data->pmic_enabled))
+		ret = g2194_early_enable(data);
+
+
+	return ret ? ret : count;
+}
+
+static DEVICE_ATTR_RW(vpdd_length);
+static DEVICE_ATTR_RO(vpdd_timeout_ms);
+static DEVICE_ATTR_WO(enable_nowait);
+
+static struct attribute *g2194_attributes[] = {
+	&dev_attr_vpdd_length.attr,
+	&dev_attr_vpdd_timeout_ms.attr,
+	&dev_attr_enable_nowait.attr,
+	NULL,
+};
+
+static const struct attribute_group g2194_attr_group = {
+	.attrs	= g2194_attributes,
+};
+
+static int g2194_parse_delay_settings(struct regmap *regmap,
+				      struct device *dev)
+{
+	u32 ss;
+	const u32 ss_min = 3;
+	int ret = 0;
+	struct device_node *np = dev->of_node;
+
+	if (!of_property_read_u32(np, "gmt,soft-start", &ss)) {
+		if (ss >= ss_min && ss <= 6) {
+			ss = (ss - ss_min) << (ffs(PMIC_SOFT_START_TIME_MASK) - 1);
+			ret = regmap_update_bits(regmap, G2194_REG_CONTROL_REG,
+						 PMIC_SOFT_START_TIME_MASK, ss);
+		} else {
+			dev_info(dev, "Unsupported soft start value (%u)\n", ss);
+		}
+	}
+
+	if (ret)
+		dev_err(dev, "Failed to set ss value (%u)(%d)\n", ss, ret);
+
+	return ret;
+}
+
+static int g2194_shutdown_handler(struct sys_off_data *sysoff)
+{
+	struct g2194_data *data = sysoff->cb_data;
+
+	timer_delete_sync(&data->xon_disable_timer);
+
+	if (timer_delete_sync(&data->vpdd_timer)) {
+		/* GMT explaination on how to manually abort the HW PDD timer
+		 *
+		 * You can also use the ON_OFF[6] bit of register 0x18h
+		 * to interrupt PDD.
+		 * When EN = low, first change ON_OFF[6] from "1" to "0".
+		 * PDD can be interrupted when ON_OFF[6] is changed back to "1"
+		 */
+		regmap_update_bits(data->regmap, G2194_REG_KEEP_ALIVE_ON_OFF,
+				   ON_OFF_POWER_RAILS_MASK, 0);
+		regmap_update_bits(data->regmap, G2194_REG_KEEP_ALIVE_ON_OFF,
+				   ON_OFF_POWER_RAILS_MASK,
+				   ON_OFF_POWER_RAILS_MASK);
+
+		/* wait for VPDD to discharge to 0V */
+		usleep_range(150 * 1000, 200 * 1000);
+	}
+
+	return 0;
+}
+
+static int g2194_regulator_probe(struct i2c_client *i2c)
+{
+	int i;
+	int ret;
+	struct g2194_data *data;
+	struct regulator_config config = { };
+
+	data = devm_kzalloc(&i2c->dev, sizeof(struct g2194_data), GFP_KERNEL);
+	if (!data)
+		return -ENOMEM;
+
+	dev_set_drvdata(&i2c->dev, data);
+
+	data->regmap = devm_regmap_init_i2c(i2c, &g2194_regmap_config);
+	if (IS_ERR(data->regmap))
+		return dev_err_probe(&i2c->dev, PTR_ERR(data->regmap),
+				     "regmap initialization failed\n");
+
+	of_property_read_u32(i2c->dev.of_node, "min-battery", &data->min_battery_capacity);
+
+	data->pgood_gpio = devm_gpiod_get(&i2c->dev, "power-good", GPIOD_IN);
+	if (IS_ERR(data->pgood_gpio))
+		return dev_err_probe(&i2c->dev, PTR_ERR(data->pgood_gpio),
+				     "Power good GPIO fault\n");
+
+	data->enable_gpio = devm_gpiod_get(&i2c->dev, "enable", GPIOD_OUT_LOW);
+	if (IS_ERR(data->enable_gpio))
+		return dev_err_probe(&i2c->dev, PTR_ERR(data->enable_gpio),
+				     "Enable GPIO fault\n");
+
+	data->epd_vdd_gpio = devm_gpiod_get(&i2c->dev, "epd-vdd", GPIOD_OUT_LOW);
+	if (IS_ERR(data->epd_vdd_gpio))
+		return dev_err_probe(&i2c->dev, PTR_ERR(data->epd_vdd_gpio),
+				     "epd vdd GPIO fault\n");
+
+	data->epd_xon_gpio = devm_gpiod_get(&i2c->dev, "epd-xon", GPIOD_OUT_LOW);
+	if (IS_ERR(data->epd_xon_gpio))
+		return dev_err_probe(&i2c->dev, PTR_ERR(data->epd_xon_gpio),
+				     "epd xon GPIO fault\n");
+
+	data->vin_psy = devm_power_supply_get_by_reference(&i2c->dev,
+							 "vin-power-supply");
+	if (IS_ERR(data->vin_psy))
+		return dev_err_probe(&i2c->dev, PTR_ERR(data->vin_psy),
+				     "Failed to get VIN supply\n");
+	if (!data->vin_psy)
+		return dev_err_probe(&i2c->dev, -EPROBE_DEFER, "VIN supply not ready");
+
+	data->en_supply = devm_regulator_get(&i2c->dev, "en");
+	if (IS_ERR(data->en_supply))
+		return dev_err_probe(&i2c->dev, PTR_ERR(data->en_supply),
+				     "Failed to get EN supply\n");
+
+	g2194_parse_delay_settings(data->regmap, &i2c->dev);
+
+	if (of_property_read_bool(i2c->dev.of_node, "gmt,7-level-vgh2-only")) {
+		ret = regmap_update_bits(data->regmap, G2194_REG_CONTROL_REG,
+					 VGH2_VGL_7_LEVEL_OUTPUT,
+					 VGH2_VGL_7_LEVEL_OUTPUT);
+		if (ret)
+			dev_err(&i2c->dev, "Failed to set gmt,7-level-vgh2-only\n");
+	}
+
+	if (of_property_read_bool(i2c->dev.of_node, "gmt,enable-pdd")) {
+		int vpdd_reg;
+
+		if (!of_property_read_u32(i2c->dev.of_node, "gmt,vpdd-length-ms",
+					  &data->vpdd_timer_val_ms))
+			data->vpdd_timer_val_ms = 6000;
+
+		vpdd_reg = g2194_find_closest_vpdd_length(&i2c->dev, data->vpdd_timer_val_ms);
+		data->vpdd_timer_val_ms = vpdd_len[vpdd_reg];
+		ret = g2194_set_vpdd_length(data, vpdd_reg);
+		if (ret)
+			dev_err(&i2c->dev, "Failed to set vpdd length\n");
+
+		ret = g2194_set_pdd_mode(data, !!data->vpdd_timer_val_ms);
+		if (ret)
+			dev_err(&i2c->dev, "Failed to enable PDD power off sequence\n");
+	}
+
+	config.dev = &i2c->dev;
+	config.driver_data = data;
+	config.regmap = data->regmap;
+
+	for (i = 0; i < ARRAY_SIZE(g2194_regulators); i++) {
+		struct regulator_dev *rdev;
+
+		rdev = devm_regulator_register(config.dev, &g2194_regulators[i],
+					       &config);
+		if (IS_ERR(rdev)) {
+			dev_err(config.dev, "failed to register %s regulator\n",
+					g2194_regulators[i].name);
+			return PTR_ERR(rdev);
+		}
+	}
+
+	ret = sysfs_create_group(&i2c->dev.kobj, &g2194_attr_group);
+	if (ret != 0) {
+		dev_err(&i2c->dev,
+			"Failed to create attribute group: %d\n", ret);
+		return ret;
+	}
+
+	ret = devm_register_sys_off_handler(&i2c->dev,
+					    SYS_OFF_MODE_RESTART_PREPARE,
+					    SYS_OFF_PRIO_DEFAULT,
+					    g2194_shutdown_handler, data);
+	if (ret)
+		return ret;
+
+	ret = devm_register_sys_off_handler(&i2c->dev,
+					    SYS_OFF_MODE_POWER_OFF_PREPARE,
+					    SYS_OFF_PRIO_DEFAULT,
+					    g2194_shutdown_handler, data);
+	if (ret)
+		return ret;
+
+	data->wakesrc = wakeup_source_register(&i2c->dev, dev_name(&i2c->dev));
+	if (!data->wakesrc) {
+		dev_err(&i2c->dev, "Failed to register wakeup source\n");
+		/* continue */
+	}
+
+	timer_setup(&data->pre_enable_timer, g2194_pre_enable_timeout_func, 0);
+	timer_setup(&data->vpdd_timer, g2194_vpdd_timeout_func, 0);
+	timer_setup(&data->xon_disable_timer, g2194_xon_disable_timeout_func, 0);
+
+	return 0;
+}
+
+static void g2194_regulator_remove(struct i2c_client *i2c)
+{
+	struct g2194_data *data = i2c_get_clientdata(i2c);
+
+	wakeup_source_unregister(data->wakesrc);
+	sysfs_remove_group(&i2c->dev.kobj, &g2194_attr_group);
+}
+
+static int g2194_regulator_save_restore(struct g2194_data *data, bool save)
+{
+	int i;
+	int k;
+	int ret = 0;
+
+	for (k = 0, i = 1; i < G2194_SAVED_REGISTERS_END; k++, i = i + 2) {
+		if (save)
+			ret = regmap_read(data->regmap, i, &data->saved_reg[k]);
+		else
+			ret = regmap_write(data->regmap, i, data->saved_reg[k]);
+
+		if (ret)
+			return ret;
+	}
+
+	return ret;
+}
+
+static bool g2194_safe_to_suspend(struct device *dev)
+{
+	struct g2194_data *data = i2c_get_clientdata(to_i2c_client(dev));
+
+	/* Sanity check - ensure that EPD PMIC is off and that (delayed)
+	 * EPD VDD disabling has been done.
+	 */
+
+	if (atomic_read(&data->pmic_enabled)) {
+		dev_err(dev, "Can't suspend, epd pmic enabled\n");
+		return false;
+	}
+
+	if (timer_pending(&data->vpdd_timer)) {
+		dev_err(dev, "Can't suspend, vpdd timer running\n");
+		return false;
+	}
+
+	return true;
+}
+
+static int g2194_regulator_suspend(struct device *dev)
+{
+	struct g2194_data *data = i2c_get_clientdata(to_i2c_client(dev));
+
+	if (!g2194_safe_to_suspend(dev))
+		return -EAGAIN;
+
+	return g2194_regulator_save_restore(data, true);
+}
+
+static int g2194_regulator_resume(struct device *dev)
+{
+	struct g2194_data *data = i2c_get_clientdata(to_i2c_client(dev));
+
+	return g2194_regulator_save_restore(data, false);
+}
+
+static const struct dev_pm_ops g2194_regulator_pm = {
+	SET_SYSTEM_SLEEP_PM_OPS(g2194_regulator_suspend, g2194_regulator_resume)
+};
+
+static const struct of_device_id g2194_regulator_of_match[] = {
+	{ .compatible = "gmt,g2194-regulator", },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, g2194_regulator_of_match);
+
+static struct i2c_driver g2194_regulator_driver = {
+	.driver = {
+		.name = "g2194-regulator",
+		.of_match_table = g2194_regulator_of_match,
+		.pm = &g2194_regulator_pm,
+	},
+	.probe = g2194_regulator_probe,
+	.remove = g2194_regulator_remove,
+};
+module_i2c_driver(g2194_regulator_driver);
+
+MODULE_DESCRIPTION("G2194 voltage regulator driver");
+MODULE_LICENSE("GPL v2");
