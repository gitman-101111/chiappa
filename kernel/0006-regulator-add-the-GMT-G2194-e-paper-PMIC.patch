+/* G2194_REG_PWRON_DELAY_1/2 bits */
+#define VPX_TO_VGL_RAMP_MASK		0xC000
+#define VGL_TO_VNEG3_RAMP_MASK		0x3000
+#define VNEG3_TO_VNEG2_RAMP_MASK	0x0C00
+#define VNEG2_TO_VNEG1_RAMP_MASK	0x0300
+#define VNEG1_TO_VPOS3_RAMP_MASK	0x00C0
+#define VPOS3_TO_VPOS2_RAMP_MASK	0x0030
+#define VPOS2_TO_VPOS1_RAMP_MASK	0x000C
+#define VPOS1_TO_VGH1_RAMP_MASK	0x0003
+
+/* G2194_REG_PWRON_DELAY_3 bits */
+#define VGH1_TO_VGH2_RAMP_MASK	0xC000
+#define PDD_POWER_OFF_SEQ_MASK	0x2000
+
+/* G2194_REG_CONTROL_REG bits */
+#define PMIC_SOFT_START_TIME_MASK	0xC000
+#define VGH2_VGL_7_LEVEL_OUTPUT		0x1000
+#define VGH1_DISCHARGE_MASK		0x0800
+#define VGH2_DISCHARGE_MASK		0x0400
+#define VPDD_LEN_DELAY_MASK		0x00ff
