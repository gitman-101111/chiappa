From 62c6e56570119f92fae37c07c00e4ce77bf19b62 Mon Sep 17 00:00:00 2001
From: gitman-101111 <development@spamfolder.xyz>
Date: Mon, 12 Oct 2026 10:23:07 -0600
Subject: [PATCH] regulator: add the GMT G2194 e-paper PMIC

The G2194 generates the EPD bias rails (VPOS/VNEG 1-3, VGH, VGL, VPDD,
VCOM) and sequences them through its enable and power-good pins. The
driver also carries the delayed VPDD power-down timer the waveform
engine configures through vpdd_length. Ported from reMarkable's
linux-imx-rm 6.12 tree; the i.MX bus-frequency boost calls are dropped.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 drivers/regulator/Kconfig           |   7 +
 drivers/regulator/Makefile          |   1 +
 drivers/regulator/g2194-regulator.c | 933 ++++++++++++++++++++++++++++
 3 files changed, 941 insertions(+)
 create mode 100644 drivers/regulator/g2194-regulator.c

diff --git a/drivers/regulator/Kconfig b/drivers/regulator/Kconfig
index a54a54919..d345e0289 100644
--- a/drivers/regulator/Kconfig
+++ b/drivers/regulator/Kconfig
@@ -440,6 +440,13 @@ config REGULATOR_FAN53880
 	  (PMIC), it is controlled by I2C and provides one BUCK, one BOOST
 	  and four LDO outputs.
 
+config REGULATOR_G2194
+	tristate "GMT G2194 voltage regulator"
+	depends on I2C
+	select REGMAP_I2C
+	help
+	  This driver supports the GMT G2194 e-paper display PMIC.
+
 config REGULATOR_GPIO
 	tristate "GPIO regulator support"
 	depends on GPIOLIB || COMPILE_TEST
