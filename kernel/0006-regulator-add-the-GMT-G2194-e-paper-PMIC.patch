+	REGULATOR_DESC(_name, _id, _linear_range, _ops), \
+	.off_on_delay = 30800, \
+	.active_discharge_reg = G2194_REG_VCOM_SETTING_BASE, \
+	.active_discharge_on = 0, \
+	.active_discharge_off = VCOM_DISCHARGE_MASK, \
+	.active_discharge_mask = VCOM_DISCHARGE_MASK, \
+}
+
+#define REGULATOR_DESC_FIXED(_name, _id, _ops, _tdly_reg, _tdly_mask) \
+	.name = #_name, \
+	.of_match = of_match_ptr(#_name), \
+	.regulators_node = of_match_ptr("regulators"), \
+	.id = _id, \
+	.ops = &_ops, \
+	.type = REGULATOR_VOLTAGE, \
+	.n_voltages = 1, \
+	.soft_start_reg = _tdly_reg, \
+	.soft_start_mask = _tdly_mask, \
+	.of_parse_cb = g2194_set_tdly_value, \
+	.owner = THIS_MODULE
+
+#define REGULATOR_DESC_FIXED_VGH(_name, _id, _tdly_reg, _tdly_mask, \
+				 _discharge_reg, _discharge_on, _discharge_off, \
+				 _discharge_mask) { \
+	REGULATOR_DESC_FIXED(_name, _id, g2194_reg_fixed_ops_vgh, _tdly_reg, _tdly_mask), \
+	.active_discharge_reg = _discharge_reg, \
+	.active_discharge_on = _discharge_on, \
+	.active_discharge_off = _discharge_off, \
+	.active_discharge_mask = _discharge_mask, \
+}
+
