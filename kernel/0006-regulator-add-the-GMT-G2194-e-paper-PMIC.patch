+	 1100,  1160,  1210,  1270,  1330,  1330,  1390,  1440,  1500,  1560,
+	 1620,  1680,  1740,  1800,  1860,  1920,  1980,  2040,  2100,  2160,
+	 2220,  2280,  2340,  2400,  2460,  2530,  2590,  2650,  2710,  2780,
+	 2840,  2900,  2970,  3030,  3100,  3160,  3230,  3290,  3360,  3420,
+	 3490,  3550,  3620,  3690,  3750,  3820,  3890,  4030,  4090,  4160,
+	 4230,  4300,  4370,  4440,  4510,  4580,  4650,  4720,  4800,  4870,
+	 4940,  5010,  5080,  5160,  5230,  5310,  5380,  5450,  5530,  5600,
+	 5680,  5760,  5830,  5910,  5990,  6060,  6140,  6220,  6300,  6380,
+	 6460,  6540,  6620,  6700,  6780,  6860,  6940,  7020,  7110,  7190,
+	 7270,  7360,  7440,  7520,  7610,  7700,  7780,  7870,  7960,  8040,
+	 8130,  8220,  8310,  8400,  8490,  8590,  8680,  8760,  8850,  8950,
+	 9040,  9130,  9230,  9320,  9420,  9510,  9610,  9710,  9910,  9900,
+	10000, 10100, 10200, 10300, 10400, 10510, 10610, 10710, 10820, 10920,
+	11030, 11130, 11240, 11350, 11460, 11570, 11680, 11790, 11900, 12010,
+	12120, 12240, 12350, 12470, 12580, 12700, 12820, 12940, 13060, 13180,
+	13300, 13420, 13540, 13670, 13790, 13920, 14050, 14170, 14300, 14430,
+	14570, 14700, 14830, 14970, 15100, 15240, 15380, 15520, 15660, 15800,
+	15940, 16090, 16230, 16380, 16530, 16680, 16830, 16980, 17140, 17290,
+	17450, 17610, 17770, 17930, 18100, 18260, 18430, 18600, 18770, 18940,
+	19120, 19290, 19470, 19650, 19830, 20020, 20210, 20390, 20590, 20780,
+	20980, 21170, 21370, 21580, 21780, 21990, 22200, 22420, 22640, 22860,
+	23080, 23300, 23530, 23770, 24000, 24240, 24490, 24730, 24990, 25240,
+	25500, 25760, 26030, 26300, 26580, 26860, 27150, 27440, 27740, 28050,
+	28360, 28670, 28990, 29320, 29660, 30000
+};
+
+struct g2194_data {
+	struct regmap *regmap;
+	struct gpio_desc *pgood_gpio;
+	struct gpio_desc *enable_gpio;
+	struct gpio_desc *epd_vdd_gpio;
+	struct gpio_desc *epd_xon_gpio;
+	struct regulator *en_supply;
+	struct power_supply *vin_psy;
+	struct wakeup_source *wakesrc;
+	atomic_t pmic_enabled;
+	struct timer_list pre_enable_timer;
+	struct timer_list vpdd_timer;
+	struct timer_list xon_disable_timer;
+	unsigned int vpdd_timer_val_ms;
+	unsigned int min_battery_capacity;
+	unsigned int saved_reg[G2194_SAVED_REGISTERS_END / 2];
+};
+
+static const struct regmap_config g2194_regmap_config = {
+	.reg_bits = 8,
+	.val_bits = 16,
+	.val_format_endian = REGMAP_ENDIAN_BIG,
+};
+
+/*
+ * VPOS1 LDO
+ * 2.0V to 12.23V (10mV step)
+ */
+static const struct linear_range g2194_vpos1_volts[] = {
+	REGULATOR_LINEAR_RANGE(2000000, 0x00, 0x3FF, 10000),
+};
+
+/* VPOS2 LDO
+ * 5.0V to 20.345V (15mV step)
+ */
+static const struct linear_range g2194_vpos2_volts[] = {
+	REGULATOR_LINEAR_RANGE(5000000, 0x00, 0x3FF, 15000),
+};
+
+/* VPOS3 LDO
+ * 9.0V to 30.483V (21mV step)
+ */
+static const struct linear_range g2194_vpos3_volts[] = {
+	REGULATOR_LINEAR_RANGE(9000000, 0x00, 0x3FF, 21000),
+};
+
+/*
+ * VNEG1 LDO
+ * -2.0V to -12.23V (10mV step)
+ * Represented as positive values.
+ */
+static const struct linear_range g2194_vneg1_volts[] = {
+	REGULATOR_LINEAR_RANGE(2000000, 0x00, 0x3FF, 10000),
+};
+
+/* VNEG2 LDO
+ * -5.0V to -20.345V (15mV step)
+ * Represented as positive values.
+ */
+static const struct linear_range g2194_vneg2_volts[] = {
+	REGULATOR_LINEAR_RANGE(5000000, 0x00, 0x3FF, 15000),
+};
+
+/* VNEG3 LDO
+ * -9.0V to -30.483V (21mV step)
+ * Represented as positive values.
+ */
+static const struct linear_range g2194_vneg3_volts[] = {
+	REGULATOR_LINEAR_RANGE(9000000, 0x00, 0x3FF, 21000),
+};
+
+/* VCOM
+ * -5.015V to +5V (19.6mV)
+ * Only implemented -5.15V to 0, represented as 0 to 5.015V due to
+ * unsupported negative voltages in regulator subsystem
+ */
+static const struct linear_range g2194_vcom_volts[] = {
+	REGULATOR_LINEAR_RANGE(17600, 0x100, 0x1ff, 19600),
+};
+
+/* VPDD
+ * +2V to +10V (500mV)
+ */
+static const struct linear_range g2194_vpdd_volts[] = {
+	REGULATOR_LINEAR_RANGE(2000000, 0x00, 0x10, 500000),
+};
+
+static int g2194_set_tdly_value(struct device_node *np,
+				const struct regulator_desc *desc,
+				struct regulator_config *cfg)
+{
+	int ret;
+	u32 tdly;
+
+	ret = of_property_read_u32(np, "gmt,tdly", &tdly);
+	if (ret == -EINVAL)
+		return 0;
+	else if (ret)
+		return ret;
+
+	if (tdly > 3) {
+		dev_warn(cfg->dev, "Unsupported tdly value\n");
+		return 0;
+	}
+
+	tdly = tdly << (ffs(desc->soft_start_mask) - 1);
+
+	if (desc->soft_start_mask && desc->soft_start_reg)
+		ret = regmap_update_bits(cfg->regmap, desc->soft_start_reg,
+					 desc->soft_start_mask, tdly);
+
+	return ret;
+}
+
+static int g2194_get_status(struct regulator_dev *rdev)
+{
+	struct g2194_data *data = dev_get_drvdata(rdev->dev.parent);
+
+	return atomic_read(&data->pmic_enabled);
+}
+
+static int g2194_check_battery(struct device *dev, struct g2194_data *data)
+{
+	int ret;
+	union power_supply_propval propval;
+
+	ret = power_supply_get_property(data->vin_psy,
+					POWER_SUPPLY_PROP_PRESENT,
+					&propval);
+	if (ret)
+		return ret;
+
+	if (propval.intval == 0) {
+		dev_err(dev, "Battery not connected. Skipping enable.\n");
+		return -EFAULT;
+	}
+
+	if (data->min_battery_capacity == 0)
+		return 0;
+
+	ret = power_supply_get_property(data->vin_psy,
+					POWER_SUPPLY_PROP_CAPACITY,
+					&propval);
+	if (ret)
+		return ret;
+
+	if (propval.intval < data->min_battery_capacity) {
+		dev_err(dev, "Battery at too low capacity (%d < %u). Skipping enable.\n",
+			propval.intval, data->min_battery_capacity);
+		return -EFAULT;
+	}
+
+	return 0;
+}
+
+static int g2194_vcom_enable(struct regulator_dev *rdev)
+{
+	struct g2194_data *data = dev_get_drvdata(rdev->dev.parent);
+	int ret;
+	int pgood;
+	ktime_t t0;
+	u32 f1, f3;
+
+	ret = g2194_check_battery(&rdev->dev, data);
+	if (ret)
+		return ret;
+
+	if (timer_delete_sync(&data->vpdd_timer)) {
+		/* force del xon_disable_timer and disable epd vdd */
+		timer_delete_sync(&data->xon_disable_timer);
+		gpiod_set_value_cansleep(data->epd_vdd_gpio, 0);
+		usleep_range(1000, 1500);
+		/* keep wakesrc active */
+	}
+
+	/* Cancel any existing timer to avoid any race situations */
+	atomic_set(&data->pmic_enabled, 1);
+	timer_delete_sync(&data->pre_enable_timer);
+
+	/* Prevent opportunistic sleep as long vcom is enabled */
+	__pm_stay_awake(data->wakesrc);
+
+	gpiod_set_value_cansleep(data->epd_xon_gpio, 1);
+	gpiod_set_value_cansleep(data->epd_vdd_gpio, 1);
+	usleep_range(EPD_VDD_BEFORE_ENABLE_US, EPD_VDD_BEFORE_ENABLE_US + 100);
+
+	gpiod_set_value_cansleep(data->enable_gpio, 1);
+
+	t0 = ktime_get();
+
+	ret = read_poll_timeout(gpiod_get_value_cansleep, pgood, pgood == 1,
+				100, 200000, 5, data->pgood_gpio);
+
+	if (ret) {
+		gpiod_set_value_cansleep(data->enable_gpio, 0);
+		gpiod_set_value_cansleep(data->epd_vdd_gpio, 0);
+		gpiod_set_value_cansleep(data->epd_xon_gpio, 0);
+
+		regmap_read(data->regmap, G2194_REG_FAULT_1, &f1);
+		regmap_read(data->regmap, G2194_REG_FAULT_3, &f3);
+
+		dev_err(&rdev->dev, "Power good signal timeout 0x%x/0x%x/0x%x\n",
+			f1 & 0xff, (f1 >> 8) & 0xff, f3);
+
+		atomic_set(&data->pmic_enabled, 0);
+	} else {
+		dev_dbg(&rdev->dev, "pgood took %lld us\n",
+			ktime_to_us(ktime_get()) - ktime_to_us(t0));
+	}
+
+	return ret;
+}
+
+static int g2194_vcom_disable(struct regulator_dev *rdev)
+{
+	struct g2194_data *data = dev_get_drvdata(rdev->dev.parent);
+
+	gpiod_set_value_cansleep(data->enable_gpio, 0);
+
+	if (data->vpdd_timer_val_ms) {
+		mod_timer(&data->xon_disable_timer,
+			  jiffies + msecs_to_jiffies(EPD_XON_OFF_DELAY_MS));
+
+		mod_timer(&data->vpdd_timer,
+			  jiffies + msecs_to_jiffies(data->vpdd_timer_val_ms));
+	} else {
+		gpiod_set_value_cansleep(data->epd_vdd_gpio, 0);
+		gpiod_set_value_cansleep(data->epd_xon_gpio, 0);
+
+		/* Unblock opportunistic sleep */
+		WARN_ON(!data->wakesrc->active);
+		__pm_relax(data->wakesrc);
+	}
+
+	/* It is always allowed to interrupt the PDD */
+	atomic_set(&data->pmic_enabled, 0);
+
+	return 0;
+}
+
+static int g2194_set_vpdd_length(struct g2194_data *data, int val)
+{
+	return regmap_update_bits(data->regmap, G2194_REG_CONTROL_REG,
+				  VPDD_LEN_DELAY_MASK, val);
+}
+
+static int g2194_set_pdd_mode(struct g2194_data *data, bool enable)
+{
+	return regmap_update_bits(data->regmap, G2194_REG_PWRON_DELAY_3,
+				  PDD_POWER_OFF_SEQ_MASK,
+				  enable ? PDD_POWER_OFF_SEQ_MASK : 0);
+}
+
+static void g2194_pre_enable_timeout_func(struct timer_list *t)
+{
+	struct g2194_data *data = timer_container_of(data, t, pre_enable_timer);
+
+	if (atomic_read(&data->pmic_enabled))
+		return;
+
+	gpiod_set_value(data->enable_gpio, 0);
+	gpiod_set_value(data->epd_vdd_gpio, 0);
+	gpiod_set_value(data->epd_xon_gpio, 0);
+
+	WARN_ON(!data->wakesrc->active);
+	__pm_relax(data->wakesrc);
+}
+
+static void g2194_vpdd_timeout_func(struct timer_list *t)
+{
+	struct g2194_data *data = timer_container_of(data, t, vpdd_timer);
+	gpiod_set_value(data->epd_vdd_gpio, 0);
+
+	WARN_ON(!data->wakesrc->active);
+	__pm_relax(data->wakesrc);
+}
+
+static void g2194_xon_disable_timeout_func(struct timer_list *t)
+{
+	struct g2194_data *data = timer_container_of(data, t, xon_disable_timer);
+
+	gpiod_set_value(data->epd_xon_gpio, 0);
+}
+
+static int g2194_find_closest_vpdd_length(struct device *dev, u32 vpdd_len_ms)
+{
+	int i;
+	int match_index = 0;
+
+	if (vpdd_len_ms > vpdd_len[255]) {
+		dev_err(dev, "Invalid vpdd_len_ms value %d max: %d\n",
+			vpdd_len_ms, vpdd_len[255]);
+		return -EINVAL;
+	}
+
+	/* Linear search find closest match */
+	for (i = 0; i < ARRAY_SIZE(vpdd_len); i++) {
+		int current_val = vpdd_len[i];
+
+		if (current_val <= vpdd_len_ms)
+			match_index = i;
+
+		if (current_val == vpdd_len_ms)
+			break;
+		else if (current_val > vpdd_len_ms) {
+			int prev_diff = vpdd_len_ms - vpdd_len[match_index];
+			int cur_diff = current_val - vpdd_len_ms;
+			int cmp = min(prev_diff, cur_diff);
+
+			if (cmp == cur_diff)
+				match_index = i;
+
+			break;
+		}
+	}
+
+	return match_index;
+}
