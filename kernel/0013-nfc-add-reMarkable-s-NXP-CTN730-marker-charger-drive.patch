diff --git a/drivers/nfc/ctn730_rm/ctn730.c b/drivers/nfc/ctn730_rm/ctn730.c
new file mode 100644
index 000000000..9f6e553c1
--- /dev/null
+++ b/drivers/nfc/ctn730_rm/ctn730.c
@@ -0,0 +1,721 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * reMarkable NXP CTN730
+ *
+ * Copyright (C) 2023 reMarkable AS - http://www.remarkable.com/
+ */
+
+#include <linux/delay.h>
+#include <linux/kernel.h>
+#include <linux/lockdep.h>
+#include <linux/version.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/init.h>
+#include <linux/rfkill.h>
+#include <linux/termios.h>
+#include "ctn730.h"
+#include "ctn730_i2c.h"
+#include "ctn730_sysfs.h"
+#include "ctn730_fw.h"
+#include "ctn730_supply.h"
+
+#define CREATE_TRACE_POINTS
+#include <trace/events/ctn730_rm.h>
+
+void ctn730_set_state(struct ctn730 *ctn730, enum ctn730_state new_state)
+{
+	int ret;
+	char env_1[64], env_2[64];
+	char *envp[] = { env_1, env_2, NULL };
+
+	lockdep_assert_held(&ctn730->lock);
+
+	dev_dbg(ctn730->dev, "state: %s->%s\n",
+		ctn730_state_text[ctn730->state],
+		ctn730_state_text[new_state]
+	);
+
+	ctn730->state = new_state;
+	trace_ctn730_state_update(ctn730);
+
+	/* send uevent */
+	envp[0] = "EVENT=nfc-host-state";
+	ret = sprintf(envp[1], "STATE=%s", ctn730_state_text[ctn730->state]);
+
+	if (ret > 0)
+		kobject_uevent_env(&ctn730->dev->kobj, KOBJ_CHANGE, envp);
+
+	/* update supply */
+	ctn730_supply_changed(ctn730);
+
+}
+
+void ctn730_set_charging_state(struct ctn730 *ctn730, enum ctn730_charging_state new_state)
+{
+	lockdep_assert_held(&ctn730->lock);
+
+	dev_dbg(ctn730->dev, "charging_state: %s->%s\n",
+		ctn730_charging_state_text[ctn730->charging_state],
+		ctn730_charging_state_text[new_state]
+	);
+
+	ctn730->charging_state = new_state;
+	trace_ctn730_state_update(ctn730);
+}
+
+void ctn730_set_device_state(struct ctn730 *ctn730, enum ctn730_device_state new_state)
+{
+	lockdep_assert_held(&ctn730->lock);
+
+	dev_dbg(ctn730->dev, "device_state: %s->%s\n",
+		ctn730_device_state_text[ctn730->device_state],
+		ctn730_device_state_text[new_state]
+	);
+
+	ctn730->device_state = new_state;
+	trace_ctn730_state_update(ctn730);
+
+	ctn730_supply_changed(ctn730);
+}
+
+void ctn730_set_app_data_state(struct ctn730 *ctn730, enum ctn730_app_data_state new_state)
+{
+	lockdep_assert_held(&ctn730->lock);
+
+	dev_dbg(ctn730->dev, "app_data_state: %s->%s\n",
+		ctn730_app_data_state_text[ctn730->app_data_state],
+		ctn730_app_data_state_text[new_state]
+	);
+
+	ctn730->app_data_state = new_state;
+	trace_ctn730_state_update(ctn730);
+}
+
+void ctn730_set_battery_level(struct ctn730 *ctn730, int new_level)
+{
+	lockdep_assert_held(&ctn730->lock);
+
+	ctn730->battery_level = new_level;
+	trace_ctn730_state_update(ctn730);
+
+	ctn730_supply_changed(ctn730);
+}
+
+static int ctn730_gpio_init(struct ctn730 *ctn730)
+{
+	struct device *dev = ctn730->dev;
+
+	ctn730->nfc_supply = devm_regulator_get_exclusive(dev, "nfc");
+
+	if (IS_ERR(ctn730->nfc_supply)) {
+		return dev_err_probe(dev, PTR_ERR(ctn730->nfc_supply),
+				     "Failed to get nfc-supply regulator\n");
+	}
+
+	return 0;
+}
+
+static int ctn730_set_power(struct ctn730 *ctn730, bool enable)
+{
+	int ret = 0;
+
+	lockdep_assert_held(&ctn730->req_lock);
+
+	dev_dbg(ctn730->dev, "set_power: %s\n", enable ? "true" : "false");
+
+	if (ctn730->init_bus_lock)
+		ctn730_i2c_lock_bus(ctn730);
+
+	if (enable && !regulator_is_enabled(ctn730->nfc_supply))
+		ret = regulator_enable(ctn730->nfc_supply);
+	else if (regulator_is_enabled(ctn730->nfc_supply))
+		ret = regulator_disable(ctn730->nfc_supply);
+	if (ret < 0)
+		dev_warn(ctn730->dev, "Failed to toggle nfc_supply: %d\n", ret);
+
+	if (ctn730->init_bus_lock) {
+		usleep_range(700, 800);
+		ctn730_i2c_unlock_bus(ctn730);
+	}
+
+	return ret;
+}
+
+static void ctn730_init(struct ctn730 *ctn730)
+{
+	mutex_init(&ctn730->lock);
+	mutex_init(&ctn730->req_lock);
+
+	mutex_lock(&ctn730->lock);
+
+	ctn730->state = state_unknown;
+	ctn730->charging_state = charging_state_unknown;
+	ctn730->device_state = device_state_unknown;
+	ctn730->boot_reason = boot_reason_unknown;
+	ctn730->app_data_state = app_data_state_unknown;
+	memset(ctn730->host_uid, 0, sizeof(ctn730->host_uid));
+	memset(ctn730->marker_uid, 0, sizeof(ctn730->marker_uid));
+	ctn730->fw_current_minor = 0;
+	ctn730->fw_current_major = 0;
+	ctn730->fw_provided_minor = 0;
+	ctn730->fw_provided_major = 0;
+	ctn730->fw_state = fw_state_unknown;
+	ctn730->battery_level = -1;
+
+	if (device_property_read_u32(ctn730->dev, "nxp,detect-interval",
+				     &ctn730->detect_interval_ms))
+		ctn730->detect_interval_ms = 128;
+
+	ctn730->init_bus_lock = fwnode_property_read_bool(ctn730->dev->fwnode,
+							  "nxp,init-bus-lock");
+
+	init_waitqueue_head(&ctn730->app_data_wait_queue);
+
+	mutex_unlock(&ctn730->lock);
+}
+
+static int ctn730_mdev_open(struct inode *inode, struct file *file)
+{
+	struct ctn730 *ctn730 = container_of((struct miscdevice *)file->private_data,
+					       struct ctn730, mdev);
+	file->private_data = ctn730;
+
+	return 0;
+}
+
+static int ctn730_mdev_release(struct inode *inode, struct file *file)
+{
+	file->private_data = NULL;
+	return 0;
+}
+
+static ssize_t ctn730_mdev_read(struct file *file, char __user *buf, size_t nbytes, loff_t *ppos)
+{
+	struct ctn730 *ctn730 = file->private_data;
+	int ret;
+	unsigned int copied;
+
+	if (ctn730->app_data_state != app_data_state_connected) {
+		dev_err(ctn730->dev, "%s: not in application data channel state", __func__);
+		return -EIO;
+	}
+
+	if (kfifo_is_empty(&ctn730->app_data_fifo)) {
+		if (file->f_flags & O_NONBLOCK)
+			return -EAGAIN;
+
+		wait_event_interruptible(ctn730->app_data_wait_queue,
+					 kfifo_len(&ctn730->app_data_fifo));
+	}
+
+	ret = kfifo_to_user(&ctn730->app_data_fifo, buf, nbytes, &copied);
+
+	return ret ? ret : copied;
+}
+
+static ssize_t ctn730_mdev_write(struct file *file, const char __user *buf, size_t len, loff_t *pos)
+{
+	struct ctn730 *ctn730 = file->private_data;
+	char data[APP_DATA_MSG_SIZE];
+	int ret;
+
+	if (ctn730->app_data_state != app_data_state_connected) {
+		dev_err(ctn730->dev, "%s: not in application data channel state", __func__);
+		return -EIO;
+	}
+
+	if (len > APP_DATA_MSG_SIZE) {
+		dev_err(ctn730->dev, "%s: data length exceeded, max %d", __func__,
+			APP_DATA_MSG_SIZE);
+		return -EINVAL;
+	}
+
+	ret = copy_from_user(data, buf, len);
+	if (ret > 0) {
+		dev_err(ctn730->dev, "%s: copy_from_user() failed", __func__);
+		return -EIO;
+	}
+
+	if (ctn730_i2c_send_app_data(ctn730, data, len)) {
+		dev_err(ctn730->dev, "%s: ctn730_i2c_send_app_data failed", __func__);
+		return -EIO;
+	}
+
+	return len;
+}
+
+static long ctn730_mdev_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
+{
+	struct ctn730 *ctn730 = file->private_data;
+	int __user *ip = (int __user *)arg;
+
+	switch (cmd) {
+	case CTN730_IOCTL_GET_STATE:
+		put_user(ctn730->state, ip);
+		break;
+	case CTN730_IOCTL_ENABLE_APP_DATA_CHANNEL:
+		put_user(ctn730_i2c_enable_app_data_channel(ctn730), ip);
+		break;
+	case CTN730_IOCTL_DISABLE_APP_DATA_CHANNEL:
+		put_user(ctn730_i2c_disable_app_data_channel(ctn730), ip);
+		break;
+	case TCGETS:
+		return -ENOIOCTLCMD;
+	default:
+		dev_info(ctn730->dev, "unknown IOCTL cmd: %d\n", cmd);
+		return -ENOIOCTLCMD;
+	}
+
+	return 0;
+}
+static struct file_operations ctn730_fops = {
+	.owner = THIS_MODULE,
+	.open = ctn730_mdev_open,
+	.read = ctn730_mdev_read,
+	.write = ctn730_mdev_write,
+	.release = ctn730_mdev_release,
+	.unlocked_ioctl = ctn730_mdev_ioctl,
+	.compat_ioctl = ctn730_mdev_ioctl,
+};
+
+static int ctn730_persistent_parameters_set(struct ctn730 *ctn730)
+{
+	u32 comm_power_step;
+	u32 num_power_step;
+	int ret;
+
+	lockdep_assert_held(&ctn730->req_lock);
+
+	ret = device_property_read_u32(ctn730->dev, "nfc-comm-power-step-index",
+				 &comm_power_step);
+	if (ret) {
+		dev_warn(ctn730->dev, "Could not find nfc-comm-power-step-index property\n");
+	} else {
+		dev_dbg(ctn730->dev, "nfc-comm-power-step-index %u\n", comm_power_step);
+		ret = ctn730_set_nfc_comm_power_step_param(ctn730, comm_power_step);
+		if (ret) {
+			dev_err(ctn730->dev, "Failed to set power step");
+			return ret;
+		}
+	}
+
+	ret = device_property_read_u32(ctn730->dev, "nfc-num-power-step-configs",
+				 &num_power_step);
+	if (ret) {
+		dev_dbg(ctn730->dev, "Could not find nfc-num-power-step-configs property\n");
+	} else {
+		dev_dbg(ctn730->dev, "nfc-num-power-step-configs %u\n", num_power_step);
+		ret = ctn730_set_nfc_num_power_step_configs_param(ctn730, num_power_step);
+		if (ret) {
+			dev_err(ctn730->dev, "Failed to set power step");
+			return ret;
+		}
+	}
+
+	return 0;
+}
+
+static int ctn730_try_boot(struct ctn730 *ctn730, bool sync_firmware, bool set_param)
+{
+	int ret;
+
+	lockdep_assert_held(&ctn730->req_lock);
+
+	set_bit(CTN730_BOOT_PENDING, &ctn730->flags);
+	if (ctn730_set_power(ctn730, true) < 0)
+		dev_info(ctn730->dev, "Failed to power on chip\n");
+
+	ctn730_i2c_shutdown(ctn730, false);
+
+	if (wait_on_bit_timeout(&ctn730->flags, CTN730_BOOT_PENDING,
+				TASK_INTERRUPTIBLE, msecs_to_jiffies(500))) {
+		dev_info(ctn730->dev, "Timed out waiting for boot.\n");
+		return -EIO;
+	}
+
+	if (sync_firmware) {
+		/* sync firmware while still in download mode */
+		if (ctn730_fw_sync(ctn730)) {
+			dev_err(ctn730->dev, "Firmware sync failed.\n");
+			/* we will still attempt to continue the usual boot process */
+		}
+	}
+
+	set_bit(CTN730_INIT_PENDING, &ctn730->flags);
+	ctn730_i2c_reset_to_mode(ctn730, NORMAL_MODE);
+
+	/* We need to wait for CTN730 to enter INITIALIZED state */
+	if (wait_on_bit_timeout(&ctn730->flags, CTN730_INIT_PENDING,
+				TASK_INTERRUPTIBLE, msecs_to_jiffies(500))) {
+		dev_info(ctn730->dev, "Timed out waiting for init.\n");
+		return -EIO;
+	}
+
+	if (set_param) {
+		ret = ctn730_persistent_parameters_set(ctn730);
+		if (ret < 0) {
+			dev_info(ctn730->dev, "Failed to set parameters: %d\n", ret);
+			return -EIO;
+		}
+
+		set_bit(CTN730_INIT_PENDING, &ctn730->flags);
+		ctn730_i2c_reset_to_mode(ctn730, NORMAL_MODE);
+
+		/* We need to wait for CTN730 to enter INITIALIZED state */
+		if (wait_on_bit_timeout(&ctn730->flags, CTN730_INIT_PENDING,
+					TASK_INTERRUPTIBLE, msecs_to_jiffies(500))) {
+			dev_info(ctn730->dev, "Timed out waiting for init.\n");
+			return -EIO;
+		}
+	}
+
+	ret = ctn730_enable_charging_info_event(ctn730, true);
+	if (ret != 0) {
+		dev_err(ctn730->dev, "Failed to set power step");
+		return ret;
+	}
+
+	return 0;
+}
+
+static void ctn730_down(struct ctn730 *ctn730)
+{
+	mutex_lock(&ctn730->req_lock);
+
+	ctn730_i2c_shutdown(ctn730, true);
+	if (ctn730_set_power(ctn730, false) < 0)
+		dev_warn(ctn730->dev, "Failed to power off chip\n");
+
+	mutex_unlock(&ctn730->req_lock);
+}
+
+static int ctn730_recover_boot(struct ctn730 *ctn730)
+{
+	int ret;
+	dev_info(ctn730->dev, "Recover device\n");
+
+	ctn730_down(ctn730);
+
+	mutex_lock(&ctn730->req_lock);
+	ret = ctn730_try_boot(ctn730, false, false);
+	mutex_unlock(&ctn730->req_lock);
+
+	if (ret < 0) {
+		dev_warn(ctn730->dev, "Failed to recover\n");
+		ctn730_down(ctn730);
+		set_bit(CTN730_RFKILLED, &ctn730->flags);
+		return -EIO;
+	}
+
+	dev_info(ctn730->dev, "Successfully recovered\n");
+	return 0;
+}
+
+static int ctn730_up(struct ctn730 *ctn730, bool sync_firmware, bool set_param)
+{
+	int ret;
+
+	mutex_lock(&ctn730->req_lock);
+
+	ret = ctn730_try_boot(ctn730, sync_firmware, set_param);
+	mutex_unlock(&ctn730->req_lock);
+	if (ret)
+		ret = ctn730_recover_boot(ctn730);
+
+	return ret;
+}
+
+static int ctn730_rfkill_set(void *data, bool blocked)
+{
+	struct ctn730 *ctn730 = data;
+	int ret;
+
+	if (blocked) {
+		if (test_and_set_bit(CTN730_RFKILLED, &ctn730->flags))
+			return 0;
+
+		dev_info(ctn730->dev, "rfkill block\n");
+		ctn730_down(ctn730);
+	} else {
+		if (!test_and_clear_bit(CTN730_RFKILLED, &ctn730->flags)) {
+			dev_dbg(ctn730->dev, "rfkill was already unblocked. No enabling required\n");
+			return 0;
+		}
+
+		dev_info(ctn730->dev, "rfkill unblock\n");
+		ret = ctn730_up(ctn730, false, false);
+		if (ret < 0)
+			return -EIO;
+
+		/* Return to default state */
+		ctn730_i2c_detection(ctn730, ctn730->detect_interval_ms, true);
+	}
+
+	return 0;
+}
+
+static const struct rfkill_ops ctn730_rfkill_ops = {
+	.set_block = ctn730_rfkill_set,
+};
+
+static int ctn730_rfkill_init(struct ctn730 *ctn730)
+{
+	struct rfkill *rfkill;
+	int err;
+
+	rfkill = rfkill_alloc("ctn730", ctn730->dev, RFKILL_TYPE_NFC,
+			      &ctn730_rfkill_ops, ctn730);
+	if (!rfkill)
+		return -ENOMEM;
+
+	/* For enabling correct initial state for the docking
+	 * we need to either shutdown the IC or enable detection
+	 */
+	if (rfkill_blocked(rfkill)) {
+		ctn730_down(ctn730);
+	} else {
+		ctn730_i2c_detection(ctn730, ctn730->detect_interval_ms, true);
+	}
+
+	err = rfkill_register(rfkill);
+	if (err) {
+		rfkill_destroy(rfkill);
+		return err;
+	}
+
+	ctn730->rfkill = rfkill;
+
+	return 0;
+}
+
+static void ctn730_rfkill_deinit(struct ctn730 *ctn730)
+{
+	struct rfkill *rfkill = ctn730->rfkill;
+
+	if (!rfkill)
+		return;
+
+	rfkill_unregister(rfkill);
+	rfkill_destroy(rfkill);
+	ctn730->rfkill = NULL;
+}
+
+static int ctn730_probe(struct i2c_client *client)
+{
+	int ret;
+	struct ctn730 *ctn730;
+	struct device *dev = &client->dev;
+
+	dev_info(dev, "loading ctn730_rm\n");
+
+	ctn730 = devm_kzalloc(dev, sizeof(*ctn730), GFP_KERNEL);
+	if (ctn730 == NULL)
+		return -ENOMEM;
+
+	ctn730->client = client;
+	ctn730->dev = dev;
+	i2c_set_clientdata(client, ctn730);
+
+	ctn730_init(ctn730);
+
+	ret = ctn730_supply_init(ctn730);
+	if (ret < 0)
+		goto err_0;
+
+	ret = kfifo_alloc(&ctn730->app_data_fifo, MSG_SIZE * NUM_MSGS_RECV_BUFFER, GFP_KERNEL);
+	if (ret < 0) {
+		dev_err(ctn730->dev, "failed to allocate app_data_fifo\n");
+		goto err_0;
+	}
+
+	ret = ctn730_gpio_init(ctn730);
+	if (ret != 0)
+		goto err_0;
+
+	ret = ctn730_i2c_init(ctn730);
+	if (ret != 0)
+		goto err_0;
+
+	ret = ctn730_up(ctn730, true, true);
+	if (ret < 0)
+		goto err_1;
+
+	ret = ctn730_sysfs_nodes_init(ctn730);
+	if (ret < 0)
+		goto err_1;
+
+	ctn730->mdev.minor = MISC_DYNAMIC_MINOR;
+	ctn730->mdev.name = "ctn730";
+	ctn730->mdev.fops = &ctn730_fops;
+	ctn730->mdev.parent = dev;
+	if (misc_register(&ctn730->mdev) < 0) {
+		dev_err(dev, "failed to create miscdevice");
+		goto err_2;
+	}
+
+	ret = ctn730_rfkill_init(ctn730);
+	if (ret)
+		goto err_3;
+
+	return 0;
+
+err_3:
+	misc_deregister(&ctn730->mdev);
+
+err_2:
+	ctn730_sysfs_nodes_deinit(ctn730);
+
+err_1:
+	ctn730_i2c_deinit(ctn730);
+	kfifo_free(&ctn730->app_data_fifo);
+
+err_0:
+	return ret;
+}
+
+static void ctn730_remove(struct i2c_client *client)
+{
+	struct ctn730 *ctn730 = i2c_get_clientdata(client);
+
+	dev_info(ctn730->dev, "removing ctn730_rm\n");
+
+	ctn730_down(ctn730);
+
+	ctn730_rfkill_deinit(ctn730);
+	misc_deregister(&ctn730->mdev);
+	ctn730_sysfs_nodes_deinit(ctn730);
+	ctn730_i2c_deinit(ctn730);
+}
+
+static int ctn730_suspend(struct device *dev)
+{
+	struct ctn730 *ctn730 = dev_get_drvdata(dev);
+	struct ctn730_i2c *ctn730_i2c = ctn730->ctn730_i2c;
+
+	if (!test_bit(CTN730_RFKILLED, &ctn730->flags)) {
+		/*
+		 * Disable charging info events while the IRQ is still enabled,
+		 * because the command needs the IRQ handler for its response.
+		 */
+		mutex_lock(&ctn730->req_lock);
+		ctn730_enable_charging_info_event(ctn730, false);
+		mutex_unlock(&ctn730->req_lock);
+
+		/*
+		 * Drain current work with the IRQ enabled, then disable the IRQ
+		 * and drain again to catch work queued by a last IRQ handler.
+		 */
+		cancel_delayed_work_sync(&ctn730_i2c->read_battery_delayed_work);
+		disable_irq(ctn730->client->irq);
+		cancel_delayed_work_sync(&ctn730_i2c->read_battery_delayed_work);
+	}
+	return 0;
+}
+
+static int ctn730_resume(struct device *dev)
+{
+	struct ctn730 *ctn730 = dev_get_drvdata(dev);
+
+	if (!test_bit(CTN730_RFKILLED, &ctn730->flags)) {
+		enable_irq(ctn730->client->irq);
+		mutex_lock(&ctn730->req_lock);
+		ctn730_enable_charging_info_event(ctn730, true);
+		mutex_unlock(&ctn730->req_lock);
+	}
+	return 0;
+}
+
+static int ctn730_freeze(struct device *dev)
+{
+	struct ctn730 *ctn730 = dev_get_drvdata(dev);
+
+	/*
+	 * If the interface is not rfkilled, bring
+	 * the nfc interface down in a controlled fashion.
+	 * Some devices have logic to power-gate NFC_PWR_EN
+	 * tied to PMIC_ON_REQ.
+	 */
+	if (!test_bit(CTN730_RFKILLED, &ctn730->flags)) {
+		ctn730_down(ctn730);
+	}
+
+	return 0;
+}
+
+static int ctn730_thaw(struct device *dev)
+{
+	struct ctn730 *ctn730 = dev_get_drvdata(dev);
+	int ret;
+	/*
+	 * In the case of hibernation failure we need to bring the
+	 * interface back up if it was not rfkilled before
+	 * hibernation attempt.
+	 */
+	if (dev->power.power_state.event == PM_EVENT_RECOVER) {
+		if (!test_bit(CTN730_RFKILLED, &ctn730->flags)) {
+			ret = ctn730_up(ctn730, false, false);
+			if (ret < 0)
+				return -EIO;
+
+			ctn730_i2c_detection(ctn730, ctn730->detect_interval_ms, true);
+		}
+	}
+	return 0;
+}
+
+static int ctn730_restore(struct device *dev)
+{
+	struct ctn730 *ctn730 = dev_get_drvdata(dev);
+	int ret;
+
+	/*
+	 * Nothing needs to be done if system hibernated with ctn730 being
+	 * rfkilled. Otherwise, we need to power up ctn730 to match rfkill
+	 * state.
+	 */
+	if (test_bit(CTN730_RFKILLED, &ctn730->flags)) {
+		dev_dbg(dev, "ctn730 is rfkilled, no need to restore\n");
+		return 0;
+	}
+
+	ret = ctn730_up(ctn730, false, false);
+	if (ret < 0)
+		return -EIO;
+
+	ctn730_i2c_detection(ctn730, ctn730->detect_interval_ms, true);
+
+	return 0;
+}
+
+static const struct dev_pm_ops ctn730_pm_ops = {
+	.suspend = ctn730_suspend,
+	.resume = ctn730_resume,
+	.freeze = ctn730_freeze,
+	.thaw = ctn730_thaw,
+	.restore = ctn730_restore,
+};
+
+static const struct of_device_id rm_ctn730_dt_ids[] = {
+	{
+		.compatible = "nxp,ctn730-rm",
+	},
+	{},
+};
+MODULE_DEVICE_TABLE(of, rm_ctn730_dt_ids);
+
+static struct i2c_driver rm_ctn730_driver = {
+	.driver = {
+		.name = "nxp,ctn730-rm",
+		.owner = THIS_MODULE,
+		.pm = &ctn730_pm_ops,
+		.of_match_table = rm_ctn730_dt_ids,
+	},
+	.probe = ctn730_probe,
+	.remove	= ctn730_remove,
+};
+module_i2c_driver(rm_ctn730_driver);
+
+MODULE_DESCRIPTION("Low-level driver for NXP CTN730");
+MODULE_AUTHOR("reMarkable");
+MODULE_LICENSE("GPL");
