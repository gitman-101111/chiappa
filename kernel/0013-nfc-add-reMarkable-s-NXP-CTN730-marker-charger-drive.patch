+int ctn730_i2c_get_host_power_step(struct ctn730 *ctn730, int *step)
+{
+	struct ctn730_msg msg;
+	int ret;
+
+	dev_dbg(ctn730->dev, "sending WLC_HOST_CTRL_DUMP_STATUS_CMD, HOST_POWER_STEP\n");
+
+	msg.header.msg_type = MSG_TYPE_CMD;
+	msg.header.instr = WLC_HOST_CTRL_DUMP_STATUS;
+	msg.header.len = 1;
+	msg.payload[0] = HOST_POWER_STEP;
+
+	ret = ctn730_i2c_send_wait_rsp(ctn730, &msg);
+	if (ret < 0) {
+		*step = -1;
+		return ret;
+	}
+
+	*step = msg.payload[3];
+
+	return 0;
+}
