diff --git a/drivers/nfc/ctn730_rm/ctn730_i2c.c b/drivers/nfc/ctn730_rm/ctn730_i2c.c
new file mode 100644
index 000000000..aa97954e2
--- /dev/null
+++ b/drivers/nfc/ctn730_rm/ctn730_i2c.c
@@ -0,0 +1,1326 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * reMarkable NXP CTN730
+ *
+ * Copyright (C) 2023 reMarkable AS - http://www.remarkable.com/
+ */
+
+#include <linux/delay.h>
+#include <linux/lockdep.h>
+#include <linux/wait.h>
+#include "ctn730_i2c.h"
+#include "ctn730_supply.h"
+
+#include <trace/events/ctn730_rm.h>
+
+
+const char *ctn730_state_text[] = {
+	"INITIALIZED",
+	"DEVICE_DETECTION",
+	"DEVICE_DETECTED",
+	"CHARGING_DATA_CHANNEL_ESTABLISHED",
+	"APP_DATA_CHANNEL_ESTABLISHED",
+	"DEVICE_PAUSED",
+	"DOWNLOAD_MODE",
+	"SHUTDOWN",
+	"UNKNOWN"
+};
+
+const char *ctn730_charging_state_text[] = {
+	"CHARGING_STARTED", "CHARGING_ENDED", "CHARGING_STOPPED", "UNKNOWN"
+};
+
+const char *ctn730_device_state_text[] = {
+	"DEVICE_DETECTED", "DEVICE_DEACTIVATED", "DEVICE_LOST", "DEVICE_VERSION_MISMATCH",
+	"DEVICE_DOCKED",   "DEVICE_UNDOCKED",	 "FO_PRESENT",	"BATTERY_FULL",
+	"CHARGE_FAILURE",  "NDEF_MODE",		 "LISTENER_OT", "UNKNOWN"
+};
+
+const char *ctn730_boot_reason_text[] = {
+	"INTENDED", "FIRMWARE_CORRUPTED", "UNRECOVERABLE_ERROR", "UNKNOWN"
+};
+
+const char *ctn730_charging_disable_reason_text[] = {
+	"HOST_CONTROLLER_REQUEST", "OVERTEMPERATURE", "CHANNEL_SYNC_ERROR", "UNKNOWN"
+};
+
+enum resume_reason {
+	resume_reason_host_controller_request = 0,
+	resume_reason_device_lost,
+	resume_reason_channel_sync_error,
+	resume_reason_unknown,
+};
+
+static const char * const resume_reason_text[] = {
+	"HOST_CONTROLLER_REQUEST", "DEVICE_LOST", "CHANNEL_SYNC_ERROR", "UNKNOWN"
+};
+
+const char *ctn730_app_data_state_text[] = {
+	"CONNECTED", "DISCONNECTED", "ACTIVATION_FAILED", "UNKNOWN"
+};
+
+static int ctn730_i2c_send(struct ctn730 *ctn730, u8 *buf, int count)
+{
+	int ret;
+	struct i2c_client *client = ctn730->client;
+	struct device *dev = ctn730->dev;
+	int retries = 0;
+
+	lockdep_assert_held(&ctn730->req_lock);
+
+	print_hex_dump_debug("ctn730_rm: sending raw data:",
+			     DUMP_PREFIX_NONE, count, 1,
+			     buf, count, false);
+	dev_dbg(ctn730->dev, "Sending while in state: %s / %s\n",
+		ctn730_state_text[ctn730->state],
+		ctn730_charging_state_text[ctn730->charging_state]);
+
+	if (ctn730->state == state_shutdown)
+		return -ERFKILL;
+
+retry:
+	ret = i2c_master_send(client, buf, count);
+	if (ret < 0) {
+		/*
+		 * Repeat sending command in case WLC-Host is in standby sleep.
+		 * It will wake up on device address.
+		 */
+		usleep_range(10500, 11500);
+		dev_dbg(dev, "transmit error: %d, retrying sending\n", ret);
+		retries++;
+		if (retries <= 3)
+			goto retry;
+	}
+
+	dev_dbg(dev, "retries: %d\n", retries);
+
+	if (ret < 0) {
+		dev_err(dev, "failed sending (%d)\n", ret);
+		return ret;
+	}
+
+	dev_dbg(dev, "sent bytes: %d\n", ret);
+
+	if (ret < count)
+		dev_err(dev, "tried sending %d bytes, sent %d\n", ret, count);
+
+	return ret;
+}
+
+static int ctn730_i2c_send_wait_rsp_no_status_check_locked(struct ctn730 *ctn730,
+							   struct ctn730_msg *msg,
+							   unsigned long timeout)
+{
+	struct ctn730_i2c *ctn730_i2c = ctn730->ctn730_i2c;
+	int ret;
+
+	lockdep_assert_held(&ctn730->req_lock);
+	/* global lock should not be held as IRQ handler may take that one */
+	lockdep_assert_not_held(&ctn730->lock);
+
+	trace_ctn730_send_msg_start(ctn730, msg);
+
+	set_bit(CTN730_RSP_WAIT, &ctn730->flags);
+
+	ret = ctn730_i2c_send(ctn730, (u8 *)msg, sizeof(msg->header) + msg->header.len);
+	if (ret < 0)
+		goto done;
+
+	if (wait_on_bit_timeout(&ctn730->flags, CTN730_RSP_WAIT,
+				TASK_INTERRUPTIBLE, timeout)) {
+		dev_err(ctn730->dev, "no response to cmd %02x", msg->header.instr);
+		ret = -EIO;
+		goto done;
+	}
+
+	/* copy shared rsp buffer to caller's msg */
+	memcpy(msg, &ctn730_i2c->response_msg, sizeof(struct ctn730_msg));
+
+done:
+	trace_ctn730_send_msg_end(ctn730, msg);
+	clear_bit(CTN730_RSP_WAIT, &ctn730->flags);
+
+	return ret;
+}
+
+static int ctn730_i2c_send_wait_rsp_no_status_check(struct ctn730 *ctn730,
+						    struct ctn730_msg *msg,
+						    unsigned long timeout)
+{
+	int ret;
+
+	mutex_lock(&ctn730->req_lock);
+	ret = ctn730_i2c_send_wait_rsp_no_status_check_locked(ctn730, msg, timeout);
+	mutex_unlock(&ctn730->req_lock);
+
+	return ret;
+}
+
+static int ctn730_i2c_send_wait_rsp_timeout_locked(struct ctn730 *ctn730,
+						   struct ctn730_msg *msg,
+						   unsigned long timeout)
+{
+	int err;
+
+	lockdep_assert_held(&ctn730->req_lock);
+
+	err = ctn730_i2c_send_wait_rsp_no_status_check_locked(ctn730, msg, timeout);
+	if (err)
+		return err;
+
+	if (msg->status != STATUS_OK) {
+		dev_err(ctn730->dev, "msg status error: %02x\n", msg->status);
+		return -EIO;
+	}
+
+	return 0;
+}
+
+static int ctn730_i2c_send_wait_rsp_timeout(struct ctn730 *ctn730,
+					    struct ctn730_msg *msg,
+					    unsigned long timeout)
+{
+	int err;
+
+	err = ctn730_i2c_send_wait_rsp_no_status_check(ctn730, msg, timeout);
+	if (err)
+		return err;
+
+	if (msg->status != STATUS_OK) {
+		dev_err(ctn730->dev, "msg status error: %02x\n", msg->status);
+		return -EIO;
+	}
+
+	return 0;
+}
+
+static int ctn730_i2c_send_wait_rsp(struct ctn730 *ctn730, struct ctn730_msg *msg)
+{
+	return ctn730_i2c_send_wait_rsp_timeout(ctn730, msg, MSG_DEFAULT_TIMEOUT);
+}
+
+static int ctn730_i2c_handle_response(struct ctn730 *ctn730, struct ctn730_msg *msg)
+{
+	struct device *dev = ctn730->dev;
+	struct ctn730_i2c *ctn730_i2c = ctn730->ctn730_i2c;
+
+	switch (msg->header.instr) {
+	case WLC_HOST_CTRL_RESET:
+		dev_dbg(dev, "WLC_HOST_CTRL_RESET_RSP\n");
+		break;
+	case WLC_HOST_CTRL_DL_WRITE_FLASH:
+		dev_dbg(dev, "WLC_HOST_CTRL_DL_WRITE_FLASH_RSP\n");
+		break;
+	case WLC_HOST_CTRL_DL_OPEN_SESSION:
+		dev_dbg(dev, "WLC_HOST_CTRL_DL_OPEN_SESSION_RSP\n");
+		break;
+	case WLC_HOST_CTRL_DL_COMMIT_SESSION:
+		dev_dbg(dev, "WLC_HOST_CTRL_DL_COMMIT_SESSION_RSP\n");
+		break;
+	case WLC_HOST_CTRL_DL_READ_UID:
+		dev_dbg(dev, "WLC_HOST_CTRL_DL_READ_UID_RSP\n");
+		break;
+	case WLC_HOST_CTRL_READ_PARAMETER:
+		dev_dbg(dev, "WLC_HOST_CTRL_READ_PARAMETER_RSP\n");
+		break;
+	case WLC_HOST_CTRL_READ_SESSION_PARAMETER:
+		dev_dbg(dev, "WLC_HOST_CTRL_READ_SESSION_PARAMETER_RSP\n");
+		break;
+	case WLC_HOST_CTRL_WRITE_PARAMETER:
+		dev_dbg(dev, "WLC_HOST_CTRL_WRITE_PARAMETER_RSP\n");
+		break;
+	case WLC_HOST_CTRL_WRITE_SESSION_PARAMETER:
+		dev_dbg(dev, "WLC_HOST_CTRL_WRITE_SESSION_PARAMETER_RSP\n");
+		break;
+	case WLC_HOST_CTRL_DUMP_STATUS:
+		dev_dbg(dev, "WLC_HOST_CTRL_DUMP_STATUS_RSP\n");
+		break;
+	case WLC_CHG_CTRL_ENABLE:
+		dev_dbg(dev, "WLC_CHG_CTRL_ENABLE_RSP\n");
+		break;
+	case WLC_CHG_CTRL_DISABLE:
+		dev_dbg(dev, "WLC_CHG_CTRL_DISABLE_RSP\n");
+		break;
+	case WLC_APP_CTRL_CHANNEL_ENABLE:
+		dev_dbg(dev, "WLC_APP_CTRL_CHANNEL_ENABLE_RSP\n");
+		break;
+	case WLC_APP_CTRL_CHANNEL_DISABLE:
+		dev_dbg(dev, "WLC_APP_CTRL_CHANNEL_DISABLE_RSP\n");
+		break;
+	case WLC_CHG_CTRL_PAUSE_DEVICE:
+		dev_dbg(dev, "WLC_CHG_CTRL_PAUSE_DEVICE_RSP\n");
+		break;
+	case WLC_CHG_CTRL_RESUME_DEVICE:
+		dev_dbg(dev, "WLC_CHG_CTRL_RESUME_DEVICE_RSP\n");
+		break;
+	case WLC_APP_CTRL_SEND_DATA:
+		dev_dbg(dev, "WLC_APP_CTRL_SEND_DATA_RSP\n");
+		break;
+	case WLC_HOST_CTRL_BIST:
+		dev_dbg(dev, "WLC_HOST_CTRL_BIST_RSP\n");
+		break;
+
+	default:
+		dev_err(dev, "illegal response (0x%02x)\n", msg->header.instr);
+		return -EIO;
+	}
+
+	memcpy(&ctn730_i2c->response_msg, msg, HEADER_SIZE + msg->header.len);
+
+	if (!test_and_clear_bit(CTN730_RSP_WAIT, &ctn730->flags))
+		dev_warn(dev, "Unexpected response\n"); /* unlikely */
+
+	wake_up_bit(&ctn730->flags, CTN730_RSP_WAIT);
+
+	return 0;
+}
+
+static void read_battery_delayed_func(struct work_struct *work)
+{
+	struct ctn730_i2c *ctn730_i2c = container_of(to_delayed_work(work),
+					struct ctn730_i2c, read_battery_delayed_work);
+	struct ctn730 *ctn730 = ctn730_i2c->ctn730;
+	struct device *dev = ctn730->dev;
+	unsigned int delay_to_next_attempt;
+	int ret;
+
+	/* we powered off before getting here */
+	if (READ_ONCE(ctn730->state) == state_shutdown)
+		return;
+
+	ret = ctn730_i2c_get_battery_level(ctn730);
+	if (ret != 0) {
+		dev_warn(dev, "Sending battery level request failed after connect: %d...\n", ret);
+		return;
+	}
+
+	mutex_lock(&ctn730->lock);
+	if (ctn730->battery_level == -1 &&
+		   ctn730_i2c->unsuccessful_battery_reads_on_dock < 10) {
+		dev_dbg(dev, "Battery level unavailable after connect... Attempts: %d\n",
+			ctn730_i2c->unsuccessful_battery_reads_on_dock);
+
+		/*
+		 * Scale the delay based on the retries that failed so far.
+		 * This leads to next attempts after 100, 200, 400, 800, 1000, 1000, ... ms
+		 */
+		delay_to_next_attempt = min_t(unsigned int, 1000,
+					      100 << ctn730_i2c->unsuccessful_battery_reads_on_dock);
+
+		++ctn730_i2c->unsuccessful_battery_reads_on_dock;
+		schedule_delayed_work(&ctn730_i2c->read_battery_delayed_work,
+						msecs_to_jiffies(delay_to_next_attempt));
+		goto out;
+	}
+
+	/* we either got a battery level or we give up */
+
+	if (ctn730->battery_level == -1)
+		dev_warn(dev, "Failed to poll battery level after dock. Giving up...\n");
+
+	/*
+	 * We want to notify userspace when we dock a marker with
+	 * full battery. Otherwise userspace has to poll the sysfs node until
+	 * battery can be read.
+	 */
+	if (ctn730->battery_level == 100) {
+		ctn730_set_device_state(ctn730, device_state_battery_full);
+	}
+
+out:
+	mutex_unlock(&ctn730->lock);
+}
+
+static int ctn730_i2c_handle_evt(struct ctn730 *ctn730, struct ctn730_msg *msg)
+{
+	struct device *dev = ctn730->dev;
+	struct ctn730_i2c *ctn730_i2c = ctn730->ctn730_i2c;
+	int size, ret, count;
+
+	mutex_lock(&ctn730->lock);
+
+	trace_ctn730_event(ctn730, msg);
+
+	switch (msg->header.instr) {
+	case WLC_HOST_CTRL_GENERIC_ERROR:
+		dev_err(dev, "WLC_HOST_CTRL_GENERIC_ERROR_EVT %d\n", msg->payload[0]);
+		break;
+	case WLC_HOST_CTRL_RESET:
+		dev_dbg(dev, "WLC_HOST_CTRL_RESET_EVT\n");
+
+		if (msg->payload[0] == NORMAL_MODE) {
+			ctn730_set_state(ctn730, state_initialized);
+			ctn730->fw_current_major = msg->payload[1];
+			ctn730->fw_current_minor = msg->payload[2];
+
+			dev_dbg(dev, "NORMAL_MODE FW=%02x.%02x\n", ctn730->fw_current_major,
+				ctn730->fw_current_minor);
+
+			clear_bit(CTN730_RST_DONE, &ctn730->flags);
+			clear_bit(CTN730_INIT_PENDING, &ctn730->flags);
+			wake_up_bit(&ctn730->flags, CTN730_INIT_PENDING);
+			wake_up_bit(&ctn730->flags, CTN730_RST_DONE);
+		} else if (msg->payload[0] == DOWNLOAD_MODE) {
+			ctn730_set_state(ctn730, state_download_mode);
+			ctn730->boot_reason = msg->payload[1];
+			if (ctn730->boot_reason >= boot_reason_unknown)
+				dev_dbg(dev, "DOWNLOAD_MODE boot reason: %s\n",
+					ctn730_boot_reason_text[boot_reason_unknown]);
+			else
+				dev_dbg(dev, "DOWNLOAD_MODE boot reason: %s\n",
+					ctn730_boot_reason_text[ctn730->boot_reason]);
+
+			clear_bit(CTN730_RST_DONE, &ctn730->flags);
+			clear_bit(CTN730_BOOT_PENDING, &ctn730->flags);
+			wake_up_bit(&ctn730->flags, CTN730_BOOT_PENDING);
+			wake_up_bit(&ctn730->flags, CTN730_RST_DONE);
+		} else {
+			dev_warn(dev, "Reset in unknown mode: 0x%02x\n", msg->payload[0]);
+		}
+
+		break;
+	case WLC_CHG_CTRL_DEVICE_STATE:
+		dev_dbg(dev, "WLC_CHG_CTRL_DEVICE_STATE_EVT: %d\n", msg->event);
+
+		switch (msg->event) {
+		case DEVICE_DETECTED:
+			size = sizeof(ctn730->marker_uid);
+			memcpy(ctn730->marker_uid, &msg->payload[1], size);
+			print_hex_dump_debug("Marker UID:", DUMP_PREFIX_NONE, size, 1,
+					     &ctn730->marker_uid, size, false);
+			ctn730_set_device_state(ctn730, device_state_device_detected);
+			ctn730_set_state(ctn730, state_device_detected);
+
+			ctn730_i2c->unsuccessful_battery_reads_on_dock = 0;
+			schedule_delayed_work(&ctn730_i2c->read_battery_delayed_work,
+						msecs_to_jiffies(150));
+			break;
+		case DEVICE_DEACTIVATED:
+			memset(ctn730->marker_uid, 0, sizeof(ctn730->marker_uid));
+			ctn730_set_device_state(ctn730, device_state_device_deactivated);
+			ctn730_set_state(ctn730, state_device_detection);
+			break;
+		case DEVICE_LOST:
+			memset(ctn730->marker_uid, 0, sizeof(ctn730->marker_uid));
+			ctn730_set_device_state(ctn730, device_state_device_lost);
+			ctn730_set_state(ctn730, state_device_detection);
+			break;
+		case DEVICE_VERSION_MISMATCH:
+			ctn730_set_device_state(ctn730, device_state_device_version_mismatch);
+			break;
+		case DEVICE_DOCKED:
+			ctn730_set_device_state(ctn730, device_state_device_docked);
+			break;
+		case DEVICE_UNDOCKED:
+			ctn730_set_device_state(ctn730, device_state_device_undocked);
+			break;
+		case FO_PRESENT:
+			ctn730_set_device_state(ctn730, device_state_fo_present);
+			break;
+		case BATTERY_FULL:
+			ctn730_set_device_state(ctn730, device_state_battery_full);
+			break;
+		case CHARGE_FAILURE:
+			ctn730_set_device_state(ctn730, device_state_charge_failure);
+			break;
+		case NDEF_MODE:
+			ctn730_set_device_state(ctn730, device_state_ndef_mode);
+			break;
+		case LISTENER_OT:
+			ctn730_set_device_state(ctn730, device_state_listener_ot);
+			break;
+		default:
+			ctn730_set_device_state(ctn730, device_state_unknown);
+			break;
+		}
+		break;
+	case WLC_CHG_CTRL_CHARGING_STATE:
+		dev_dbg(dev, "WLC_CHG_CTRL_CHARGING_STATE_EVT\n");
+
+		if (msg->event >= charging_state_unknown) {
+			ctn730_set_charging_state(ctn730, charging_state_unknown);
+		} else {
+			ctn730_set_charging_state(ctn730,  msg->event);
+		}
+
+		if (ctn730->charging_state == charging_state_charging_stopped)
+			ctn730_set_state(ctn730, state_device_detected);
+
+		if (ctn730->charging_state == charging_state_charging_started)
+			ctn730_set_state(ctn730, state_charging_data_channel_established);
+
+		break;
+	case WLC_CHG_CTRL_DISABLE:
+		ctn730_set_state(ctn730, state_initialized);
+
+		switch (msg->reason) {
+		case HOST_CONTROLLER_REQUEST:
+			dev_dbg(dev, "WLC_CHG_CTRL_DISABLE_EVT, reason: HOST_CONTROLLER_REQUEST\n");
+			break;
+		case OVERTEMPERATURE:
+			dev_info(dev, "WLC_CHG_CTRL_DISABLE_EVT, reason: OVERTEMPERATURE\n");
+			break;
+		case CHANNEL_SYNC_ERROR:
+			dev_info(dev, "WLC_CHG_CTRL_DISABLE_EVT, reason: CHANNEL_SYNC_ERROR\n");
+			break;
+		default:
+			dev_warn(dev, "WLC_CHG_CTRL_DISABLE, unknown reason\n");
+		}
+
+
+		break;
+	case WLC_CHG_CTRL_CHARGING_INFO:
+		dev_dbg(dev, "WLC_CHG_CTRL_CHARGING_INFO_EVT\n");
+
+		ctn730_set_battery_level(ctn730, msg->payload[0]);
+
+		break;
+	case WLC_CHG_CTRL_PAUSE_DEVICE:
+		dev_dbg(dev, "WLC_CHG_CTRL_PAUSE_DEVICE_EVT\n");
+
+		ctn730_set_state(ctn730, state_device_paused);
+		break;
+	case WLC_CHG_CTRL_RESUME_DEVICE:
+		dev_dbg(dev, "WLC_CHG_CTRL_RESUME_DEVICE_EVT\n");
+
+		ctn730_set_state(ctn730, state_device_detected);
+		if (msg->reason >= resume_reason_unknown)
+			dev_dbg(dev, "resume reason: %s\n",
+				resume_reason_text[resume_reason_unknown]);
+		else
+			dev_dbg(dev, "resume reason: %s\n", resume_reason_text[msg->reason]);
+		break;
+	case WLC_CHG_CTRL_OPTIONAL_NDEF:
+		dev_dbg(dev, "WLC_CHG_CTRL_OPTIONAL_NDEF_EVT\n");
+		break;
+	case WLC_APP_CTRL_CHANNEL_STATE:
+		dev_dbg(dev, "WLC_APP_CTRL_CHANNEL_STATE_EVT\n");
+
+		ctn730_set_app_data_state(ctn730, min_t(u8, msg->reason, app_data_state_unknown));
+
+		if (ctn730->app_data_state == app_data_state_disconnected) {
+			ctn730_set_state(ctn730, state_device_detected);
+		}
+		if (ctn730->app_data_state == app_data_state_connected) {
+			ctn730_set_state(ctn730, state_app_data_channel_established);
+		}
+
+		clear_bit(CTN730_APP_DATA_STATE_CHANGE, &ctn730->flags);
+		wake_up_bit(&ctn730->flags, CTN730_APP_DATA_STATE_CHANGE);
+		break;
+	case WLC_APP_CTRL_SEND_DATA:
+		dev_dbg(dev, "WLC_APP_CTRL_SEND_DATA_EVT\n");
+		clear_bit(CTN730_APP_DATA_SENT, &ctn730->flags);
+		wake_up_bit(&ctn730->flags, CTN730_APP_DATA_SENT);
+		break;
+	case WLC_APP_CTRL_RECEIVE_DATA:
+		dev_dbg(dev, "WLC_APP_CTRL_RECEIVE_DATA_EVT\n");
+
+		/* Skip the first byte as this is a flag to tell if it is a chained packet */
+		count = msg->header.len - 1;
+
+		if (kfifo_avail(&ctn730->app_data_fifo) < count) {
+			dev_err(dev, "not enough space in fifo\n");
+			break;
+		}
+
+		ret = kfifo_in(&ctn730->app_data_fifo, &msg->payload[1], count);
+
+		if (ret < count)
+			dev_err(dev, "failed inserting into fifo\n");
+
+		wake_up(&ctn730->app_data_wait_queue);
+		break;
+	default:
+		dev_err(dev, "unknown event (0x%02x)\n", msg->header.instr);
+		break;
+	}
+
+	mutex_unlock(&ctn730->lock);
+	return 0;
+}
+
+static irqreturn_t ctn730_i2c_irq(int irq, void *data)
+{
+	struct ctn730 *ctn730 = data;
+	struct device *dev = ctn730->dev;
+	int ret;
+	struct ctn730_msg msg;
+
+	/* first we receive the header to get the payload length */
+	ret = i2c_master_recv(ctn730->client, (char *)&msg.header, HEADER_SIZE);
+
+	if (ret < 0) {
+		dev_dbg(dev, "reading i2c failed: %d\n", ret);
+		return IRQ_HANDLED;
+	}
+	if (ret != HEADER_SIZE) {
+		dev_err(dev, "header has unexpected len: %d\n", ret);
+		return IRQ_HANDLED;
+	}
+
+	if (msg.header.len > 0) {
+		ret = i2c_master_recv(ctn730->client, (char *)&msg.payload, msg.header.len);
+
+		if (ret < 0) {
+			dev_err(dev, "recv failed: %d\n", ret);
+			goto exit;
+		}
+
+		if (ret < msg.header.len) {
+			dev_err(dev, "wanted %ld bytes, got %d\n", HEADER_SIZE, ret);
+			goto exit;
+		}
+	}
+
+	switch (msg.header.msg_type) {
+	case MSG_TYPE_RSP:
+		dev_dbg(dev, "msg_type RSP\n");
+		ret = ctn730_i2c_handle_response(ctn730, &msg);
+		break;
+
+	case MSG_TYPE_EVT:
+		dev_dbg(dev, "msg_type EVT\n");
+		ret = ctn730_i2c_handle_evt(ctn730, &msg);
+		break;
+	default:
+		dev_err(dev, "invalid message type");
+	}
+
+exit:
+	return IRQ_HANDLED;
+}
+
+int ctn730_i2c_init(struct ctn730 *ctn730)
+{
+	struct i2c_client *client = ctn730->client;
+	struct device *dev = ctn730->dev;
+	struct ctn730_i2c *ctn730_i2c;
+	int ret;
+
+	ctn730_i2c = devm_kzalloc(dev, sizeof(struct ctn730_i2c), GFP_KERNEL);
+	if (ctn730_i2c == NULL)
+		return -ENOMEM;
+
+	ctn730->ctn730_i2c = ctn730_i2c;
+	ctn730_i2c->ctn730 = ctn730;
+
+	ret = devm_request_threaded_irq(dev, client->irq, NULL, ctn730_i2c_irq,
+					IRQF_ONESHOT, "ctn730_rm", ctn730);
+	if (ret < 0) {
+		dev_err(dev, "Unable to register IRQ handler\n");
+		return ret;
+	}
+
+	disable_irq(client->irq);
+
+	INIT_DELAYED_WORK(&ctn730_i2c->read_battery_delayed_work, read_battery_delayed_func);
+
+	return 0;
+}
+
+void ctn730_i2c_shutdown(struct ctn730 *ctn730, bool shutdown)
+{
+	struct ctn730_i2c *ctn730_i2c = ctn730->ctn730_i2c;
+
+	lockdep_assert_held(&ctn730->req_lock);
+
+	/*
+	 * Drop req_lock before cancel_delayed_work_sync: the work acquires
+	 * req_lock internally via ctn730_i2c_get_battery_level, so holding
+	 * it here would deadlock if the work is already running.
+	 */
+	mutex_unlock(&ctn730->req_lock);
+	cancel_delayed_work_sync(&ctn730_i2c->read_battery_delayed_work);
+	mutex_lock(&ctn730->req_lock);
+
+	mutex_lock(&ctn730->lock);
+
+	dev_dbg(ctn730->dev, "shutdown: %s\n", shutdown ? "true" : "false");
+
+	if (shutdown) {
+		/*
+		 * disable_irq waits for the IRQ handler to finish,
+		 * which may be waiting for our lock. So lets unlock first.
+		 */
+		mutex_unlock(&ctn730->lock);
+
+		/* disable + wait for IRQ handler */
+		disable_irq(ctn730->client->irq);
+		dev_dbg(ctn730->dev, "irq disabled\n");
+
+		/*
+		 * The IRQ handler may have queued battery work after the first
+		 * cancel, so drain it again now that the IRQ is disabled.
+		 */
+		mutex_unlock(&ctn730->req_lock);
+		cancel_delayed_work_sync(&ctn730_i2c->read_battery_delayed_work);
+		mutex_lock(&ctn730->req_lock);
+
+		/* and lock again... */
+		mutex_lock(&ctn730->lock);
+
+		ctn730_set_state(ctn730, state_shutdown);
+		memset(ctn730->marker_uid, 0, sizeof(ctn730->marker_uid));
+
+	} else {
+		ctn730_set_state(ctn730, state_unknown);
+
+		enable_irq(ctn730->client->irq);
+		dev_dbg(ctn730->dev, "irq enabled\n");
+	}
+
+	ctn730_set_charging_state(ctn730, charging_state_unknown);
+	ctn730_set_battery_level(ctn730, -1);
+
+	mutex_unlock(&ctn730->lock);
+}
+
+int ctn730_i2c_deinit(struct ctn730 *ctn730)
+{
+	struct ctn730_i2c *ctn730_i2c = ctn730->ctn730_i2c;
+
+	cancel_delayed_work_sync(&ctn730_i2c->read_battery_delayed_work);
+
+	disable_irq(ctn730->client->irq);
+	dev_dbg(ctn730->dev, "irq disabled\n");
+
+	cancel_delayed_work_sync(&ctn730_i2c->read_battery_delayed_work);
+
+	return 0;
+}
+
+int ctn730_i2c_reset_to_mode(struct ctn730 *ctn730, int mode)
+{
+	struct device *dev = ctn730->dev;
+	struct ctn730_msg msg;
+	int ret;
+
+	lockdep_assert_held(&ctn730->req_lock);
+
+	msg.header.msg_type = MSG_TYPE_CMD;
+	msg.header.instr = WLC_HOST_CTRL_RESET;
+	msg.header.len = 1;
+	msg.payload[0] = mode;
+
+	dev_dbg(dev, "sending WLC_HOST_CTRL_RESET_CMD\n");
+
+	set_bit(CTN730_RSP_WAIT, &ctn730->flags);
+	set_bit(CTN730_RST_DONE, &ctn730->flags);
+
+	ret = ctn730_i2c_send(ctn730, (u8 *)&msg, HEADER_SIZE + msg.header.len);
+	if (ret < 0)
+		goto done;
+
+	/*
+	 * we don't care about the response to this command
+	 * as a Reset event will come soon after. Actually, the
+	 * response transmission is sometimes not done quickly enough
+	 * and can be interrupted by the reset itself so we cannot rely
+	 * on receiving this response.
+	 */
+	ret = wait_on_bit_timeout(&ctn730->flags, CTN730_RST_DONE,
+				  TASK_INTERRUPTIBLE, msecs_to_jiffies(250));
+	if (ret) {
+		dev_err(dev, "Reset timeout %d\n", ret);
+		ret = -ETIMEDOUT;
+	}
+
+done:
+	return ret;
+}
