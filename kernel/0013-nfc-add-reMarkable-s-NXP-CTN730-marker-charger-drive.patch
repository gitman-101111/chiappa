@@ -0,0 +1,90 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * reMarkable NXP CTN730
+ *
+ * Copyright (C) 2023 reMarkable AS - http://www.remarkable.com/
+ */
+
+#include "ctn730_sysfs.h"
+#include "ctn730_i2c.h"
+
+static ssize_t marker_uid_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct ctn730 *ctn730 = dev_get_drvdata(dev);
+	ssize_t count;
+
+	mutex_lock(&ctn730->lock);
+	count = sysfs_emit(buf, "%*ph\n", (int)sizeof(ctn730->marker_uid), ctn730->marker_uid);
+	mutex_unlock(&ctn730->lock);
+
+	return count;
+}
+
+static ssize_t charging_state_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct ctn730 *ctn730 = dev_get_drvdata(dev);
+	ssize_t count;
+
+	mutex_lock(&ctn730->lock);
+	count = sysfs_emit(buf, "%s\n", ctn730_charging_state_text[ctn730->charging_state]);
+	mutex_unlock(&ctn730->lock);
+
+	return count;
+}
+
+static ssize_t device_state_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct ctn730 *ctn730 = dev_get_drvdata(dev);
+	ssize_t count;
+
+	mutex_lock(&ctn730->lock);
+	count = sysfs_emit(buf, "%s\n", ctn730_device_state_text[ctn730->device_state]);
+	mutex_unlock(&ctn730->lock);
+
+	return count;
+}
+
+static ssize_t resume_charging_store(struct device *dev, struct device_attribute *attr,
+				     const char *buf, size_t count)
+{
+	struct ctn730 *ctn730 = dev_get_drvdata(dev);
+	int ret;
+
+	ret = ctn730_i2c_resume_charging(ctn730);
+
+	return ret ? ret : count;
+}
+
+static DEVICE_ATTR_RO(marker_uid);
+static DEVICE_ATTR_RO(charging_state);
+static DEVICE_ATTR_RO(device_state);
+static DEVICE_ATTR_WO(resume_charging);
+
+static struct attribute *ctn730_attributes[] = {
+
+	&dev_attr_marker_uid.attr,
+	&dev_attr_charging_state.attr,
+	&dev_attr_device_state.attr,
+	&dev_attr_resume_charging.attr,
+	NULL,
+};
+
+static const struct attribute_group ctn730_attr_group = {
+	.attrs	= ctn730_attributes,
+};
+
+int ctn730_sysfs_nodes_init(struct ctn730 *ctn730)
+{
+	int ret;
+
+	ret = sysfs_create_group(&(ctn730->dev->kobj), &ctn730_attr_group);
+	if (ret != 0)
+		dev_err(ctn730->dev, "Failed to create attribute group: %d\n", ret);
+
+	return ret;
+}
+
+void ctn730_sysfs_nodes_deinit(struct ctn730 *ctn730)
+{
+	sysfs_remove_group(&(ctn730->dev->kobj), &ctn730_attr_group);
+}
