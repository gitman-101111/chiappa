+int ctn730_set_nfc_comm_power_step_param(struct ctn730 *ctn730, u32 index)
+{
+	struct parameter param;
+	int ret = 0;
+
+	param.tag = PARAM_NFC_COMM_POWER_STEP;
+	param.len = 1;
+	param.data[0] = index & 0xff;
+
+	ret = ctn730_i2c_write_parameter(ctn730, &param, param.len, false);
+	if (ret < 0) {
+		dev_err(ctn730->dev, "Failed to set NFC_COMM_POWER_STEP\n");
+		return -EIO;
+	}
+
+	param.tag = PARAM_USE_DEDICATED_NFC_COMM_POWER_STEP;
+	param.len = 1;
+	param.data[0] = PARAM_USE_DEDICATED_NFC_COMM_POWER_STEP_ENABLED;
+
+	ret = ctn730_i2c_write_parameter(ctn730, &param, param.len, false);
+	if (ret < 0) {
+		dev_err(ctn730->dev, "Failed to enable dedicated power step\n");
+		return -EIO;
+	}
+
+	return 0;
+}
+
+static int ctn730_set_nfc_tx_output_power_config(struct ctn730 *ctn730, u32 index)
+{
+	struct parameter tx_table = {
+		.tag = PARAM_TX_OUTPUT_POWER_CONTROL_CONFIGURATION,
+		.len = 10 * 4,
+		.data = { /* Default values */
+			0x92, 0x00, 0x00, 0x00,
+			0x95, 0x00, 0x00, 0x00,
+			0x9f, 0x00, 0x00, 0x00,
+			0x3f, 0x00, 0x00, 0x00,
+			0x3f, 0x20, 0x00, 0x00,
+			0x3f, 0x40, 0x00, 0x00,
+			0xdf, 0x80, 0x00, 0x00,
+			0x9f, 0x60, 0x00, 0x00,
+			0x5f, 0x60, 0x00, 0x00,
+			0x3f, 0x80, 0x00, 0x00,
+		},
+	};
+	u8 repeat[4];
+	size_t i;
+	int ret;
+
+	if (index > 10 || index < 1) {
+		dev_err(ctn730->dev, "Index out of range: %u\n", index);
+		return -1;
+	}
+
+	for (i = (index - 1) * 4; i < sizeof(tx_table.data); i++) {
+		if (i < index * 4)
+			repeat[i - (index - 1) * 4] = tx_table.data[i];
+		else
+			tx_table.data[i] = repeat[i % 4];
+	}
+
+	ret = ctn730_i2c_write_parameter(ctn730, &tx_table, tx_table.len, false);
+	if (ret < 0) {
+		dev_err(ctn730->dev, "Failed to enable dedicated power step\n");
+		return -EIO;
+	}
+
+	return 0;
+}
+
+int ctn730_set_nfc_num_power_step_configs_param(struct ctn730 *ctn730, u32 index)
+{
+	struct parameter param;
+	int ret;
+
+	if (index > 10 || index < 1) {
+		dev_err(ctn730->dev, "Power step setting out of range: %u\n", index);
+		return -1;
+	}
+
+	/* We don't set num power steps directly, but instead modify the table with
+	 * repeated values to limit the tx output power.
+	 */
+	param.tag = PARAM_TX_OUTPUT_POWER_CONTROL_INITIAL_CONFIGURATION;
+	param.len = 1;
+	param.data[0] = (index - 1) & 0xff;
+
+	ret = ctn730_i2c_write_parameter(ctn730, &param, param.len, false);
+	if (ret < 0) {
+		dev_err(ctn730->dev, "Failed to set initial config for power step\n");
+		return -EIO;
+	}
+
+	return ctn730_set_nfc_tx_output_power_config(ctn730, index);
+}
