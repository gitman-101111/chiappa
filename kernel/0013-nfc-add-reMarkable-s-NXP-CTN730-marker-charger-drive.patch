diff --git a/include/trace/events/ctn730_rm.h b/include/trace/events/ctn730_rm.h
new file mode 100644
index 000000000..4290c78c3
--- /dev/null
+++ b/include/trace/events/ctn730_rm.h
@@ -0,0 +1,70 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#undef TRACE_SYSTEM
+#define TRACE_SYSTEM ctn730_rm
+
+#if !defined(_TRACE_CTN730_RM_H) || defined(TRACE_HEADER_MULTI_READ)
+#define _TRACE_CTN730_RM_H
+
+#include <linux/tracepoint.h>
+
+TRACE_EVENT(ctn730_state_update,
+	TP_PROTO(struct ctn730 *ctn730),
+	TP_ARGS(ctn730),
+	TP_STRUCT__entry(
+		__field(enum ctn730_state, state)
+		__field(enum ctn730_charging_state, charging_state)
+		__field(enum ctn730_device_state, device_state)
+		__field(enum ctn730_app_data_state, app_data_state)
+		__field(int, battery_level)
+	),
+	TP_fast_assign(
+		__entry->state = ctn730->state;
+		__entry->charging_state = ctn730->charging_state;
+		__entry->device_state = ctn730->device_state;
+		__entry->app_data_state = ctn730->app_data_state;
+		__entry->battery_level = ctn730->battery_level;
+	),
+	TP_printk(
+		"state: %d, charging: %d, device: %d, app_data: %d, battery_level: %d",
+		__entry->state,
+		__entry->charging_state,
+		__entry->device_state,
+		__entry->app_data_state,
+		__entry->battery_level
+	)
+);
+
+DECLARE_EVENT_CLASS(ctn730_msg_template,
+	TP_PROTO(struct ctn730 *ctn730, struct ctn730_msg *msg),
+	TP_ARGS(ctn730, msg),
+	TP_STRUCT__entry(
+		__field(__u8, instr)
+		__field(__u8, msg_type)
+	),
+	TP_fast_assign(
+		__entry->instr = msg->header.instr;
+		__entry->msg_type = msg->header.msg_type;
+	),
+	TP_printk(
+		"instr:%u, msg_type:%u",
+		(unsigned int)__entry->instr, (unsigned int)__entry->msg_type
+	)
+);
+
+DEFINE_EVENT(ctn730_msg_template, ctn730_send_msg_start,
+	TP_PROTO(struct ctn730 *ctn730, struct ctn730_msg *msg),
+	TP_ARGS(ctn730, msg)
+);
+DEFINE_EVENT(ctn730_msg_template, ctn730_send_msg_end,
+	TP_PROTO(struct ctn730 *ctn730, struct ctn730_msg *msg),
+	TP_ARGS(ctn730, msg)
+);
+DEFINE_EVENT(ctn730_msg_template, ctn730_event,
+	TP_PROTO(struct ctn730 *ctn730, struct ctn730_msg *msg),
+	TP_ARGS(ctn730, msg)
+);
+
+#endif /* if !defined(_TRACE_CTN730_RM_H) || defined(TRACE_HEADER_MULTI_READ) */
+
+/* This part must be outside protection */
+#include <trace/define_trace.h>
