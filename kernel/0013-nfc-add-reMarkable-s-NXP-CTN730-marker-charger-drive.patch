@@ -0,0 +1,189 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * reMarkable NXP CTN730
+ *
+ * Copyright (C) 2023 reMarkable AS - http://www.remarkable.com/
+ */
+
+#ifndef __RM_CTN730_H_
+#define __RM_CTN730_H_
+
+#include <linux/kobject.h>
+#include <linux/pinctrl/pinctrl.h>
+#include <linux/gpio.h>
+#include <linux/of.h>
+#include <linux/i2c.h>
+#include <linux/device.h>
+#include <linux/workqueue.h>
+#include <linux/kfifo.h>
+#include <linux/mutex.h>
+#include <linux/rfkill.h>
+#include <linux/miscdevice.h>
+
+#define CTN730_IOCTLID	0xEE
+#define CTN730_IOCTL_GET_STATE  _IOR(CTN730_IOCTLID, 0, int)
+#define CTN730_IOCTL_ENABLE_APP_DATA_CHANNEL  _IOR(CTN730_IOCTLID, 1, int)
+#define CTN730_IOCTL_DISABLE_APP_DATA_CHANNEL  _IOR(CTN730_IOCTLID, 2, int)
+
+/*
+ * The 6 first stats have the same values as returned by
+ * the WLC_HOST_CTRL_DUMP_STATUS_CMD command
+ */
+enum ctn730_state {
+	state_initialized = 0,
+	state_device_detection,
+	state_device_detected,
+	state_charging_data_channel_established,
+	state_app_data_channel_established,
+	state_device_paused,
+	state_download_mode,
+	state_shutdown,
+	state_unknown,
+};
+extern const char *ctn730_state_text[];
+
+enum ctn730_charging_state {
+	charging_state_charging_started = 0,
+	charging_state_charging_ended,
+	charging_state_charging_stopped,
+	charging_state_unknown,
+};
+extern const char *ctn730_charging_state_text[];
+
+enum ctn730_device_state {
+	device_state_device_detected = 0,
+	device_state_device_deactivated,
+	device_state_device_lost,
+	device_state_device_version_mismatch,
+	device_state_device_docked,
+	device_state_device_undocked,
+	device_state_fo_present,
+	device_state_battery_full,
+	device_state_charge_failure,
+	device_state_ndef_mode,
+	device_state_listener_ot,
+	device_state_unknown,
+};
+extern const char *ctn730_device_state_text[];
+
+enum ctn730_boot_reason {
+	boot_reason_intended = 0,
+	boot_reason_firmware_corrupted,
+	boot_reason_unrecoverable,
+	boot_reason_unknown,
+};
+extern const char *ctn730_boot_reason_text[];
+
+enum ctn730_charging_disable_reason {
+	charging_disable_reason_host_controller_request = 0,
+	charging_disable_reason_overtemperature,
+	charging_disable_reason_channel_sync_error,
+	charging_disable_reason_unknown,
+};
+extern const char *ctn730_charging_disable_reason_text[];
+
+enum ctn730_app_data_state {
+	app_data_state_connected = 0,
+	app_data_state_disconnected,
+	app_data_state_activation_failed,
+	app_data_state_unknown,
+};
+extern const char *ctn730_app_data_state_text[];
+
+enum fw_state {
+	fw_state_unknown,
+	fw_state_up_to_date,
+	fw_state_not_up_to_date,
+};
+extern const char *ctn730_fw_state_text[];
+
+#define CTN730_HOST_UID_SIZE 16
+#define CTN730_MARKER_UID_SIZE 7
+
+enum {
+	CTN730_RFKILLED,
+	CTN730_RSP_WAIT,
+	CTN730_RST_DONE,
+	CTN730_INIT_PENDING,
+	CTN730_BOOT_PENDING,
+	CTN730_APP_DATA_STATE_CHANGE,
+	CTN730_APP_DATA_SENT,
+};
+
+struct ctn730 {
+	struct i2c_client *client;
+	struct device *dev;
+	struct mutex lock;
+	struct mutex req_lock;
+	struct regulator *nfc_supply;
+	struct power_supply *supply;
+	struct rfkill *rfkill;
+	struct kfifo app_data_fifo;
+
+	u32 detect_interval_ms;
+	bool init_bus_lock;
+
+	unsigned long flags;
+	enum ctn730_state state;
+	enum ctn730_charging_state charging_state;
+	enum ctn730_device_state device_state;
+	enum ctn730_boot_reason boot_reason;
+	enum ctn730_app_data_state app_data_state;
+
+	u8 host_uid[CTN730_HOST_UID_SIZE];
+	u8 marker_uid[CTN730_MARKER_UID_SIZE];
+
+	u8 fw_current_minor;
+	u8 fw_current_major;
+	u8 fw_provided_minor;
+	u8 fw_provided_major;
+	enum fw_state fw_state;
+
+	int battery_level;
+
+	void *ctn730_i2c;
+
+	struct miscdevice mdev;
+	wait_queue_head_t app_data_wait_queue;
+
+	struct kobject *kobject;
+
+	/* control attrs */
+	struct kobj_attribute reset_normal_mode_attr;
+	struct kobj_attribute reset_download_mode_attr;
+	struct kobj_attribute enable_detection_attr;
+	struct kobj_attribute disable_detection_attr;
+	struct kobj_attribute pause_charging_attr;
+	struct kobj_attribute resume_charging_attr;
+	struct kobj_attribute enable_application_channel_attr;
+	struct kobj_attribute disable_application_channel_attr;
+	struct kobj_attribute prod_test_attr;
+
+	/* info attrs */
+	struct kobj_attribute fw_version_current_attr;
+	struct kobj_attribute fw_version_provided_attr;
+	struct kobj_attribute host_uid_attr;
+	struct kobj_attribute marker_uid_attr;
+
+	/* status attrs */
+	struct kobj_attribute status_attr;
+	struct kobj_attribute charging_state_attr;
+	struct kobj_attribute device_state_attr;
+	struct kobj_attribute fw_state_attr;
+	struct kobj_attribute battery_level_attr;
+	struct kobj_attribute power_step_attr;
+
+	/* config attrs */
+	struct kobj_attribute read_parameter_attr;
+	struct kobj_attribute write_parameter_attr;
+	struct kobj_attribute read_session_parameter_attr;
+	struct kobj_attribute write_session_parameter_attr;
+};
+
+void ctn730_set_state(struct ctn730 *ctn730, enum ctn730_state new_state);
+void ctn730_set_charging_state(struct ctn730 *ctn730, enum ctn730_charging_state new_state);
+void ctn730_set_device_state(struct ctn730 *ctn730, enum ctn730_device_state new_state);
+void ctn730_set_app_data_state(struct ctn730 *ctn730, enum ctn730_app_data_state new_state);
+void ctn730_set_battery_level(struct ctn730 *ctn730, int new_level);
+
+#endif /* __RM_CTN730_H_ */
diff --git a/drivers/nfc/ctn730_rm/ctn730_fw.c b/drivers/nfc/ctn730_rm/ctn730_fw.c
new file mode 100644
index 000000000..a9d2a8bca
--- /dev/null
+++ b/drivers/nfc/ctn730_rm/ctn730_fw.c
@@ -0,0 +1,133 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * reMarkable NXP CTN730
+ *
+ * Copyright (C) 2023 reMarkable AS - http://www.remarkable.com/
+ */
+
+#include <linux/crc32.h>
+#include <linux/delay.h>
+#include <linux/ihex.h>
+#include <linux/mutex.h>
+
+#include "ctn730.h"
+#include "ctn730_i2c.h"
+#include "ctn730_fw.h"
+
+const char *ctn730_fw_state_text[] = { "fw_state_unknown", "fw_state_up_to_date",
+				"fw_state_not_up_to_date" };
+
+
+static int __ctn730_fw_sync(struct ctn730 *ctn730,
+			    const struct ihex_binrec *rec)
+{
+	int ret;
+	int len;
+	bool already_up_to_date;
+	u32 crc = ~0; /* cf: ether_crc() */
+	u8 major = READ_ONCE(ctn730->fw_provided_major);
+	u8 minor = READ_ONCE(ctn730->fw_provided_minor);
+
+	lockdep_assert_held(&ctn730->req_lock);
+
+	ret = ctn730_i2c_dl_open_session(ctn730, major, minor, &already_up_to_date);
+	if (ret) {
+		dev_err(ctn730->dev, "Failed to open download session: %d\n", ret);
+		return ret;
+	}
+
+	if (already_up_to_date) {
+		dev_info(ctn730->dev, "FW already up-to-date: %02d.%02d\n", major, minor);
+		return 0;
+	}
+
+	WRITE_ONCE(ctn730->fw_state, fw_state_not_up_to_date);
+
+	while ((rec = ihex_next_binrec(rec))) {
+		len = be16_to_cpu(rec->len);
+
+		if (len != FW_BLOCK_SIZE) {
+			dev_err(ctn730->dev, "firmware record has unexpected length: %d\n", len);
+			return -EINVAL;
+		}
+
+		dev_dbg(ctn730->dev,
+			"firmware record: addr: %x, len: %d\n",
+			be32_to_cpu(rec->addr), len);
+
+		ret = ctn730_i2c_dl_write_flash(ctn730, be32_to_cpu(rec->addr), rec->data);
+		if (ret) {
+			dev_err(ctn730->dev, "Error writing fw page: %d\n", ret);
+			return ret;
+		}
+		crc = crc32_le(crc, rec->data, FW_BLOCK_SIZE);
+	}
+
+	/*
+	 * IEEE 802.3 CRC32 has to be inverted after the intermediate calculations.
+	 * cf: ether_crc()
+	 */
+	crc = ~crc;
+
+	ret = ctn730_i2c_dl_commit_session(ctn730, crc);
+	if (ret) {
+		dev_err(ctn730->dev, "Failed to commit download session: %d, crc: %x\n", ret, crc);
+		return ret;
+	}
+
+	WRITE_ONCE(ctn730->fw_state, fw_state_up_to_date);
+	dev_info(ctn730->dev, "FW update to %02d.%02d succeeded\n", major, minor);
+
+	return 0;
+}
+
+/**
+ * Has to be called while in DOWNLOAD mode.
+ */
+int ctn730_fw_sync(struct ctn730 *ctn730)
+{
+	int ret = 0;
+	const struct firmware *fw;
+	const struct ihex_binrec *rec;
+	int tries = 3;
+
+	lockdep_assert_held(&ctn730->req_lock);
+
+	ret = request_ihex_firmware(&fw, "ctn730.fw", ctn730->dev);
+	if (ret) {
+		dev_err(ctn730->dev, "Failed to read firmware\n");
+		return ret;
+	}
+
+	rec = (const struct ihex_binrec *)fw->data;
+
+	/* first record is the version number */
+	if (be32_to_cpu(rec->addr) != 0x0 || be16_to_cpu(rec->len) != 2) {
+		dev_err(ctn730->dev, "FW image has bad version frame!\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	WRITE_ONCE(ctn730->fw_provided_major, rec->data[0]);
+	WRITE_ONCE(ctn730->fw_provided_minor, rec->data[1]);
+
+retry:
+	ret = __ctn730_fw_sync(ctn730, rec);
+	if (ret) {
+		if (--tries > 0) {
+			dev_info(ctn730->dev,
+				 "FW update failed, retrying... Attempts left: %d\n", tries);
+			goto retry;
+		}
+		goto out;
+	}
+
+out:
+	release_firmware(fw);
+
+	return ret;
+}
+
+MODULE_DESCRIPTION("Low-level driver for NXP CTN730");
+MODULE_AUTHOR("reMarkable");
+MODULE_LICENSE("GPL");
