+int ctn730_i2c_dl_open_session(struct ctn730 *ctn730,
+			       uint8_t version_major,
+			       uint8_t version_minor,
+			       bool *already_ok)
+{
+	struct ctn730_msg msg;
+	int ret;
+
+	lockdep_assert_held(&ctn730->req_lock);
+
+	dev_dbg(ctn730->dev, "sending WLC_HOST_CTRL_DL_OPEN_SESSION_CMD\n");
+
+	msg.header.msg_type = MSG_TYPE_CMD;
+	msg.header.instr = WLC_HOST_CTRL_DL_OPEN_SESSION;
+
+	msg.header.len = sizeof(version_major) + sizeof(version_minor);
+	msg.payload[0] = version_major;
+	msg.payload[1] = version_minor;
+
+	ret = ctn730_i2c_send_wait_rsp_no_status_check_locked(ctn730, &msg, MSG_DEFAULT_TIMEOUT);
+	if (ret < 0)
+		return ret;
+
+	*already_ok = (msg.status == STATUS_FW_VERSION_ERROR);
+
+	if (!(msg.status == STATUS_OK || msg.status == STATUS_FW_VERSION_ERROR)) {
+		dev_err(ctn730->dev, "Unexpeced status code: %d\n", msg.status);
+		return -EIO;
+	}
+
+	return 0;
+}
+
+int ctn730_i2c_dl_write_flash(struct ctn730 *ctn730, uint32_t addr, const uint8_t *data)
+{
+	struct ctn730_msg msg;
+	int ret;
+
+	lockdep_assert_held(&ctn730->req_lock);
+
+	dev_dbg(ctn730->dev, "sending WLC_HOST_CTRL_DL_WRITE_FLASH_CMD\n");
+
+	msg.header.msg_type = MSG_TYPE_CMD;
+	msg.header.instr = WLC_HOST_CTRL_DL_WRITE_FLASH;
+	/* 3 byte addr + fw data */
+	msg.header.len = 3 + FW_BLOCK_SIZE;
+
+	/* addr in 3!? byte little-endian */
+	msg.payload[0] = addr & 0xff;
+	msg.payload[1] = (addr >> 8) & 0xff;
+	msg.payload[2] = (addr >> 16) & 0xff;
+
+	/* the fw page */
+	memcpy(msg.payload + 3, data, FW_BLOCK_SIZE);
+
+	ret = ctn730_i2c_send_wait_rsp_timeout_locked(ctn730, &msg, MSG_DEFAULT_TIMEOUT);
+	if (ret < 0)
+		return ret;
+
+	return 0;
+}
+
+int ctn730_i2c_dl_commit_session(struct ctn730 *ctn730, uint32_t crc)
+{
+	struct ctn730_msg msg;
+	int ret;
+
+	lockdep_assert_held(&ctn730->req_lock);
+
+	dev_dbg(ctn730->dev, "sending WLC_HOST_CTRL_DL_COMMIT_SESSION_CMD\n");
+
+	msg.header.msg_type = MSG_TYPE_CMD;
+	msg.header.instr = WLC_HOST_CTRL_DL_COMMIT_SESSION;
+
+	msg.header.len = sizeof(crc);
+	msg.crc = cpu_to_le32(crc);
+
+	ret = ctn730_i2c_send_wait_rsp_timeout_locked(ctn730, &msg, MSG_DEFAULT_TIMEOUT);
+	if (ret < 0)
+		return ret;
+
+	return 0;
+}
+
+int ctn730_i2c_start_prod_test(struct ctn730 *ctn730, struct prod_test *prod_test)
+{
+	struct ctn730_i2c *ctn730_i2c = ctn730->ctn730_i2c;
+	struct prod_test_result *prod_test_result = &ctn730_i2c->last_prod_test_result;
+	struct ctn730_msg msg;
+	int ret;
+
+	dev_dbg(ctn730->dev, "sending WLC_HOST_CTRL_BIST_CMD\n");
+
+	msg.header.msg_type = MSG_TYPE_CMD;
+	msg.header.instr = WLC_HOST_CTRL_BIST;
+	msg.header.len = prod_test->len + 1;
+	msg.payload[0] = prod_test->test_id;
+	memcpy(&msg.payload[1], prod_test->data, prod_test->len);
+
+	ret = ctn730_i2c_send_wait_rsp_no_status_check(ctn730, &msg, MSG_DEFAULT_TIMEOUT);
+
+	if (ret < 0)
+		return ret;
+
+	mutex_lock(&ctn730->lock);
+
+	prod_test_result->test_id = prod_test->test_id;
+	prod_test_result->status = msg.status;
+	prod_test_result->len = msg.header.len - 1;
+
+	memcpy(prod_test_result->data, &msg.payload[1], msg.header.len - 1);
+
+	if (prod_test_result->status != STATUS_OK)
+		dev_warn(ctn730->dev, "test returned with code: %02x\n",
+				      prod_test_result->status);
+
+	mutex_unlock(&ctn730->lock);
+
+	return 0;
+}
+
+void ctn730_i2c_lock_bus(struct ctn730 *ctn730)
+{
+	i2c_lock_bus(ctn730->client->adapter, I2C_LOCK_ROOT_ADAPTER);
+}
+
+void ctn730_i2c_unlock_bus(struct ctn730 *ctn730)
+{
+	i2c_unlock_bus(ctn730->client->adapter, I2C_LOCK_ROOT_ADAPTER);
+}
+
+MODULE_DESCRIPTION("Low-level driver for NXP CTN730");
+MODULE_AUTHOR("reMarkable");
+MODULE_LICENSE("GPL");
diff --git a/drivers/nfc/ctn730_rm/ctn730_i2c.h b/drivers/nfc/ctn730_rm/ctn730_i2c.h
new file mode 100644
index 000000000..6f584f3e3
--- /dev/null
+++ b/drivers/nfc/ctn730_rm/ctn730_i2c.h
@@ -0,0 +1,341 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * reMarkable NXP CTN730
+ *
+ * Copyright (C) 2023 reMarkable AS - http://www.remarkable.com/
+ */
+
+#ifndef __CTN730_I2C_H__
+#define __CTN730_I2C_H__
+
+#include "ctn730.h"
+#include <linux/i2c.h>
+
+#define MSG_SIZE 256
+#define NUM_MSGS_RECV_BUFFER 5
+#define FW_BLOCK_SIZE 128
+
+#define MSG_DEFAULT_TIMEOUT msecs_to_jiffies(1000)
+#define MSG_APP_CHANNEL_TIMEOUT msecs_to_jiffies(10000)
+
+enum ctn730_msg_type {
+	MSG_TYPE_CMD = 0x00,
+	MSG_TYPE_RSP = 0x01,
+	MSG_TYPE_EVT = 0x02,
+};
+
+/**
+ * The chip documentation mostly refers to specific instruction codes by suffixing them with
+ * _MSG, _RSP or _EVT.
+ * Here, we only define the codes once (as they are the same across message types).
+ */
+enum ctn730_instr {
+	/*
+	 * The command WLC_HOST_CTRL_RESET allows the Host-Controller to perform
+	 * an explicit WLC-Host reset. Either to NORMAL_MODE or DOWNLOAD_MODE.
+	 *
+	 * As an event it is sent by WLC-Host every time it enters the INITIALIZED
+	 * state after booting up. Moreover, it informs into which operating mode
+	 * (NORMAL_MODE or DOWNLOAD_MODE) the WLC-Host has booted into
+	 */
+	WLC_HOST_CTRL_RESET = 0x00,
+	/* Used to write/change a persistent parameter within WLC-Host. */
+	WLC_HOST_CTRL_WRITE_PARAMETER = 0x01,
+	/* Used to read a persistent parameter within WLC-Host. */
+	WLC_HOST_CTRL_READ_PARAMETER = 0x02,
+	/*
+	 * To download firmware to WLC-Host, a download session needs to be opened.
+	 * Note that this is the only command that provides both FW and HW version of
+	 * the Host-Controller.
+	 * FW version can also be retrieved with command WLC_HOST_CTRL_DUMP_STATUS_CMD
+	 */
+	WLC_HOST_CTRL_DL_OPEN_SESSION = 0x03,
+	/*
+	 * Once the complete image has been downloaded, the download session needs
+	 * to be committed in order to perform the integrity check.
+	 */
+	WLC_HOST_CTRL_DL_COMMIT_SESSION = 0x04,
+	/* Used to write new FW image to flash */
+	WLC_HOST_CTRL_DL_WRITE_FLASH = 0x05,
+	/*
+	 * WLC-Host allows execution of a few tests which are implemented as part of the Builtin
+	 * self-test suite. These tests can be run during production to ensure that WLC-Host is
+	 * properly working.
+	 */
+	WLC_HOST_CTRL_BIST = 0x06,
+	/* Used to write/change a non-persistent parameter within WLC-Host. */
+	WLC_HOST_CTRL_WRITE_SESSION_PARAMETER = 0x07,
+	/* Used to read a non-persistent parameter within WLC-Host. */
+	WLC_HOST_CTRL_READ_SESSION_PARAMETER = 0x08,
+	/* returns 16 bytes identifier which unique for each WLC-Host. */
+	WLC_HOST_CTRL_DL_READ_UID = 0x09,
+	/*
+	 * The WLC_CHG_CTRL_ENABLE message is used to start the device detection and all
+	 * subsequent autonomous activities once a Device has been detected. After boot-up (when
+	 * WLC-Host is in state INITIALIZED), this command message needs explicitly sent in order
+	 * to move to state DEVICE_DETECTION.
+	 */
+	WLC_CHG_CTRL_ENABLE = 0x10,
+	/*
+	 * WLC_CHG_CTRL_DISABLE command is used to stop device detection but also to stop
+	 * an already ongoing charging activity. It can be sent in state DEVICE_DETECTION as
+	 * well as any subsequent state.
+	 */
+	WLC_CHG_CTRL_DISABLE = 0x11,
+	/*
+	 * The event WLC_CHG_CTRL_DEVICE_STATE is a notification sent by WLC-Host
+	 * to inform the Host-Controller when a Device has been detected or the Device has been
+	 * lost. Device loss can be a result of moving out the device of proximity/operating value
+	 * but also unrecoverable errors during data exchange (using Application Data Channel as
+	 * well as Charging Data Channel) finally lead to considering the device as lost.
+	 */
+	WLC_CHG_CTRL_DEVICE_STATE = 0x12,
+	WLC_CHG_CTRL_DEACTIVATE_DEVICE = 0x13,
+	WLC_CHG_CTRL_CHARGING_STATE = 0x14,
+	/*
+	 * During charging activity (i.e. while WLC-Host is in state
+	 * CHARGING_DATA_CHANNEL_ESTABLISHED) the Device regularly sends updates
+	 * via the Charging Data Channel. These updates contain the current battery level as
+	 * well as a timespan value when the next update will be sent. Each update will be
+	 * forwarded to the Host-Controller using the WLC_CHG_CTRL_CHARGING_INFO_EVT
+	 * event. In case the host is not interested in such events, they can be permanently
+	 * disabled using session parameter tag SEND_CHARGING_INFO_EVT
+	 */
+	WLC_CHG_CTRL_CHARGING_INFO = 0x15,
+	/*
+	 * To allow the Host-Controller to pause this behavior (e.g. for optimizing power
+	 * consumption) while still being able to detect a WLC-Device removal, the
+	 * WLC_CHG_CTRL_PAUSE_DEVICE_CMD can be sent. Upon reception of this
+	 * command, the WLC-Host disables any ongoing charging activity (when in state
+	 * CHARGING_DATA_CHANNEL_ESTABLISHED) by disabling the RF power transfer
+	 * leading to a transition to state DEVICE_DETECTED, indicated by sending the
+	 * WLC_CHG_CTRL_CHARGING_STATE_EVT(CHARGING_STOPPED).
+	 */
+	WLC_CHG_CTRL_PAUSE_DEVICE = 0x16,
+	/*
+	 * To release a WLC-Device pause, Host-Controller may send the
+	 * WLC_CHG_CTRL_RESUME_DEVICE_CMD which triggers a transition to state
+	 * DEVICE_DETECTED where WLC-Device will be polled again for charging requests. The
+	 * transition is indicated by WLC_CHG_CTRL_RESUME_DEVICE_EVT.
+	 */
+	WLC_CHG_CTRL_RESUME_DEVICE = 0x17,
+	/*
+	 * Returns various information such as FW version, current state, etc.
+	 * Can be used in almost all states.
+	 */
+	WLC_HOST_CTRL_DUMP_STATUS = 0x0C,
+	/*
+	 * Used to inform the Host-Controller about errors occurred within the WLC-Host
+	 * which are not directly related to any command
+	 */
+	WLC_HOST_CTRL_GENERIC_ERROR = 0x0F,
+	WLC_CHG_CTRL_OPTIONAL_NDEF = 0x1F,
+	/*
+	 * Application Data Control is used to control the behavior of the Application Data Channel.
+	 * The Application Data Channel is used for end-to-end data exchange between Host-
+	 * Controller and Device-Controller. It is a raw data channel which allows sending and
+	 * receiving data. For large data transfers the data can be split into small chunks (also
+	 * called chains) of a maximum size of 254 Bytes. These chunks are independent on the
+	 * data frames which are sent via the RF Application Data Channel, where the chunk size is
+	 * limited to 64 Bytes. In other words, WLC-Host automatically performs chaining over RF
+	 * independent on the chaining done over the Host Interface.
+	 */
+	WLC_APP_CTRL_CHANNEL_ENABLE = 0x20,
+	WLC_APP_CTRL_CHANNEL_DISABLE = 0x21,
+	WLC_APP_CTRL_CHANNEL_STATE = 0x22,
+	WLC_APP_CTRL_SEND_DATA = 0x23,
+	WLC_APP_CTRL_RECEIVE_DATA = 0x24,
+};
+
+struct ctn730_header {
+	enum ctn730_instr instr : 6;
+	enum ctn730_msg_type msg_type : 2;
+	u8 len; /* length of payload only */
+} __packed;
+
+#define HEADER_SIZE sizeof(struct ctn730_header)
+
+struct ctn730_msg {
+	struct ctn730_header header;
+	union {
+		u8 status;
+		u8 event;
+		u8 reason;
+		u8 test_id;
+		__le32 crc;
+		u8 payload[MSG_SIZE];
+	};
+} __packed;
+
+struct parameter {
+	u8 tag;
+	u8 status;
+	u8 len;
+	u8 data[MSG_SIZE - HEADER_SIZE];
+};
+
+struct status {
+	u8 tag;
+	u8 status;
+	u8 len;
+	u8 data[MSG_SIZE - HEADER_SIZE];
+};
+
+struct prod_test {
+	u8 test_id;
+	u8 len;
+	u8 data[MSG_SIZE - HEADER_SIZE];
+};
+
+struct prod_test_result {
+	u8 test_id;
+	u8 status;
+	u8 len;
+	u8 data[MSG_SIZE - HEADER_SIZE];
+};
+
+struct ctn730_i2c {
+	struct ctn730_msg response_msg;
+	struct status last_status;
+	struct parameter last_parameter;
+	struct parameter last_session_parameter;
+	struct prod_test_result last_prod_test_result;
+	struct ctn730 *ctn730;
+
+	struct delayed_work read_battery_delayed_work;
+	int unsuccessful_battery_reads_on_dock;
+};
+
+int ctn730_i2c_init(struct ctn730 *ctn730);
+int ctn730_i2c_deinit(struct ctn730 *ctn730);
+void ctn730_i2c_shutdown(struct ctn730 *ctn730, bool shutdown);
+int ctn730_i2c_reset_to_mode(struct ctn730 *ctn730, int mode);
+int ctn730_i2c_read_host_uid(struct ctn730 *ctn730);
+int ctn730_i2c_read_parameter(struct ctn730 *ctn730, struct parameter *parameter, bool session);
+int ctn730_i2c_write_parameter(struct ctn730 *ctn730, struct parameter *parameter, int len,
+			       bool session);
+int ctn730_enable_charging_info_event(struct ctn730 *ctn730, bool enable);
+int ctn730_set_nfc_comm_power_step_param(struct ctn730 *ctn730, u32 index);
+int ctn730_set_nfc_num_power_step_configs_param(struct ctn730 *ctn730, u32 index);
+int ctn730_i2c_read_status(struct ctn730 *ctn730, struct status *status);
+int ctn730_i2c_detection(struct ctn730 *ctn730, int period_ms, bool enable);
+#define ctn730_i2c_enable_detection(ctn730, period_ms) ctn730_i2c_detection(ctn730, period_ms, true)
+#define ctn730_i2c_disable_detection(ctn730) ctn730_i2c_detection(ctn730, 0, false)
+int ctn730_i2c_get_battery_level(struct ctn730 *ctn730);
+int ctn730_i2c_get_host_power_step(struct ctn730 *ctn730, int *step);
+int ctn730_i2c_enable_app_data_channel(struct ctn730 *ctn730);
+int ctn730_i2c_disable_app_data_channel(struct ctn730 *ctn730);
+int ctn730_i2c_send_app_data(struct ctn730 *ctn730, char *data, int len);
+int ctn730_i2c_get_app_data(struct ctn730 *ctn730, char *data, int len);
+int ctn730_i2c_start_prod_test(struct ctn730 *ctn730, struct prod_test *prod_test);
+void ctn730_i2c_lock_bus(struct ctn730 *ctn730);
+void ctn730_i2c_unlock_bus(struct ctn730 *ctn730);
+int ctn730_i2c_pause_charging(struct ctn730 *ctn730);
+int ctn730_i2c_resume_charging(struct ctn730 *ctn730);
+
+/* DL mode API */
+int ctn730_i2c_dl_open_session(struct ctn730 *ctn730,
+			       uint8_t version_major, uint8_t version_minor,
+			       bool *already_ok);
+int ctn730_i2c_dl_write_flash(struct ctn730 *ctn730, uint32_t addr, const uint8_t *data);
+int ctn730_i2c_dl_commit_session(struct ctn730 *ctn730, uint32_t crc);
+
+#define NORMAL_MODE 0x00
+#define DOWNLOAD_MODE 0x01
+
+enum {
+	PARAM_SEND_CHARGING_INFO_EVT = 0x0,
+	/* Controls whether to use a specific power step index for NFC communication or whether to
+	 * use whatever power step is active at the time NFC communication is initiated.
+	 */
+	PARAM_USE_DEDICATED_NFC_COMM_POWER_STEP = 0x08,
+	/* Specifies an index into the table set by the TX_OUTPUT_POWER_CONTROL_CONFIGURATION (0x1D)
+	 * parameter.
+	 */
+	PARAM_NFC_COMM_POWER_STEP = 0x09,
+	PARAM_TX_OUTPUT_POWER_CONTROL_INITIAL_CONFIGURATION = 0x26,
+	PARAM_TX_OUTPUT_POWER_CONTROL_NUM_OF_CONFIGURATIONS = 0x1c,
+	PARAM_TX_OUTPUT_POWER_CONTROL_CONFIGURATION = 0x1d,
+};
+
+enum {
+	PARAM_SESSION_SEND_CHARGING_INFO_EVT = 0x00,
+	PARAM_SESSION_USE_DEDICATED_NFC_COMM_POWER_STEP = 0x01,
+	PARAM_SESSION_NFC_COMM_POWER_STEP = 0x02,
+	PARAM_SESSION_RF_TX_OUTPUT_INV_RM = 0x03,
+};
+
+// Parameter values
+enum {
+	PARAM_SEND_CHARGING_INFO_EVT_ENABLE = 0x01,
+	PARAM_SEND_CHARGING_INFO_EVT_DISABLE = 0x0,
+};
+
+enum {
+	PARAM_USE_DEDICATED_NFC_COMM_POWER_STEP_ENABLED = 0x1,
+	PARAM_USE_DEDICATED_NFC_COMM_POWER_STEP_USE_CURRENT = 0x0,
+};
+
+enum {
+	// We use a low-power step for NFC comms for reliability reasons
+	PARAM_NFC_COMM_POWER_STEP_INDEX_1 = 0x1,
+	PARAM_NFC_COMM_POWER_STEP_INDEX_7 = 0x7,
+};
+
+/* Boot reasons, only in DOWNLOAD_MODE */
+#define INTENDED 0x00
+#define FIRMWARE_CORRUPTED 0x01
+#define UNRECOVERABLE_ERROR 0x02
+
+#define CURRENT_HOST_STATE 0x02
+#define HOST_POWER_STEP 0x03
+#define DEVICE_BATTERY_LEVEL 0x04
+
+#define SYNTAX_ERROR 0x00
+
+#define STATUS_OK 0x00
+#define STATUS_PARAMETER_ERROR 0x01
+#define STATUS_STATE_ERROR 0x02
+#define STATUS_VALUE_ERROR 0x03
+#define STATUS_REJECTED 0x04
+#define STATUS_RESOURCE_ERROR 0x10
+#define STATUS_TXLDO_ERROR 0x11
+#define STATUS_ANTENNA_SELECTION_ERROR 0x12
+#define STATUS_BIST_FAILED 0x20
+#define STATUS_BIST_NO_WLC_CAP 0x21
+#define STATUS_BIST_TXLDO_CURRENT_OVERFLOW 0x22
+#define STATUS_BIST_TXLDO_CURRENT_UNDERFLOW 0x23
+#define STATUS_FW_VERSION_ERROR 0x30
+#define STATUS_FW_VERIFICATION_ERROR 0x31
+#define STATUS_CRN120_BLOCK_PARAMETER_ERROR 0x32
+#define STATUS_CRN120_READ_ERROR 0x33
+#define STATUS_DTA_TEST_FAILED 0x40
+#define STATUS_DTA_TEST_LEN_NOT_OK 0x41
+
+#define HOST_CONTROLLER_REQUEST 0x00
+#define OVERTEMPERATURE 0x01
+#define CHANNEL_SYNC_ERROR 0x02
+
+#define DEVICE_DETECTED 0x00
+#define DEVICE_DEACTIVATED 0x01
+#define DEVICE_LOST 0x02
+#define DEVICE_VERSION_MISMATCH 0x03
+#define DEVICE_DOCKED 0x04
+#define DEVICE_UNDOCKED 0x05
+#define FO_PRESENT 0x06
+#define BATTERY_FULL 0x07
+#define CHARGE_FAILURE 0x08
+#define NDEF_MODE 0x0A
+#define LISTENER_OT 0xFA
+
+#define CHARGING_STARTED 0x00
+#define CHARGING_ENDED 0x01
+#define CHARGING_STOPPED 0x02
+
+#define CHAINED_PACKET 0x00
+#define LAST_PACKET 0x01
+
+/* max data that can be sent over Application Data Channel*/
+#define APP_DATA_MSG_SIZE 254
+
+#endif /* __CTN730_I2C_H__ */
diff --git a/drivers/nfc/ctn730_rm/ctn730_supply.c b/drivers/nfc/ctn730_rm/ctn730_supply.c
new file mode 100644
index 000000000..3281650c1
--- /dev/null
+++ b/drivers/nfc/ctn730_rm/ctn730_supply.c
@@ -0,0 +1,201 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * reMarkable NXP CTN730
+ *
+ * Copyright (C) 2023 reMarkable AS - http://www.remarkable.com/
+ */
+
+#include <linux/delay.h>
+#include <linux/mutex.h>
+#include <linux/power_supply.h>
+#include <linux/rfkill.h>
+
+#include "ctn730.h"
+#include "ctn730_i2c.h"
+#include "ctn730_supply.h"
+
+/* string format is "%02x " for each byte */
+static char marker_uid_str[CTN730_MARKER_UID_SIZE * 3 + 1];
+
+static bool ctn730_supply_is_present(struct ctn730 *ctn730)
+{
+	bool present;
+
+	mutex_lock(&ctn730->lock);
+
+	switch (ctn730->state) {
+	case state_device_detected:
+	case state_device_paused:
+	case state_charging_data_channel_established:
+	case state_app_data_channel_established:
+		present = true;
+		break;
+	case state_download_mode:
+	case state_initialized:
+	case state_device_detection:
+	case state_unknown:
+	case state_shutdown:
+		present = false;
+		goto done;
+	}
+
+	switch (ctn730->device_state) {
+	case device_state_device_detected:
+	case device_state_device_deactivated:
+	case device_state_device_version_mismatch:
+	case device_state_device_docked:
+	case device_state_battery_full:
+	case device_state_charge_failure:
+	case device_state_ndef_mode:
+	case device_state_listener_ot:
+		present = true;
+		break;
+	case device_state_fo_present:
+	case device_state_device_lost:
+	case device_state_unknown:
+	case device_state_device_undocked:
+		present = false;
+		break;
+	}
+
+done:
+	mutex_unlock(&ctn730->lock);
+
+	return present;
+}
+
+static int ctn730_supply_battery_level(struct ctn730 *ctn730)
+{
+	int level;
+
+	if (!ctn730_supply_is_present(ctn730))
+		return 0;
+
+	level = READ_ONCE(ctn730->battery_level);
+
+	return level > 0 ? level : 0;
+}
+
+static int ctn730_supply_capacity_level(struct ctn730 *ctn730)
+{
+	int level;
+
+	if (!ctn730_supply_is_present(ctn730))
+		return POWER_SUPPLY_CAPACITY_LEVEL_UNKNOWN;
+
+	mutex_lock(&ctn730->lock);
+	if (ctn730->battery_level != -1)
+		level = POWER_SUPPLY_CAPACITY_LEVEL_NORMAL;
+	else
+		level = POWER_SUPPLY_CAPACITY_LEVEL_UNKNOWN;
+	mutex_unlock(&ctn730->lock);
+
+	return level;
+}
+
+static int ctn730_supply_marker_uid(struct ctn730 *ctn730, union power_supply_propval *val)
+{
+	int i;
+
+	mutex_lock(&ctn730->lock);
+	for (i = 0; i < sizeof(ctn730->marker_uid); i++)
+		sprintf(&marker_uid_str[i * 3], "%02x ", ctn730->marker_uid[i]);
+	mutex_unlock(&ctn730->lock);
+
+	val->strval = marker_uid_str;
+
+	return 0;
+}
+
+static  int ctn730_supply_charging_state(struct ctn730 *ctn730)
+{
+	int state = POWER_SUPPLY_STATUS_UNKNOWN;
+
+	if (!ctn730_supply_is_present(ctn730))
+		return state;
+
+	mutex_lock(&ctn730->lock);
+	switch (ctn730->charging_state) {
+	case charging_state_charging_started:
+		state = POWER_SUPPLY_STATUS_CHARGING;
+		break;
+	case charging_state_charging_ended:
+		state = POWER_SUPPLY_STATUS_FULL;
+		break;
+	case charging_state_charging_stopped:
+		state = POWER_SUPPLY_STATUS_NOT_CHARGING;
+		break;
+	case charging_state_unknown:
+	default:
+		state = POWER_SUPPLY_STATUS_UNKNOWN;
+		break;
+	}
+	mutex_unlock(&ctn730->lock);
+
+	return state;
+}
+
+static int ctn730_supply_get_prop(struct power_supply *psy,
+				  enum power_supply_property psp,
+				  union power_supply_propval *val)
+{
+	struct ctn730 *ctn730 = dev_get_drvdata(psy->dev.parent);
+
+	if (psp == POWER_SUPPLY_PROP_STATUS) {
+		val->intval = ctn730_supply_charging_state(ctn730);
+	} else if (psp == POWER_SUPPLY_PROP_CAPACITY) {
+		val->intval = ctn730_supply_battery_level(ctn730);
+	} else if (psp == POWER_SUPPLY_PROP_CAPACITY_LEVEL) {
+		val->intval = ctn730_supply_capacity_level(ctn730);
+	} else if (psp == POWER_SUPPLY_PROP_PRESENT) {
+		val->intval = ctn730_supply_is_present(ctn730);
+	} else if (psp == POWER_SUPPLY_PROP_SERIAL_NUMBER) {
+		ctn730_supply_marker_uid(ctn730, val);
+	} else if (psp == POWER_SUPPLY_PROP_ONLINE) {
+		mutex_lock(&ctn730->lock);
+		if (ctn730->state == state_shutdown)
+			val->intval = 0; /* offline */
+		else
+			val->intval = 1; /* Online Fixed - Fixed Voltage Supply */
+		mutex_unlock(&ctn730->lock);
+	}
+
+	return 0;
+}
+
+static enum power_supply_property ctn730_supply_props[] = {
+	POWER_SUPPLY_PROP_PRESENT,
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_CAPACITY,
+	POWER_SUPPLY_PROP_CAPACITY_LEVEL,
+	POWER_SUPPLY_PROP_SERIAL_NUMBER,
+	POWER_SUPPLY_PROP_ONLINE,
+};
+
+static const struct power_supply_desc ctn730_supply_desc = {
+	.name                   = "nfc-marker-battery",
+	.type                   = POWER_SUPPLY_TYPE_WIRELESS,
+	.properties             = ctn730_supply_props,
+	.num_properties         = ARRAY_SIZE(ctn730_supply_props),
+	.get_property           = ctn730_supply_get_prop,
+};
+
+void ctn730_supply_changed(struct ctn730 *ctn730)
+{
+	if (!ctn730->supply)
+		return;
+
+	power_supply_changed(ctn730->supply);
+}
+
+int ctn730_supply_init(struct ctn730 *ctn730)
+{
+	ctn730->supply = devm_power_supply_register(ctn730->dev,
+						    &ctn730_supply_desc, NULL);
+	if (IS_ERR(ctn730->supply)) {
+		dev_err(ctn730->dev, "failed to create power-supply\n");
+		return PTR_ERR(ctn730->supply);
+	}
+
+	return 0;
+}
