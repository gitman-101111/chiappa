+
+int ctn730_i2c_read_parameter(struct ctn730 *ctn730, struct parameter *parameter, bool session)
+{
+	struct ctn730_msg msg;
+	int ret;
+
+	dev_dbg(ctn730->dev, "sending WLC_HOST_CTRL_READ_PARAMETER_CMD\n");
+
+	msg.header.msg_type = MSG_TYPE_CMD;
+	if (session) {
+		msg.header.instr = WLC_HOST_CTRL_READ_SESSION_PARAMETER;
+	} else {
+		msg.header.instr = WLC_HOST_CTRL_READ_PARAMETER;
+		if (ctn730->state != state_initialized)
+			dev_err(ctn730->dev, "%s in illegal state: %s",
+				__func__, ctn730_state_text[ctn730->state]);
+	}
+	msg.header.len = 1;
+	msg.payload[0] = parameter->tag;
+
+	parameter->len = 0;
+
+	ret = ctn730_i2c_send_wait_rsp(ctn730, &msg);
+	if (ret < 0)
+		return -EIO;
+
+	mutex_lock(&ctn730->lock);
+
+	parameter->status = msg.status;
+	parameter->len = msg.header.len - 1;
+	memcpy(parameter->data, &msg.payload[1], parameter->len);
+
+	mutex_unlock(&ctn730->lock);
+	return 0;
+}
+
+int ctn730_i2c_write_parameter(struct ctn730 *ctn730, struct parameter *parameter, int len,
+			       bool session)
+{
+	struct ctn730_msg msg;
+	int ret;
+
+	lockdep_assert_held(&ctn730->req_lock);
+
+	if (session) {
+		dev_dbg(ctn730->dev, "sending WLC_HOST_CTRL_WRITE_SESSION_PARAMETER_CMD\n");
+	} else {
+		dev_dbg(ctn730->dev, "sending WLC_HOST_CTRL_WRITE_PARAMETER_CMD\n");
+		if (ctn730->state != state_initialized)
+			dev_err(ctn730->dev, "%s in illegal state %s",
+				__func__, ctn730_state_text[ctn730->state]);
+	}
+
+	msg.header.msg_type = MSG_TYPE_CMD;
+	if (session)
+		msg.header.instr = WLC_HOST_CTRL_WRITE_SESSION_PARAMETER;
+	else
+		msg.header.instr = WLC_HOST_CTRL_WRITE_PARAMETER;
+	msg.header.len = len + 1;
+	msg.payload[0] = parameter->tag;
+	memcpy(&msg.payload[1], parameter->data, len);
+
+	ret = ctn730_i2c_send_wait_rsp_timeout_locked(ctn730, &msg, MSG_DEFAULT_TIMEOUT);
+	if (ret < 0)
+		return -EIO;
+
+	parameter->status = msg.status;
+
+	return 0;
+}
+
+int ctn730_enable_charging_info_event(struct ctn730 *ctn730, bool enable)
+{
+	struct parameter param;
+	int ret;
+
+	param.tag = PARAM_SESSION_SEND_CHARGING_INFO_EVT;
+	param.len = 1;
+	if (enable)
+		param.data[0] = PARAM_SEND_CHARGING_INFO_EVT_ENABLE;
+	else
+		param.data[0] = PARAM_SEND_CHARGING_INFO_EVT_DISABLE;
+
+	ret = ctn730_i2c_write_parameter(ctn730, &param, param.len, true);
+
+	if (ret < 0) {
+		dev_warn(ctn730->dev, "Failed to set charging info parameter: %d\n", ret);
+		return -EIO;
+	}
+
+	return 0;
+}
