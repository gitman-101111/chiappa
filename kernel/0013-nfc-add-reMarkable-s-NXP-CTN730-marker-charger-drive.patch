+int ctn730_i2c_detection(struct ctn730 *ctn730, int period_ms, bool enable)
+{
+	struct ctn730_msg msg;
+	int ret;
+
+	if (enable) {
+		dev_dbg(ctn730->dev, "sending WLC_CHG_CTRL_ENABLE_CMD\n");
+		msg.header.msg_type = MSG_TYPE_CMD;
+		msg.header.instr = WLC_CHG_CTRL_ENABLE;
+		msg.header.len = 2;
+		msg.payload[1] = (period_ms >> 8) & 0xFF;
+		msg.payload[0] = period_ms & 0xFF;
+	} else {
+		dev_dbg(ctn730->dev, "sending WLC_CHG_CTRL_DISABLE_CMD\n");
+		msg.header.msg_type = MSG_TYPE_CMD;
+		msg.header.instr = WLC_CHG_CTRL_DISABLE;
+		msg.header.len = 0;
+	}
+
+	ret = ctn730_i2c_send_wait_rsp(ctn730, &msg);
+	if (ret < 0)
+		return -EIO;
+
+	/*
+	 * Enabling detection is confirmed by WLC_CHG_CTRL_ENABLE_RSP,
+	 * while disabling detection is confirmed by WLC_CHG_CTRL_ENABLE_EVT
+	 * State transition to initialized is handled by the event handler
+	 */
+	if (enable) {
+		mutex_lock(&ctn730->lock);
+		ctn730_set_state(ctn730, state_device_detection);
+		mutex_unlock(&ctn730->lock);
+	}
+
+	return 0;
+}
+
+int ctn730_i2c_get_battery_level(struct ctn730 *ctn730)
+{
+	struct ctn730_msg msg;
+	int ret;
+
+	dev_dbg(ctn730->dev, "sending WLC_HOST_CTRL_DUMP_STATUS_CMD, DEVICE_BATTERY_LEVEL\n");
+
+	msg.header.msg_type = MSG_TYPE_CMD;
+	msg.header.instr = WLC_HOST_CTRL_DUMP_STATUS;
+	msg.header.len = 1;
+	msg.payload[0] = DEVICE_BATTERY_LEVEL;
+
+	ret = ctn730_i2c_send_wait_rsp(ctn730, &msg);
+	if (ret < 0)
+		return ret;
+
+	mutex_lock(&ctn730->lock);
+	if (msg.payload[3] == 0xAB)
+		/* The value 0xAB indicates that the battery level is not available. */
+		ctn730_set_battery_level(ctn730, -1);
+	else
+		ctn730_set_battery_level(ctn730, msg.payload[3]);
+	mutex_unlock(&ctn730->lock);
+
+	return 0;
+}
