+	msg.header.instr = WLC_HOST_CTRL_DL_READ_UID;
+	msg.header.len = 0;
+
+	ret = ctn730_i2c_send_wait_rsp(ctn730, &msg);
+	if (ret < 0)
+		return -EIO;
+
+	mutex_lock(&ctn730->lock);
+	memcpy(ctn730->host_uid, &msg.payload[1], sizeof(ctn730->host_uid));
+	mutex_unlock(&ctn730->lock);
+
+	return 0;
