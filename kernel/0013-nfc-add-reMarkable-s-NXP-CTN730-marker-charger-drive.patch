+int ctn730_i2c_read_status(struct ctn730 *ctn730, struct status *status)
+{
+	struct ctn730_msg msg;
+	int ret;
+
+	dev_dbg(ctn730->dev, "sending WLC_HOST_CTRL_DUMP_STATUS_CMD\n");
+
+	msg.header.msg_type = MSG_TYPE_CMD;
+	msg.header.instr = WLC_HOST_CTRL_DUMP_STATUS;
+	msg.header.len = 1;
+	msg.payload[0] = status->tag;
+
+	ret = ctn730_i2c_send_wait_rsp(ctn730, &msg);
+	if (ret < 0)
+		return -EIO;
+
+	status->status = msg.status;
+
+	status->tag = msg.payload[1];
+	status->len = msg.payload[2];
+	memcpy(status->data, &msg.payload[3], status->len);
+
+	return 0;
+}
