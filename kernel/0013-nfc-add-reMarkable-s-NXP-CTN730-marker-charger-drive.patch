+int ctn730_i2c_enable_app_data_channel(struct ctn730 *ctn730)
+{
+	struct ctn730_msg msg;
+	int ret;
+
+	if (ctn730->state == state_app_data_channel_established)
+		return 0;
+
+	dev_dbg(ctn730->dev, "enable app data channel attempt\n");
+
+	msg.header.msg_type = MSG_TYPE_CMD;
+	msg.header.instr = WLC_APP_CTRL_CHANNEL_ENABLE;
+	msg.header.len = 0;
+
+	set_bit(CTN730_APP_DATA_STATE_CHANGE, &ctn730->flags);
+
+	ret = ctn730_i2c_send_wait_rsp(ctn730, &msg);
+	if (ret < 0)
+		return -EIO;
+
+	if (wait_on_bit_timeout(&ctn730->flags, CTN730_APP_DATA_STATE_CHANGE,
+				TASK_INTERRUPTIBLE, msecs_to_jiffies(1000))) {
+		dev_err(ctn730->dev, "did not receive app_data_state_change evt\n");
+		return -EIO;
+	}
+
+	if (ctn730->app_data_state != app_data_state_connected) {
+		dev_err(ctn730->dev, "failed to enable app data channel\n");
+		return -EIO;
+	}
+
+	return 0;
+}
+
+int ctn730_i2c_disable_app_data_channel(struct ctn730 *ctn730)
+{
+	struct ctn730_msg msg;
+	int ret;
+
+	if (ctn730->state != state_app_data_channel_established)
+		return 0;
+
+	dev_dbg(ctn730->dev, "disable app data channel attempt\n");
+
+	msg.header.msg_type = MSG_TYPE_CMD;
+	msg.header.instr = WLC_APP_CTRL_CHANNEL_DISABLE;
+	msg.header.len = 0;
+
+	set_bit(CTN730_APP_DATA_STATE_CHANGE, &ctn730->flags);
+
+	ret = ctn730_i2c_send_wait_rsp(ctn730, &msg);
+	if (ret < 0)
+		return -EIO;
+
+	if (wait_on_bit_timeout(&ctn730->flags, CTN730_APP_DATA_STATE_CHANGE, TASK_INTERRUPTIBLE,
+				msecs_to_jiffies(1000))) {
+		dev_err(ctn730->dev, "disable_app_data_channel: did not receive app_data_state_change evt\n");
+		return -EIO;
+	}
+
+	if (ctn730->app_data_state != app_data_state_disconnected) {
+		dev_err(ctn730->dev, "failed to disable app data channel\n");
+		dev_dbg(ctn730->dev, "state: %s\n",
+			ctn730_app_data_state_text[ctn730->app_data_state]);
+		return -EIO;
+	}
+
+	return 0;
+}
+
+int ctn730_i2c_send_app_data(struct ctn730 *ctn730, char *data, int len)
+{
+	struct ctn730_msg msg;
+	int ret;
+
+	dev_dbg(ctn730->dev, "sending WLC_APP_CTRL_SEND_DATA_CMD\n");
+
+	msg.header.msg_type = MSG_TYPE_CMD;
+	msg.header.instr = WLC_APP_CTRL_SEND_DATA;
+	msg.header.len = len + 1; /* +1 for Last Packet/Chained */
+	msg.payload[0] = LAST_PACKET;
+	memcpy(&msg.payload[1], data, len);
+
+	set_bit(CTN730_APP_DATA_SENT, &ctn730->flags);
+
+	ret = ctn730_i2c_send_wait_rsp_timeout(ctn730, &msg, MSG_APP_CHANNEL_TIMEOUT);
+	if (ret < 0)
+		return ret;
+
+	/*
+	 * Response is received when the data has been received by the WLC-Host.
+	 * We need to wait for the event to be sure that the data has been sent to
+	 * Marker
+	 */
+	if (wait_on_bit_timeout(&ctn730->flags, CTN730_APP_DATA_SENT,
+				TASK_INTERRUPTIBLE, msecs_to_jiffies(500)))
+		return -EIO;
+
+	return 0;
+}
