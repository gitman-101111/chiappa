From ab37028c6323014ca7f92a1375584a951cddc2bd Mon Sep 17 00:00:00 2001
From: gitman-101111 <development@spamfolder.xyz>
Date: Mon, 12 Oct 2026 10:23:07 -0600
Subject: [PATCH] drm/bridge: imx: add the i.MX93 parallel display format
 converter

The i.MX93 media mix routes LCDIF output onto the parallel display pads
through a format converter selected by DISPLAY_MUX_CTRL in the block
control (RGB888 pass-through, RGB888 to RGB666, or RGB565). The device
tree already describes it as "nxp,imx93-pdfc", but without a driver the
LCDIF never finds a bridge on its output port.

Add a minimal bridge: negotiate the input bus format from the panel's
output format, program the mux on enable, and switch the pads between
their display and GPIO pinctrl states around enable/disable. Based on
NXP's downstream imx93-parallel-disp-fmt driver.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 drivers/gpu/drm/bridge/imx/Kconfig      |  10 ++
 drivers/gpu/drm/bridge/imx/Makefile     |   1 +
 drivers/gpu/drm/bridge/imx/imx93-pdfc.c | 223 ++++++++++++++++++++++++
 3 files changed, 234 insertions(+)
 create mode 100644 drivers/gpu/drm/bridge/imx/imx93-pdfc.c

diff --git a/drivers/gpu/drm/bridge/imx/Kconfig b/drivers/gpu/drm/bridge/imx/Kconfig
index 005a745e5..6b53cb9ce 100644
--- a/drivers/gpu/drm/bridge/imx/Kconfig
+++ b/drivers/gpu/drm/bridge/imx/Kconfig
@@ -96,6 +96,16 @@ config DRM_IMX8QXP_PIXEL_LINK_TO_DPI
 	  Choose this to enable pixel link to display pixel interface(PXL2DPI)
 	  found in Freescale i.MX8qxp processor.
 
+config DRM_IMX93_PDFC
+	tristate "Freescale i.MX93 parallel display format converter"
+	depends on OF
+	depends on COMMON_CLK
+	select DRM_KMS_HELPER
+	help
+	  Choose this to enable the parallel display format converter (PDFC)
+	  found in the Freescale i.MX93 media mix, which maps the LCDIF output
+	  onto the parallel display pads as RGB888, RGB666 or RGB565.
+
 config DRM_IMX93_MIPI_DSI
 	tristate "Freescale i.MX93 specific extensions for Synopsys DW MIPI DSI"
 	depends on OF
diff --git a/drivers/gpu/drm/bridge/imx/Makefile b/drivers/gpu/drm/bridge/imx/Makefile
index 94ac8c40e..419ff2449 100644
--- a/drivers/gpu/drm/bridge/imx/Makefile
+++ b/drivers/gpu/drm/bridge/imx/Makefile
@@ -9,4 +9,5 @@ obj-$(CONFIG_DRM_IMX8QXP_LDB) += imx8qxp-ldb.o
 obj-$(CONFIG_DRM_IMX8QXP_PIXEL_COMBINER) += imx8qxp-pixel-combiner.o
 obj-$(CONFIG_DRM_IMX8QXP_PIXEL_LINK) += imx8qxp-pixel-link.o
 obj-$(CONFIG_DRM_IMX8QXP_PIXEL_LINK_TO_DPI) += imx8qxp-pxl2dpi.o
+obj-$(CONFIG_DRM_IMX93_PDFC) += imx93-pdfc.o
 obj-$(CONFIG_DRM_IMX93_MIPI_DSI) += imx93-mipi-dsi.o
diff --git a/drivers/gpu/drm/bridge/imx/imx93-pdfc.c b/drivers/gpu/drm/bridge/imx/imx93-pdfc.c
new file mode 100644
index 000000000..bf92aff8e
--- /dev/null
+++ b/drivers/gpu/drm/bridge/imx/imx93-pdfc.c
@@ -0,0 +1,223 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * i.MX93 Parallel Display Format Converter (PDFC) bridge.
+ *
+ * The LCDIF scans out 24-bit pixels; a register in the MEDIAMIX block
+ * control selects how they are mapped onto the parallel display pads
+ * (RGB888 pass-through, RGB888 reduced to RGB666, or RGB565). This driver
+ * programs that register from the bus format negotiated with the panel and
+ * switches the pads between their display and GPIO pinctrl states.
+ *
+ * Derived from NXP's downstream imx93-parallel-disp-fmt driver.
+ *
+ * Copyright 2022 NXP
+ */
+
+#include <linux/bitfield.h>
+#include <linux/media-bus-format.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/pinctrl/consumer.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+
+#include <drm/drm_atomic.h>
+#include <drm/drm_atomic_helper.h>
+#include <drm/drm_bridge.h>
+#include <drm/drm_of.h>
+
+#define DISPLAY_MUX_CTRL		0x60
+#define  PARALLEL_DISP_FORMAT_MASK	GENMASK(10, 8)
+#define  RGB888_TO_RGB888		0x0
+#define  RGB888_TO_RGB666		0x1
+#define  RGB565_TO_RGB565		0x2
+
+struct imx93_pdfc {
+	struct drm_bridge bridge;
+	struct drm_bridge *next_bridge;
+	struct device *dev;
+	struct regmap *regmap;
+	struct pinctrl *pinctrl;
+	struct pinctrl_state *default_state;
+	struct pinctrl_state *gpio_state;
+};
+
+static inline struct imx93_pdfc *to_imx93_pdfc(struct drm_bridge *bridge)
+{
+	return container_of(bridge, struct imx93_pdfc, bridge);
+}
+
+static int imx93_pdfc_bridge_attach(struct drm_bridge *bridge,
+				    struct drm_encoder *encoder,
+				    enum drm_bridge_attach_flags flags)
+{
+	struct imx93_pdfc *pdfc = to_imx93_pdfc(bridge);
+
+	return drm_bridge_attach(encoder, pdfc->next_bridge, bridge, flags);
+}
+
+static int imx93_pdfc_format(u32 output_fmt, u32 *input_fmt)
+{
+	switch (output_fmt) {
+	case MEDIA_BUS_FMT_RGB565_1X16:
+		*input_fmt = MEDIA_BUS_FMT_RGB565_1X16;
+		return RGB565_TO_RGB565;
+	case MEDIA_BUS_FMT_RGB666_1X18:
+		*input_fmt = MEDIA_BUS_FMT_RGB888_1X24;
+		return RGB888_TO_RGB666;
+	case MEDIA_BUS_FMT_FIXED:
+	case MEDIA_BUS_FMT_RGB888_1X24:
+		*input_fmt = MEDIA_BUS_FMT_RGB888_1X24;
+		return RGB888_TO_RGB888;
+	default:
+		return -EINVAL;
+	}
+}
+
+static u32 *
+imx93_pdfc_bridge_atomic_get_input_bus_fmts(struct drm_bridge *bridge,
+					    struct drm_bridge_state *bridge_state,
+					    struct drm_crtc_state *crtc_state,
+					    struct drm_connector_state *conn_state,
+					    u32 output_fmt,
+					    unsigned int *num_input_fmts)
+{
+	u32 *input_fmts;
+	u32 input_fmt;
+
+	*num_input_fmts = 0;
+
+	if (imx93_pdfc_format(output_fmt, &input_fmt) < 0)
+		return NULL;
+
+	input_fmts = kmalloc(sizeof(*input_fmts), GFP_KERNEL);
+	if (!input_fmts)
+		return NULL;
+
+	input_fmts[0] = input_fmt;
+	*num_input_fmts = 1;
+
+	return input_fmts;
+}
+
+static void imx93_pdfc_bridge_atomic_enable(struct drm_bridge *bridge,
+					    struct drm_atomic_commit *state)
+{
+	struct imx93_pdfc *pdfc = to_imx93_pdfc(bridge);
+	struct drm_bridge_state *bridge_state;
+	u32 input_fmt;
+	int format;
+
+	bridge_state = drm_atomic_get_new_bridge_state(state, bridge);
+	format = imx93_pdfc_format(bridge_state->output_bus_cfg.format,
+				   &input_fmt);
+	if (format < 0) {
+		dev_err(pdfc->dev, "unsupported bus format 0x%x\n",
+			bridge_state->output_bus_cfg.format);
+		return;
+	}
+
+	regmap_update_bits(pdfc->regmap, DISPLAY_MUX_CTRL,
+			   PARALLEL_DISP_FORMAT_MASK,
+			   FIELD_PREP(PARALLEL_DISP_FORMAT_MASK, format));
+
+	pinctrl_select_state(pdfc->pinctrl, pdfc->default_state);
+}
+
+static void imx93_pdfc_bridge_atomic_disable(struct drm_bridge *bridge,
+					     struct drm_atomic_commit *state)
+{
+	struct imx93_pdfc *pdfc = to_imx93_pdfc(bridge);
+
+	if (pdfc->gpio_state)
+		pinctrl_select_state(pdfc->pinctrl, pdfc->gpio_state);
+}
+
+static const struct drm_bridge_funcs imx93_pdfc_bridge_funcs = {
+	.attach			= imx93_pdfc_bridge_attach,
+	.atomic_duplicate_state	= drm_atomic_helper_bridge_duplicate_state,
+	.atomic_destroy_state	= drm_atomic_helper_bridge_destroy_state,
+	.atomic_reset		= drm_atomic_helper_bridge_reset,
+	.atomic_get_input_bus_fmts = imx93_pdfc_bridge_atomic_get_input_bus_fmts,
+	.atomic_enable		= imx93_pdfc_bridge_atomic_enable,
+	.atomic_disable		= imx93_pdfc_bridge_atomic_disable,
+};
+
+static int imx93_pdfc_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *np = dev->of_node;
+	struct imx93_pdfc *pdfc;
+
+	pdfc = devm_drm_bridge_alloc(dev, struct imx93_pdfc, bridge,
+				     &imx93_pdfc_bridge_funcs);
+	if (IS_ERR(pdfc))
+		return PTR_ERR(pdfc);
+
+	pdfc->dev = dev;
+
+	pdfc->regmap = syscon_node_to_regmap(np->parent);
+	if (IS_ERR(pdfc->regmap))
+		return dev_err_probe(dev, PTR_ERR(pdfc->regmap),
+				     "failed to get regmap\n");
+
+	pdfc->pinctrl = devm_pinctrl_get(dev);
+	if (IS_ERR(pdfc->pinctrl))
+		return dev_err_probe(dev, PTR_ERR(pdfc->pinctrl),
+				     "failed to get pinctrl\n");
+
+	pdfc->default_state = pinctrl_lookup_state(pdfc->pinctrl, "default");
+	if (IS_ERR(pdfc->default_state))
+		return dev_err_probe(dev, PTR_ERR(pdfc->default_state),
+				     "failed to find default pinctrl state\n");
+
+	pdfc->gpio_state = pinctrl_lookup_state(pdfc->pinctrl, "gpio");
+	if (IS_ERR(pdfc->gpio_state))
+		pdfc->gpio_state = NULL;
+	else
+		pinctrl_select_state(pdfc->pinctrl, pdfc->gpio_state);
+
+	/* port@1 is the output port */
+	pdfc->next_bridge = devm_drm_of_get_bridge(dev, np, 1, 0);
+	if (IS_ERR(pdfc->next_bridge))
+		return dev_err_probe(dev, PTR_ERR(pdfc->next_bridge),
+				     "failed to get next bridge\n");
+
+	platform_set_drvdata(pdev, pdfc);
+
+	pdfc->bridge.of_node = np;
+	pdfc->bridge.type = DRM_MODE_CONNECTOR_DPI;
+
+	drm_bridge_add(&pdfc->bridge);
+
+	return 0;
+}
+
+static void imx93_pdfc_remove(struct platform_device *pdev)
+{
+	struct imx93_pdfc *pdfc = platform_get_drvdata(pdev);
+
+	drm_bridge_remove(&pdfc->bridge);
+}
+
+static const struct of_device_id imx93_pdfc_dt_ids[] = {
+	{ .compatible = "nxp,imx93-pdfc", },
+	{ .compatible = "nxp,imx91-pdfc", },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, imx93_pdfc_dt_ids);
+
+static struct platform_driver imx93_pdfc_driver = {
+	.probe	= imx93_pdfc_probe,
+	.remove	= imx93_pdfc_remove,
+	.driver	= {
+		.of_match_table = imx93_pdfc_dt_ids,
+		.name = "imx93-pdfc",
+	},
+};
+module_platform_driver(imx93_pdfc_driver);
+
+MODULE_DESCRIPTION("i.MX93 parallel display format converter bridge driver");
+MODULE_AUTHOR("NXP Semiconductor");
+MODULE_LICENSE("GPL");
