+/* Charger register bit for special use in FG thermal zone device
+ * This is to allow for powering device with only usb, but at the same time
+ * limiting the charger current/voltage. The IC does not support interrupt on
+ * values below 0C, so it is not able to transition into correct cooling trip
+ * when sudden jump in negative temperature.
+ * This happens in an open circuit NTC event.
+ */
+#define REG_CHG_CNFG_02			0xB9
+#define BIT_CHG_CC			GENMASK(5, 0)
+#define REG_CHG_CNFG_04			0xBB
+#define BIT_CHG_CV_PRM			GENMASK(5, 0)
+
+static int max77818_fg_tzd_read_temp(struct thermal_zone_device *tzd, int *temp)
+{
+	struct max77818_chip *chip = thermal_zone_device_priv(tzd);
+	struct max77818_dev *max77818 = chip->max77818_dev;
+	int ret;
+
+	ret = max77818_get_temperature(chip, temp);
+	if (ret)
+		return ret;
+
+	/* No battery - No NTC */
+	if (*temp < -100) {
+		regmap_update_bits(max77818->regmap_chg, REG_CHG_CNFG_02, BIT_CHG_CC, 0x0);
+		regmap_update_bits(max77818->regmap_chg, REG_CHG_CNFG_04, BIT_CHG_CV_PRM, 0x0);
+		*temp = THERMAL_TEMP_INVALID;
+		return ret;
+	}
+
+	/* Convert 0.1 degree Celsius to milli degree Celsius. */
+	*temp *= 100;
+
+	return ret;
+}
+
+static int max77818_fg_tzd_set_trips(struct thermal_zone_device *tzd, int low, int high)
+{
+	struct max77818_chip *chip = thermal_zone_device_priv(tzd);
+	u32 val;
+
+	/* MinTempAlrt */
+	if (low < 0)
+		val |= 0x80; /* Disable the alert */
+	else
+		val = (low / 1000) & 0xFF;
+
+	/* MaxTempAlrt */
+	val |= ((high / 1000) & 0xFF) << 8;
+
+	chip->talrth_cached = val;
+
+	regmap_write(chip->regmap, MAX17042_TALRT_Th, val);
+
+	return 0;
+}
+
+static struct thermal_zone_device_ops max77818_fg_tzd_ops = {
+	.get_temp = max77818_fg_tzd_read_temp,
+	.set_trips = max77818_fg_tzd_set_trips,
+};
+
+static int max77818_init_fg_interrupt_handling(struct max77818_dev *max77818,
+						struct max77818_chip *chip)
+{
+	struct device *dev = chip->dev;
+	int ret;
+	u32 val;
+
+	/* Enable temperature alert */
+	regmap_update_bits(chip->regmap, MAX77818_Config2, CONFIG2_TALRTEN, CONFIG2_TALRTEN);
+
+	/* Enable SOC 1% change alert */
+	regmap_set_bits(chip->regmap, MAX77818_Config2, CONFIG2_DSOCEN);
+
+	/* Set SAlrtTh */
+	val = chip->pdata->min_soc_alrt;
+	val |= chip->pdata->max_soc_alrt << 8;
+	regmap_write(chip->regmap, MAX17042_SALRT_Th, val);
+
+	chip->soc_min_cached = chip->pdata->min_soc_alrt;
+	chip->soc_max_cached = chip->pdata->max_soc_alrt;
+
+	/* Register irq handler for the FG interrupt */
+	chip->fg_irq = regmap_irq_get_virq(max77818->irqc_intsrc,
+					   MAX77818_FG_INT);
+	if (chip->fg_irq <= 0) {
+		dev_err(dev, "failed to get virq: %d\n", chip->fg_irq);
+		return -ENODEV;
+	}
+
+	ret = devm_request_threaded_irq(dev, chip->fg_irq, NULL,
+					max77818_fg_isr, 0,
+					chip->battery->desc->name,
+					chip);
+	if (ret) {
+		dev_err(dev, "failed to request irq: %d\n", ret);
+		return ret;
+	}
+
+	return 0;
+}
