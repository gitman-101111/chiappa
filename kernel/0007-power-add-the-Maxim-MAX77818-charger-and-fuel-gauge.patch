+static const char *max77818_battery_status_str(int status)
+{
+	switch (status) {
+	case POWER_SUPPLY_STATUS_CHARGING:
+		return "charging";
+	case POWER_SUPPLY_STATUS_DISCHARGING:
+		return "discharging";
+	case POWER_SUPPLY_STATUS_NOT_CHARGING:
+		return "not-charging";
+	case POWER_SUPPLY_STATUS_FULL:
+		return "full";
+	default:
+		return "unknown";
+	}
+}
