+static void max77818_log_battery_status(struct max77818_chip *chip)
+{
+	int err;
+	union power_supply_propval capacity;
+	union power_supply_propval status;
+
+	err = max77818_get_property(chip->battery,
+				    POWER_SUPPLY_PROP_CAPACITY_HIRES,
+				    &capacity);
+	if (err)
+		capacity.strval = "NA";
+
+	err = max77818_get_property(chip->battery,
+				    POWER_SUPPLY_PROP_STATUS,
+				    &status);
+	if (err)
+		status.intval = POWER_SUPPLY_STATUS_UNKNOWN;
+
+	dev_info(chip->dev, "Battery capacity: %s, Status: %s (%d)\n",
+		 capacity.strval, max77818_battery_status_str(status.intval), status.intval);
+}
+
+/* Charger register bit for special use in FG sys off handler */
+#define REG_CHG_INT_OK		0xB2
+#define BIT_CHGIN_OK		BIT(6)
+
+static int max77818_sys_off_handler(struct sys_off_data *sysoff)
+{
+	struct max77818_chip *chip = sysoff->cb_data;
+	struct max77818_dev *max77818 = chip->max77818_dev;
+	u32 val;
+
+	regmap_read(max77818->regmap_chg, REG_CHG_INT_OK, &val);
+	if (val & BIT_CHGIN_OK) {
+		dev_info(chip->dev, "Enable FGCC for charging in poweroff\n");
+
+		/* Set vbus limit to a safe/high value (3.2 A) to avoid vbus cut */
+		if (chip->vbus_limit)
+			regulator_set_current_limit(chip->vbus_limit, 0, 3200 * 1000);
+
+		regmap_set_bits(chip->regmap, MAX17042_CONFIG, CONFIG_SPR_11);
+
+		/* Wait a bit for kernel messages to be seen */
+		msleep(50);
+	}
+
+	return 0;
+}
