+static int max77818_probe(struct platform_device *pdev)
+{
+	struct max77818_dev *max77818 = dev_get_drvdata(pdev->dev.parent);
+	struct power_supply_config psy_cfg = {};
+	struct device *dev = &pdev->dev;
+	struct max77818_chip *chip;
+	u32 val;
+	int ret;
+
+	chip = devm_kzalloc(dev, sizeof(*chip), GFP_KERNEL);
+	if (!chip)
+		return -ENOMEM;
+
+	mutex_init(&chip->lock);
+
+	chip->max77818_dev = max77818;
+	chip->dev = dev;
+	chip->regmap = max77818->regmap_fg;
+
+	chip->pdata = max77818_get_pdata(chip);
+	if (!chip->pdata) {
+		dev_err(dev, "no platform data provided\n");
+		return -EINVAL;
+	}
+
+	chip->vbus_limit = devm_regulator_get_optional(dev, "vbus-limit");
+	if (IS_ERR(chip->vbus_limit)) {
+		if (PTR_ERR(chip->vbus_limit) == -EPROBE_DEFER)
+			return -EPROBE_DEFER;
+
+		chip->vbus_limit = NULL;
+	}
+
+	/* Get non device related driver config from DT */
+	max77818_get_driver_config(chip);
+
+	platform_set_drvdata(pdev, chip);
+	psy_cfg.drv_data = chip;
+	psy_cfg.fwnode = dev_fwnode(dev);
+	psy_cfg.attr_grp = max77818_groups;
+
+	chip->battery = devm_power_supply_register(dev, &max77818_psy_desc,
+						   &psy_cfg);
+
+	if (IS_ERR(chip->battery)) {
+		ret = PTR_ERR(chip->battery);
+		dev_err_probe(dev, ret, "failed to register supply: %d \n", ret);
+		return ret;
+	}
+
+	chip->tzd = devm_thermal_of_zone_register(dev, 0, chip, &max77818_fg_tzd_ops);
+	if (IS_ERR(chip->tzd))
+		return dev_err_probe(dev, PTR_ERR(chip->tzd), "failed to register thermal zone\n");
+
+	regmap_read(chip->regmap, MAX17042_STATUS, &val);
+	if (val & STATUS_POR) {
+		ret = max77818_init_chip(chip);
+		if (ret) {
+			dev_err(chip->dev, "failed to init chip: %d\n", ret);
+			return ret;
+		}
+	}
+
+	ret = max77818_set_temperature_parameters(chip);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to set temperature parameters\n");
+
+	ret = max77818_init_fg_interrupt_handling(max77818, chip);
+	if (ret) {
+		dev_err(dev, "Failed to init FG interrupt handling\n");
+		return ret;
+	}
+
+	ret = devm_register_sys_off_handler(dev,
+					    SYS_OFF_MODE_POWER_OFF_PREPARE,
+					    SYS_OFF_PRIO_DEFAULT,
+					    max77818_sys_off_handler, chip);
+	if (ret) {
+		dev_err(dev, "Failed to register FG sys off handlder\n");
+		return ret;
+	}
+
+	device_init_wakeup(chip->dev, true);
+
+	max77818_log_battery_status(chip);
+
+	max77818_debugfs_add(chip);
+
+	return 0;
+}
+
+static void max77818_remove(struct platform_device *pdev)
+{
+	struct max77818_chip *chip = platform_get_drvdata(pdev);
+
+	max77818_debugfs_remove(chip);
+}
+
+static void max77818_recover_threshold_registers(struct max77818_chip *chip)
+{
+	u16 prev;
+	u32 cur;
+	int ret;
+	bool recovered = false;
+
+	/* Recover SAlrtTh */
+	prev = chip->soc_min_cached;
+	prev |= chip->soc_max_cached << 8;
+
+	ret = regmap_read(chip->regmap, MAX17042_SALRT_Th, &cur);
+	if (!ret && (cur != prev)) {
+		regmap_write(chip->regmap, MAX17042_SALRT_Th, prev);
+		dev_warn(chip->dev, "recovered SALRTTH %4x/%4x\n", prev, cur);
+		recovered = true;
+	}
+
+	/* Recover VAlrtTh */
+	max77818_read_of_property(chip, "maxim,valrtth", &prev);
+	ret = regmap_read(chip->regmap, MAX17042_VALRT_Th, &cur);
+	if (!ret && (cur != prev)) {
+		regmap_write(chip->regmap, MAX17042_VALRT_Th, prev);
+		dev_warn(chip->dev, "recovered VALRTTH %4x/%4x\n", prev, cur);
+		recovered = true;
+	}
+
+	/* Recover TAlrtTh */
+	prev = chip->talrth_cached;
+	ret = regmap_read(chip->regmap, MAX17042_TALRT_Th, &cur);
+	if (!ret && (cur != prev)) {
+		regmap_write(chip->regmap, MAX17042_TALRT_Th, prev);
+		dev_warn(chip->dev, "recovered TALRTTH %4x/%4x\n", prev, cur);
+		recovered = true;
+	}
+
+	/*
+	 * In case the interrupt was triggered because of wrong values,
+	 * sleep 200ms to let the interrupt release after we set
+	 * correct values. The IC has some internal timer, so this is not an
+	 * instant operation.
+	 */
+	if (recovered)
+		msleep(200);
+}
+
+static int max77818_fg_suspend(struct device *dev)
+{
+	struct max77818_chip *chip = dev_get_drvdata(dev);
+
+	disable_irq(chip->fg_irq);
+
+	return 0;
+}
+
+static int max77818_fg_resume(struct device *dev)
+{
+	struct max77818_chip *chip = dev_get_drvdata(dev);
+
+	max77818_recover_threshold_registers(chip);
+
+	enable_irq(chip->fg_irq);
+
+	return 0;
+}
+
+static int max77818_fg_suspend_noirq(struct device *dev)
+{
+	struct max77818_chip *chip = dev_get_drvdata(dev);
+
+	/*
+	 * Enable MAX77818 FG_INT at .noirq stage for wakeup, so that even if
+	 * there is an alert pending, FG driver won't be handling it.
+	 */
+	if (device_may_wakeup(dev)) {
+		/* We do not want to wake up on every 1% SOC drop */
+		regmap_clear_bits(chip->regmap, MAX77818_Config2, CONFIG2_DSOCEN);
+		max77818_unmask_intsrc(chip->max77818_dev, MAX77818_FG_INT);
+	}
+
+	return 0;
+}
+
+static int max77818_fg_resume_noirq(struct device *dev)
+{
+	struct max77818_chip *chip = dev_get_drvdata(dev);
+
+	if (device_may_wakeup(dev)) {
+		max77818_mask_intsrc(chip->max77818_dev, MAX77818_FG_INT);
+		regmap_set_bits(chip->regmap, MAX77818_Config2, CONFIG2_DSOCEN);
+	}
+
+	return 0;
+}
+
+static const struct dev_pm_ops max77818_fg_pm = {
+	SET_SYSTEM_SLEEP_PM_OPS(max77818_fg_suspend, max77818_fg_resume)
+	.suspend_noirq = max77818_fg_suspend_noirq,
+	.resume_noirq = max77818_fg_resume_noirq,
+};
+
+static const struct platform_device_id max77818_fg_id_table[] = {
+	{ MAX77818_FUELGAUGE_NAME },
+	{ }
+};
+MODULE_DEVICE_TABLE(platform, max77818_fg_id_table);
+
+static struct of_device_id max77818_fg_of_match[] = {
+	{ .compatible = "maxim,max77818-fuelgauge" },
+	{ },
+};
+MODULE_DEVICE_TABLE(of, max77818_fg_of_match);
+
+static struct platform_driver max77818_fg_driver = {
+	.driver = {
+		.name = MAX77818_FUELGAUGE_NAME,
+		.owner = THIS_MODULE,
+		.of_match_table = max77818_fg_of_match,
+		.pm = &max77818_fg_pm,
+	},
+	.probe = max77818_probe,
+	.remove = max77818_remove,
+	.id_table = max77818_fg_id_table,
+};
+module_platform_driver(max77818_fg_driver);
+
+MODULE_DESCRIPTION("MAX77818 Fuel Gauge");
+MODULE_LICENSE("GPL");
