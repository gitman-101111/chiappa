+static irqreturn_t max77818_fg_isr(int id, void *dev)
+{
+	struct max77818_chip *chip = dev;
+	struct power_supply *psy = chip->battery;
+	u32 val;
+	int ret;
+
+	ret = regmap_read(chip->regmap, MAX17042_STATUS, &val);
+	if (ret || val == 0)
+		goto done;
+
+	if (val & STATUS_DSOCI) {
+		u32 repsoc = 0;
+		int err;
+		union power_supply_propval pval;
+
+		/* Clear alert */
+		regmap_update_bits(chip->regmap, MAX17042_STATUS, STATUS_DSOCI, 0);
+
+		/* Force shutdown on critical capacity when battery is present */
+		power_supply_get_property(psy, POWER_SUPPLY_PROP_PRESENT, &pval);
+		err = regmap_read(chip->regmap, MAX17042_RepSOC, &repsoc);
+		if (err != 0)
+			dev_err(chip->dev, "Failed to read repsoc: %d\n", err);
+		else
+			dev_info(chip->dev, "Battery SOC change %d\n", repsoc >> 8);
+
+		if ((repsoc >> 8) < chip->pdata->critical_soc && pval.intval == 1) {
+			dev_err(chip->dev, "Battery capacity critical. repsoc: %x\n", repsoc);
+			__hw_protection_trigger("Battery critical capacity", 10000, HWPROT_ACT_SHUTDOWN);
+		}
+	}
+
+	if (val & STATUS_SMN) {
+		dev_info(chip->dev, "Alert: MIN SOC\n");
+		/* Set MinSocAlrt 0 to stop the alert */
+		regmap_update_bits(chip->regmap, MAX17042_SALRT_Th, 0xff,
+				   MIN_SOC_ALRT_DISABLE);
+		/* MAX77818 needs some time to get SOC alert actually stopped */
+		msleep(50);
+	}
+
+	if (val & STATUS_SMX) {
+		dev_info(chip->dev, "Alert: MAX SOC\n");
+		/* Set MaxSocAlrt 255 to stop the alert */
+		regmap_update_bits(chip->regmap, MAX17042_SALRT_Th, 0xff00,
+				   MAX_SOC_ALRT_DISABLE << 8);
+		msleep(50);
+	}
+
+	if (val & STATUS_TMN) {
+		dev_info(chip->dev, "Alert: MIN Temperature\n");
+		/* Set MinTempAlrt 0x80 to disable the alert */
+		regmap_update_bits(chip->regmap, MAX17042_TALRT_Th, 0xff, 0x80);
+		/* MAX77818 needs some time to get the alert actually stopped */
+		msleep(50);
+		thermal_zone_device_update(chip->tzd, THERMAL_EVENT_UNSPECIFIED);
+	}
+
+	if (val & STATUS_TMX) {
+		dev_info(chip->dev, "Alert: MAX Temperature\n");
+		/* Set MaxTempAlrt 0x7f to disable the alert */
+		regmap_update_bits(chip->regmap, MAX17042_TALRT_Th, 0xff00, 0x7f00);
+		msleep(50);
+		thermal_zone_device_update(chip->tzd, THERMAL_EVENT_UNSPECIFIED);
+	}
+
+	if (val & STATUS_VMN) {
+		dev_info(chip->dev, "Alert: MIN Voltage\n");
+		/* Set MinVoltageAlrt 0x00 to disable the alert */
+		regmap_update_bits(chip->regmap, MAX17042_VALRT_Th, 0xff, 0x0);
+		msleep(50);
+	}
+
+	if (val & STATUS_VMX) {
+		dev_info(chip->dev, "Alert: MAX Voltage\n");
+		/* Set MaxVoltageAlrt 0xff to disable the alert */
+		regmap_update_bits(chip->regmap, MAX17042_VALRT_Th, 0xff00, 0xff00);
+		msleep(50);
+	}
+
+	power_supply_changed(psy);
+
+done:
+	/* throttle low level interrupt as it does not clear immediately.
+	 * Typically it takes around 200ms to clear, after MAX17042_STATUS
+	 * has been cleared.
+	 */
+	msleep(200);
+
+	return IRQ_HANDLED;
+}
