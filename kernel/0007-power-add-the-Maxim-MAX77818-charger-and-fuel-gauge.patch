+
+#ifdef CONFIG_DEBUG_FS
+static ssize_t max77818_debugfs_capacity_overrule_read(struct file *filp, char __user *buf,
+						       size_t size, loff_t *off)
+{
+	struct max77818_chip *chip = filp->private_data;
+	char buffer[6];
+
+	snprintf(buffer, sizeof(buffer), "%u\n", chip->capacity_overrule);
+	return simple_read_from_buffer(buf, size, off, buffer, strlen(buffer));
+}
+
+static ssize_t max77818_debugfs_capacity_overrule_write(struct file *filp, const char __user *buf,
+							size_t size, loff_t *off)
+{
+	struct max77818_chip *chip = filp->private_data;
+	unsigned long res;
+	char buffer[6];
+	ssize_t ret;
+
+	if (size >= sizeof(buffer))
+		return -EINVAL;
+
+	/* 'sizeof(buffer) - 1' to secure a string terminator */
+	memset(buffer, 0, sizeof(buffer));
+	ret = simple_write_to_buffer(buffer, sizeof(buffer) - 1, off, buf, size);
+	if (ret < 0)
+		return ret;
+
+	ret = kstrtoul(buffer, 0, &res);
+	if (ret)
+		return ret;
+
+	chip->capacity_overrule = res;
+	if (res && res < chip->pdata->critical_soc) {
+		dev_info(chip->dev,
+			 "Debugfs overrule 'Battery capacity critical'. capacity: %lu\n",
+			 res);
+		__hw_protection_trigger("Debugfs overrule 'Battery critical capacity'", 10000, HWPROT_ACT_SHUTDOWN);
+	}
+	power_supply_changed(chip->battery);
+
+	return size;
+}
+
+static const struct file_operations max77818_debugfs_capacity_overrule_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.read = max77818_debugfs_capacity_overrule_read,
+	.write = max77818_debugfs_capacity_overrule_write,
+};
+
+static void max77818_debugfs_add(struct max77818_chip *chip)
+{
+	int ret;
+
+	chip->debugfs_root = debugfs_create_dir(dev_name(chip->dev), NULL);
+	if (IS_ERR_OR_NULL(chip->debugfs_root)) {
+		dev_err(chip->dev, "Failed to make debugfs directory '%s' (err %ld)\n",
+			dev_name(chip->dev), PTR_ERR(chip->debugfs_root));
+		chip->debugfs_root = NULL;
+		return;
+	}
+
+	ret = PTR_ERR_OR_ZERO(debugfs_create_file("capacity_overrule",
+						  0644, chip->debugfs_root, chip,
+						  &max77818_debugfs_capacity_overrule_fops));
+	if (ret)
+		dev_err(chip->dev,
+			"Failed to generate debugfs 'capacity_overrule' (err %d)\n", ret);
+}
+
+static void max77818_debugfs_remove(struct max77818_chip *chip)
+{
+	debugfs_remove_recursive(chip->debugfs_root);
+}
+#else
+static void max77818_debugfs_add(struct max77818_chip *chip) { }
+static void max77818_debugfs_remove(struct max77818_chip *chip) { }
+#endif
