+
+/* Status register bits */
+#define STATUS_BR		BIT(15)
+#define STATUS_SMX		BIT(14)
+#define STATUS_TMX		BIT(13)
+#define STATUS_VMX		BIT(12)
+#define STATUS_BI		BIT(11)
+#define STATUS_SMN		BIT(10)
+#define STATUS_TMN		BIT(9)
+#define STATUS_VMN		BIT(8)
+#define STATUS_DSOCI		BIT(7)
+#define STATUS_BST		BIT(3)
+#define STATUS_POR		BIT(1)
+
+/* Config register bits */
+#define CONFIG_SPR_11		BIT(11)
+
+/* Config2 register bits */
+#define CONFIG2_DSOCEN		BIT(7)
+#define CONFIG2_TALRTEN		BIT(6)
+#define CONFIG2_LDMDL		BIT(5)
+
+#define VFSOC0_LOCK		0x0000
+#define VFSOC0_UNLOCK		0x0080
+#define MODEL_UNLOCK1		0X0059
+#define MODEL_UNLOCK2		0X00C4
+#define MODEL_LOCK1		0X0000
+#define MODEL_LOCK2		0X0000
+
+#define dQ_ACC_DIV		0x4
+#define dP_ACC_100		0x1900
+#define dP_ACC_200		0x3200
+
+#define MAX77818_VMAX_TOLERANCE	50 /* 50 mV */
+
+#define MIN_SOC_ALRT_DISABLE 0
+#define MAX_SOC_ALRT_DISABLE 0xFF
+
+#define CRITICAL_SOC_DEFAULT	6
+
+struct max77818_chip {
+	struct device *dev;
