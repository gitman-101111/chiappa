diff --git a/drivers/power/supply/max77818-charger.c b/drivers/power/supply/max77818-charger.c
new file mode 100644
index 000000000..15fa507e7
--- /dev/null
+++ b/drivers/power/supply/max77818-charger.c
@@ -0,0 +1,1202 @@
+/*
+ * Maxim MAX77818 Charger Driver
+ *
+ * Copyright (C) 2014 Maxim Integrated Product
+ *
+ * Copyright (C) 2019 reMarkable AS - http://www.remarkable.com/
+ *
+ * Author: Steinar Bakkemo <steinar.bakkemo@remarkable.com>
+ * Author: Shawn Guo  <shawn.guo@linaro.org>
+ * Author: Lars Ivar Miljeteig <lars.ivar.miljeteig@remarkable.com>
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License as
+ * published by the Free Software Foundation version 2.
+ *
+ * This program is distributed "as is" WITHOUT ANY WARRANTY of any
+ * kind, whether express or implied; without even the implied warranty
+ * of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * This driver is based on max77843.c
+ */
+
+#include <linux/kernel.h>
+#include <linux/version.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/err.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/mutex.h>
+#include <linux/interrupt.h>
+#include <linux/delay.h>
+#include <linux/regmap.h>
+#include <linux/io.h>
+#include <linux/of.h>
+#include <linux/of_irq.h>
+#include <linux/pinctrl/consumer.h>
+#include <linux/pm.h>
+#include <linux/power_supply.h>
+#include <linux/mfd/max77818/max77818.h>
+#include <linux/gpio/consumer.h>
+#include <linux/suspend.h>
+#include <linux/thermal.h>
+#include <linux/regulator/consumer.h>
+
+/* Register map */
+#define REG_CHG_INT 			0xB0
+#define REG_CHG_INT_MASK		0xB1
+#define BIT_AICL			BIT(7)
+#define BIT_CHGIN			BIT(6)
+#define BIT_WCIN              		BIT(5)
+#define BIT_CHG                 	BIT(4)
+#define BIT_BAT                 	BIT(3)
+#define BIT_BATP                	BIT(2)
+#define BIT_BYP				BIT(0)
+
+#define REG_CHG_INT_OK			0xB2
+#define BIT_AICL_OK			BIT(7)
+#define BIT_CHGIN_OK			BIT(6)
+#define BIT_WCIN_OK			BIT(5)
+#define BIT_CHG_OK			BIT(4)
+#define BIT_BAT_OK			BIT(3)
+#define BIT_BATP_OK			BIT(2)
+#define BIT_BYP_OK			BIT(0)
+
+#define REG_CHG_DTLS_00			0xB3
+#define BIT_CHGIN_DTLS			GENMASK(6, 5)
+#define BIT_WCIN_DTLS       		GENMASK(4, 3)
+#define BIT_BATP_DTLS       		BIT(0)
+
+#define REG_CHG_DTLS_01			0xB4
+#define BIT_TREG        		BIT(7)
+#define BIT_BAT_DTLS        		GENMASK(6, 4)
+#define SHIFT_BAT_DTLS			4
+#define BIT_CHG_DTLS       	 	GENMASK(3, 0)
+
+#define REG_CHG_DTLS_02			0xB5
+#define BIT_BYP_DTLS			GENMASK(3, 0)
+#define BIT_BCKNegILIM			BIT(2)
+#define BIT_BSTILIM			BIT(1)
+#define BIT_OTGILIM			BIT(0)
+
+#define REG_CHG_CNFG_00			0xB7
+#define BIT_OTG_CTRL			BIT(7)
+#define BIT_DISIBS			BIT(6)
+#define BIT_SPREAD			BIT(5)
+#define BIT_WDTEN			BIT(4)
+#define BIT_MODE			GENMASK(3, 0)
+#define BIT_MODE_BOOST			BIT(3)
+#define BIT_MODE_BUCK			BIT(2)
+#define BIT_MODE_OTG			BIT(1)
+#define BIT_MODE_CHARGER		BIT(0)
+#define MODE_ALL_OFF			0x00
+#define MODE_OTG_BUCK_BOOST		0x0F
+#define MODE_CHARGER_BUCK		0x05
+
+/* Read back charger status ranges */
+#define MODE_ALL_OFF_MIN		0x00
+#define MODE_ALL_OFF_MAX		0x03
+#define MODE_CHARGER_MIN		0x04
+#define MODE_CHARGER_MAX		0x07
+#define MODE_OTG_MIN			0x0e
+#define MODE_OTG_MAX			0x0f
+
+#define REG_CHG_CNFG_01			0xB8
+#define BIT_PQEN			BIT(7)
+#define BIT_LSEL			BIT(6)
+#define BIT_CHG_RSTRT			GENMASK(5, 4)
+#define SHIFT_CHG_RSTRT			4
+#define BIT_FSW				BIT(3)
+#define BIT_FCHGTIME			GENMASK(2, 0)
+
+#define REG_CHG_CNFG_02			0xB9
+#define BIT_OTG_ILIM			GENMASK(7, 6)
+#define BIT_CHG_CC			GENMASK(5, 0)
+
+#define REG_CHG_CNFG_03			0xBA
+#define BIT_ILIM			GENMASK(7, 6)
+#define BIT_TO_TIME			GENMASK(5, 3)
+#define SHIFT_TO_TIME			3
+#define BIT_TO_ITH			GENMASK(2, 0)
+
+#define REG_CHG_CNFG_04			0xBB
+#define BIT_CHG_CV_PRM			GENMASK(5, 0)
+#define SHIFT_MINVSYS			6
+
+#define REG_CHG_CNFG_06			0xBD
+#define BIT_CHGPROT			GENMASK(3, 2)
+#define BIT_WDTCLR			GENMASK(1, 0)
+
+#define REG_CHG_CNFG_07			0xBE
+#define BIT_REGTEMP			GENMASK(6, 5)
+
+#define REG_CHG_CNFG_09			0xC0
+#define BIT_CHGIN_ILIM			GENMASK(6, 0)
+
+#define REG_CHG_CNFG_10			0xC1
+#define BIT_WCIN_ILIM			GENMASK(5, 0)
+
+#define REG_CHG_CNFG_11			0xC2
+#define BIT_VBYPSET			GENMASK(6, 0)
+
+#define REG_CHG_CNFG_12			0xC3
+#define BIT_WCINSEL			BIT(6)
+#define BIT_CHGINSEL			BIT(5)
+#define BIT_VCHGIN_REG			GENMASK(4, 3)
+#define BIT_B2SOVRC			GENMASK(2, 0)
+
+enum {
+	CHGIN_DTLS_UVLO,
+	CHGIN_DTLS_INVALID_01,
+	CHGIN_DTLS_OVLO,
+	CHGIN_DTLS_VALID,
+};
+
+enum {
+	CHG_DTLS_PREQUAL,
+	CHG_DTLS_FASTCHARGE_CC,
+	CHG_DTLS_FASTCHARGE_CV,
+	CHG_DTLS_TOPOFF,
+	CHG_DTLS_DONE,
+	CHG_DTLS_RESEVRED_05,
+	CHG_DTLS_OFF_TIMER_FAULT,
+	CHG_DTLS_OFF_SUSPEND,
+	CHG_DTLS_OFF_INPUT_INVALID,
+	CHG_DTLS_RESERVED_09,
+	CHG_DTLS_OFF_JUCTION_TEMP,
+	CHG_DTLS_OFF_WDT_EXPIRED,
+};
+
+enum {
+	BAT_DTLS_NO_BATTERY,
+	BAT_DTLS_RESERVED_01,
+	BAT_DTLS_TIMER_FAULT,
+	BAT_DTLS_OKAY,
+	BAT_DTLS_OKAY_LOW,
+	BAT_DTLS_OVERVOLTAGE,
+	BAT_DTLS_OVERCURRENT,
+	BAT_DTLS_RESERVED_07,
+};
+
+enum {
+	CHG_INT_BYP_I,
+	CHG_INT_BATP_I,
+	CHG_INT_BAT_I,
+	CHG_INT_CHG_I,
+	CHG_INT_WCIN_I,
+	CHG_INT_CHGIN_I,
+	CHG_INT_AICL_I,
+};
+
+enum {
+	MAX77818_THERMAL_STATE_GLACIAL,
+	MAX77818_THERMAL_STATE_COLD,
+	MAX77818_THERMAL_STATE_COOL,
+	MAX77818_THERMAL_STATE_WARM,
+	MAX77818_THERMAL_STATE_HOT,
+	MAX77818_THERMAL_STATE_END,
+};
+
+struct thermal_opp {
+	u32 thermal_state;
+	u32 current_limit;
+	u32 voltage_limit;
+} __packed;
+
+struct max77818_charger {
+	struct device *dev;
+	struct regmap *regmap;
+	struct power_supply *psy_chg;
+	struct mutex lock;
+
+	u8 dtls[3];
+
+	int charger_mode; /* OTG SUPPLY/CHARGER */
+
+	int fast_charge_timer;
+	int fast_charge_current;
+	int topoff_current;
+	int topoff_timer;
+	int restart_threshold;
+	int termination_voltage;
+	int termination_voltage_cached;
+	int vsys_min;
+	int default_current_limit;
+	int input_current_limit_chgin;
+	int input_current_limit_chgin_req;
+
+	struct thermal_opp thermal_opp_table[MAX77818_THERMAL_STATE_END];
+	struct thermal_cooling_device *tcd;
+	unsigned int tcd_state;
+
+	struct regulator *vbus_limit;
+};
+
+static enum power_supply_property max77818_charger_props[] = {
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_CHARGE_TYPE,
+	POWER_SUPPLY_PROP_HEALTH,
+	POWER_SUPPLY_PROP_ONLINE,
+	POWER_SUPPLY_PROP_CURRENT_MAX,
+	POWER_SUPPLY_PROP_CHARGER_MODE,
+};
+
+static int max77818_get_online(struct max77818_charger *chg, int *val)
+{
+	u32 chg_int_ok;
+	int ret;
+
+	ret = regmap_read(chg->regmap, REG_CHG_INT_OK, &chg_int_ok);
+	if (ret)
+		return ret;
+
+	*val = !!(chg_int_ok & BIT_CHGIN_OK);
+
+	return 0;
+}
+
+static int max77818_charger_get_input_current(struct max77818_charger *chg,
+					      int *input_current)
+{
+	int quotient, remainder;
+	int steps[3] = { 0, 33, 67 };
+	u32 val = 0;
+	int ret;
+
+	ret = regmap_read(chg->regmap, REG_CHG_CNFG_09, &val);
+	if (ret)
+		return ret;
+
+	quotient = val / 3;
+	remainder = val % 3;
+
+	if ((val & BIT_CHGIN_ILIM) < 3)
+		*input_current = 100;
+	else if ((val & BIT_CHGIN_ILIM) > 0x78)
+		*input_current = 4000;
+	else
+		*input_current = quotient * 100 + steps[remainder];
+
+	return 0;
+}
+
+static int
+max77818_charger_set_chgin_current_limit(struct max77818_charger *chg,
+					 int input_current)
+{
+	int quotient, remainder;
+	u8 val = 0;
+	int ret;
+
+	if (input_current == 0) {
+		ret = regmap_update_bits(chg->regmap, REG_CHG_CNFG_12,
+					 BIT_CHGINSEL, 0);
+		if (ret)
+			dev_warn(chg->dev, "Failed to clear CHGINSEL\n");
+	}
+	else {
+		ret = regmap_update_bits(chg->regmap, REG_CHG_CNFG_12,
+					 BIT_CHGINSEL, BIT_CHGINSEL);
+		if (ret)
+			dev_warn(chg->dev, "Failed to set CHGINSEL\n");
+
+		quotient = input_current / 100;
+		remainder = input_current % 100;
+
+		if (remainder >= 67)
+			val |= (quotient * 3) + 2;
+		else if (remainder >= 33)
+			val |= (quotient * 3) + 1;
+		else if (remainder < 33)
+			val |= quotient * 3;
+	}
+
+	dev_dbg(chg->dev, "Setting CHGIN_ILIM=0x%02x\n", val);
+	return regmap_update_bits(chg->regmap, REG_CHG_CNFG_09,
+				  BIT_CHGIN_ILIM, val);
+}
+
+static int max77818_charger_set_enable(struct max77818_charger *chg, int en)
+{
+	u8 mode;
+	int ret;
+
+	/* If enable = 0, just shut off charging/otg power */
+	if (!en) {
+		mode = MODE_ALL_OFF;
+		goto update_mode;
+	}
+
+	/*
+	 * Depending on configured mode, turn on charging or OTG
+	 * power.
+	 */
+	if (chg->charger_mode == POWER_SUPPLY_MODE_CHARGER) {
+		mode = MODE_CHARGER_BUCK;
+	} else if (chg->charger_mode == POWER_SUPPLY_MODE_OTG_SUPPLY) {
+		mode = MODE_OTG_BUCK_BOOST;
+	} else {
+		dev_err(chg->dev, "invalid charger_mode %d\n",
+			chg->charger_mode);
+		return -EINVAL;
+	}
+
+update_mode:
+	dev_info(chg->dev, "set MODE bits to 0x%x", mode);
+	ret = regmap_update_bits(chg->regmap, REG_CHG_CNFG_00, BIT_MODE, mode);
+	if (ret) {
+		dev_err(chg->dev, "failed to update MODE bits: %d\n", ret);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int max77818_charger_get_charger_mode(struct max77818_charger *chg)
+{
+	int ret;
+	u32 read_val;
+
+	dev_dbg(chg->dev, "Trying to read current charger mode from device\n");
+
+	ret = regmap_read(chg->regmap, REG_CHG_CNFG_00, &read_val);
+	if (ret) {
+		return ret;
+	}
+	dev_dbg(chg->dev, "Read raw charger_mode register: 0x%02x\n", read_val);
+	dev_dbg(chg->dev, "Read charger_mode 0x%02lx\n", (read_val & BIT_MODE));
+
+	switch(read_val & BIT_MODE)
+	{
+	case MODE_ALL_OFF_MIN ... MODE_ALL_OFF_MAX:
+		chg->charger_mode = POWER_SUPPLY_MODE_ALL_OFF;
+		break;
+	case MODE_CHARGER_MIN ... MODE_CHARGER_MAX:
+		chg->charger_mode = POWER_SUPPLY_MODE_CHARGER;
+		break;
+	case MODE_OTG_MIN ... MODE_OTG_MAX:
+		chg->charger_mode = POWER_SUPPLY_MODE_OTG_SUPPLY;
+		break;
+	default:
+		dev_warn(chg->dev,
+			 "Unknown charger_mode read from device: 0x%02lx\n",
+			 (read_val & BIT_MODE));
+	}
+
+	return 0;
+}
+
+static int max77818_get_chgcc_limit(struct max77818_charger *chg, int *limit_ma)
+{
+	u32 val;
+	int ret;
+
+	ret = regmap_read(chg->regmap, REG_CHG_CNFG_02, &val);
+	if (ret)
+		return ret;
+
+	val &= 0x3f;
+
+	if (val < 0x3)
+		*limit_ma = 100;
+	else if (val > 0x3b)
+		*limit_ma = 3000;
+	else
+		*limit_ma = val * 50;
+
+	return 0;
+}
+
+static int max77818_set_chgcc_limit(struct max77818_charger *chg, int limit_ma)
+{
+	u32 val;
+
+	if (limit_ma > chg->fast_charge_current)
+		limit_ma = chg->fast_charge_current;
+
+	val = limit_ma / 50;
+
+	dev_dbg(chg->dev, "Setting CHG_CC to 0x%x (%d mA)\n", val, limit_ma);
+
+	return regmap_update_bits(chg->regmap, REG_CHG_CNFG_02, BIT_CHG_CC, val);
+}
+
+static int max77818_get_chgcv_limit(struct max77818_charger *chg, int *limit_mv)
+{
+	u32 val;
+	int ret;
+
+	ret = regmap_read(chg->regmap, REG_CHG_CNFG_04, &val);
+	if (ret)
+		return ret;
+
+	val &= 0x3f;
+
+	if (val < 0x1c)
+		*limit_mv = 3650 + val * 25;
+	else if (val == 0x1c)
+		*limit_mv = 4340;
+	else if (val < 0x2b)
+		*limit_mv = 3650 + (val - 1) * 25;
+	else
+		*limit_mv = 4700;
+
+	return 0;
+}
+
+static u32 max77818_chgcv_limit_mv_to_val(int mv)
+{
+	u32 val;
+
+	if (mv < 3650)
+		val = 0x0;
+	else if (mv <= 4325)
+		val = DIV_ROUND_UP(mv - 3650, 25);
+	else if (mv <= 4340)
+		val = 0x1c;
+	else if (mv <= 4700)
+		val = DIV_ROUND_UP(mv - 3650, 25) + 1;
+	else
+		val = 0x2b;
+
+	return val;
+}
+
+static int max77818_set_chgcv_limit(struct max77818_charger *chg, int limit_mv)
+{
+	u32 val = max77818_chgcv_limit_mv_to_val(limit_mv);
+
+	dev_dbg(chg->dev, "Setting CHG_CV_PRM to 0x%x (%d mV)\n", val, limit_mv);
+
+	return regmap_update_bits(chg->regmap, REG_CHG_CNFG_04, BIT_CHG_CV_PRM, val);
+}
+
+static int max77818_charger_initialize(struct max77818_charger *chg)
+{
+	struct device *dev = chg->dev;
+	u8 val, tmpval;
+	int ret;
+
+	/* unlock charger register */
+	ret = regmap_update_bits(chg->regmap, REG_CHG_CNFG_06,
+				 BIT_CHGPROT, BIT_CHGPROT);
+	if (ret) {
+		dev_err(dev, "failed to unlock: %d\n", ret);
+		return ret;
+	}
+
+	/* Initialize charger mode */
+	ret = regmap_update_bits(chg->regmap, REG_CHG_CNFG_00, BIT_MODE, MODE_CHARGER_BUCK);
+	if (ret) {
+		dev_err(dev, "failed to enable charger: %d\n", ret);
+		return ret;
+	}
+
+	/* charge current (mA) */
+	ret = max77818_set_chgcc_limit(chg, chg->fast_charge_current);
+	if (ret) {
+		dev_err(dev, "failed to set charge current: %d\n", ret);
+		return ret;
+	}
+
+	/* default max input current limited to safe value
+	 * Both chgin current limit, chgcc and chgcv will update once the
+	 * thermal device is registered.
+	 */
+	chg->input_current_limit_chgin_req = chg->default_current_limit;
+	ret = max77818_charger_set_chgin_current_limit(
+				chg,
+				chg->default_current_limit);
+	if (ret) {
+		dev_err(dev, "failed to set chgin input current: %d\n", ret);
+		return ret;
+	}
+
+	/* WCIN port is not used, so disable it */
+	ret = regmap_update_bits(chg->regmap, REG_CHG_CNFG_12, BIT_WCINSEL, 0);
+	if (ret) {
+		dev_err(dev, "failed to disable WCIN port: %d\n", ret);
+		return ret;
+	}
+
+	/* topoff current (mA) */
+	if (chg->topoff_current < 100)
+		val = 0x00;
+	else if (chg->topoff_current < 200)
+		val = (chg->topoff_current - 100) / 25;
+	else if (chg->topoff_current < 350)
+		val = chg->topoff_current / 50;
+	else
+		val = 0x07;
+
+	/* topoff timer (min) */
+	val |= (chg->topoff_timer / 10) << SHIFT_TO_TIME;
+
+	ret = regmap_update_bits(chg->regmap, REG_CHG_CNFG_03,
+				 BIT_TO_ITH | BIT_TO_TIME, val);
+	if (ret) {
+		dev_err(dev, "failed to update topoff bits: %d\n", ret);
+		return ret;
+	}
+
+	/* charge restart threshold(mV) */
+	if (chg->restart_threshold <= 0)
+		val = 0x03; /* disable */
+	else if (chg->restart_threshold > 200)
+		val = 0x02; /* 200 mV */
+	else
+		val = (chg->restart_threshold - 100) / 50;
+
+	/* fast-charge timer(hr) */
+	if (chg->fast_charge_timer <= 0 || chg->fast_charge_timer > 16)
+		tmpval = 0x00; /* disable */
+	else if (chg->fast_charge_timer > 16)
+		tmpval = 0x07; /* 16 hours */
+	else
+		tmpval = chg->fast_charge_timer / 2 - 1;
+
+	val = val << SHIFT_CHG_RSTRT | tmpval;
+
+	/* Enable Low Battery Prequalification Mode */
+	val |= BIT_PQEN;
+
+	ret = regmap_update_bits(chg->regmap, REG_CHG_CNFG_01,
+				 BIT_CHG_RSTRT | BIT_FCHGTIME | BIT_PQEN, val);
+	if (ret) {
+		dev_err(dev, "failed to update CNFG_01: %d\n", ret);
+		return ret;
+	}
+
+	/* charge termination voltage (mV) */
+	val = max77818_chgcv_limit_mv_to_val(chg->termination_voltage);
+
+	/* vsys min voltage */
+	if (chg->vsys_min < 3400)
+		tmpval = 0x00;
+	else if (chg->vsys_min <= 3700)
+		tmpval = DIV_ROUND_UP(chg->vsys_min - 3400, 100);
+	else
+		tmpval = 0x03;
+
+	val = val | tmpval << SHIFT_MINVSYS;
+
+	ret = regmap_write(chg->regmap, REG_CHG_CNFG_04, val);
+	if (ret) {
+		dev_err(dev, "failed to update CNFG_04: %d\n", ret);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int max77818_get_status(struct max77818_charger *chg, int *val)
+{
+	int ret;
+	u32 reg;
+
+	ret = regmap_read(chg->regmap, REG_CHG_DTLS_01, &reg);
+	if (ret)
+		return ret;
+
+	switch (reg & BIT_CHG_DTLS) {
+	case CHG_DTLS_PREQUAL:
+	case CHG_DTLS_FASTCHARGE_CC:
+	case CHG_DTLS_FASTCHARGE_CV:
+	case CHG_DTLS_TOPOFF:
+		*val = POWER_SUPPLY_STATUS_CHARGING;
+		break;
+	case CHG_DTLS_DONE:
+		*val = POWER_SUPPLY_STATUS_FULL;
+		break;
+	case CHG_DTLS_OFF_TIMER_FAULT:
+	case CHG_DTLS_OFF_SUSPEND:
+		*val = POWER_SUPPLY_STATUS_NOT_CHARGING;
+		break;
+	case CHG_DTLS_OFF_INPUT_INVALID:
+	case CHG_DTLS_OFF_JUCTION_TEMP:
+	case CHG_DTLS_OFF_WDT_EXPIRED:
+		*val = POWER_SUPPLY_STATUS_DISCHARGING;
+		break;
+	default:
+		*val = POWER_SUPPLY_STATUS_UNKNOWN;
+	}
+
+	return 0;
+}
+
+static int max77818_get_charge_type(struct max77818_charger *chg, int *val)
+{
+	int ret;
+	u32 reg;
+
+	ret = regmap_read(chg->regmap, REG_CHG_DTLS_01, &reg);
+	if (ret)
+		return ret;
+
+	switch (reg & BIT_CHG_DTLS) {
+	case CHG_DTLS_PREQUAL:
+		*val = POWER_SUPPLY_CHARGE_TYPE_TRICKLE;
+		break;
+	case CHG_DTLS_FASTCHARGE_CC:
+	case CHG_DTLS_FASTCHARGE_CV:
+		*val = POWER_SUPPLY_CHARGE_TYPE_FAST;
+		break;
+	case CHG_DTLS_TOPOFF:
+		*val = POWER_SUPPLY_CHARGE_TYPE_STANDARD;
+		break;
+	case CHG_DTLS_DONE:
+	case CHG_DTLS_OFF_TIMER_FAULT:
+	case CHG_DTLS_OFF_SUSPEND:
+	case CHG_DTLS_OFF_INPUT_INVALID:
+	case CHG_DTLS_OFF_JUCTION_TEMP:
+	case CHG_DTLS_OFF_WDT_EXPIRED:
+		*val = POWER_SUPPLY_CHARGE_TYPE_NONE;
+		break;
+	default:
+		*val = POWER_SUPPLY_CHARGE_TYPE_UNKNOWN;
+	}
+
+	return 0;
+}
+
+static int max77818_get_health(struct max77818_charger *chg, int *val)
+{
+	int ret;
+	u32 reg;
+
+	ret = regmap_read(chg->regmap, REG_CHG_DTLS_01, &reg);
+	if (ret)
+		return ret;
+
+	switch ((reg & BIT_BAT_DTLS) >> SHIFT_BAT_DTLS) {
+	case BAT_DTLS_NO_BATTERY:
+		*val = POWER_SUPPLY_HEALTH_NO_BATTERY;
+		break;
+	case BAT_DTLS_OKAY:
+	case BAT_DTLS_OKAY_LOW:
+		*val = POWER_SUPPLY_HEALTH_GOOD;
+		break;
+	case BAT_DTLS_TIMER_FAULT:
+		*val = POWER_SUPPLY_HEALTH_SAFETY_TIMER_EXPIRE;
+		break;
+	case BAT_DTLS_OVERVOLTAGE:
+		*val = POWER_SUPPLY_HEALTH_OVERVOLTAGE;
+		break;
+	case BAT_DTLS_OVERCURRENT:
+		*val = POWER_SUPPLY_HEALTH_OVERCURRENT;
+		break;
+	default:
+		*val = POWER_SUPPLY_HEALTH_UNKNOWN;
+	}
+
+	return 0;
+}
+
+static int max77818_charger_get_property(struct power_supply *psy,
+					 enum power_supply_property psp,
+					 union power_supply_propval *val)
+{
+	struct max77818_charger *chg = (struct max77818_charger*) psy->drv_data;
+	int ret = 0;
+
+	mutex_lock(&chg->lock);
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_ONLINE:
+		ret = max77818_get_online(chg, &val->intval);
+		break;
+	case POWER_SUPPLY_PROP_HEALTH:
+		ret = max77818_get_health(chg, &val->intval);
+		break;
+	case POWER_SUPPLY_PROP_STATUS:
+		ret = max77818_get_status(chg, &val->intval);
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_TYPE:
+		ret = max77818_get_charge_type(chg, &val->intval);
+		break;
+	case POWER_SUPPLY_PROP_CURRENT_MAX:
+		ret = max77818_charger_get_input_current(chg, &val->intval);
+		if (ret) {
+			ret = -ENODEV;
+			goto out;
+		}
+		val->intval = val->intval * 1000; /* mA to uA */
+		break;
+	case POWER_SUPPLY_PROP_CHARGER_MODE:
+		ret = max77818_charger_get_charger_mode(chg);
+		if (ret) {
+			ret = -ENODEV;
+			goto out;
+		}
+		val->intval = chg->charger_mode;
+		break;
+	default:
+		ret = -EINVAL;
+		goto out;
+	}
+
+out:
+	mutex_unlock(&chg->lock);
+	return ret;
+}
+
+/*
+ * FG temperature register for special use to enable no battery operation,
+ * but still retain IEC-62368-1 compliance.
+ * The only way to know the battery is present or not is to use the NTC.
+ */
+#define MAX77818_TEMP	0x08
+
+static bool max77818_charger_battery_present(struct max77818_charger *chg)
+{
+	struct max77818_dev *max77818 = dev_get_drvdata(chg->dev->parent);
+	struct regmap *map = max77818->regmap_fg;
+	u32 data = 0xe1aa; /* -301 deci-centigrade, no ntc */
+	int temp;
+
+	regmap_read(map, MAX77818_TEMP, &data);
+	temp = sign_extend32(data, 15);
+
+	/* The value is converted into deci-centigrade scale */
+	/* Units of LSB = 1 / 256 degree Celsius */
+	temp = temp * 10 / 256;
+
+	if (temp < -100) /* deci-centigrade */
+		return false;
+
+	return true;
+}
+
+static int max77818_charger_set_property(struct power_supply *psy,
+					 enum power_supply_property psp,
+					 const union power_supply_propval *val)
+{
+	struct max77818_charger *chg = (struct max77818_charger *) psy->drv_data;
+	int current_max = 0;
+	int chgcc_limit = 0;
+	int ret = 0;
+
+	mutex_lock(&chg->lock);
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_CHARGER_MODE:
+		if (val->intval == POWER_SUPPLY_MODE_CHARGER ||
+		    val->intval == POWER_SUPPLY_MODE_ALL_OFF ||
+		    val->intval == POWER_SUPPLY_MODE_OTG_SUPPLY) {
+			chg->charger_mode = val->intval;
+		} else {
+			ret = -EINVAL;
+			goto out;
+		}
+
+		/*
+		 * Disable charger, but only if it's requested.
+		 */
+		if (val->intval == POWER_SUPPLY_MODE_ALL_OFF)
+			max77818_charger_set_enable(chg, 0);
+		else
+			max77818_charger_set_enable(chg, 1);
+		break;
+	case POWER_SUPPLY_PROP_CURRENT_MAX:
+		current_max = min(val->intval / 1000, chg->input_current_limit_chgin);
+		dev_dbg(chg->dev,
+			"Setting new current max for chgin interface: %d\n",
+			current_max);
+
+		/*
+		 * Truncate to chgcc to follow the temperature jeita settings
+		 * but only if battery is present.
+		 */
+		chg->input_current_limit_chgin_req = current_max;
+		if (max77818_charger_battery_present(chg)) {
+			ret = max77818_get_chgcc_limit(chg, &chgcc_limit);
+			if (!ret)
+				current_max = min(chgcc_limit, current_max);
+		}
+
+		ret = max77818_charger_set_chgin_current_limit(chg, current_max);
+		if (ret) {
+			dev_err(chg->dev,
+				"failed to set chgin input current: %d\n",
+				ret);
+
+			goto out;
+		}
+		break;
+	default:
+		ret = -EINVAL;
+		goto out;
+	}
+
+out:
+	mutex_unlock(&chg->lock);
+	return ret;
+}
+
+static int max77818_charger_property_is_writeable(struct power_supply *psy,
+						  enum power_supply_property psp)
+{
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_CHARGER_MODE:
+	case POWER_SUPPLY_PROP_CURRENT_MAX:
+		return 1;
+	default:
+		return 0;
+	}
+}
+
+static int max77818_charger_parse_dt(struct max77818_charger *chg)
+{
+	struct device_node *np = chg->dev->of_node;
+
+	if (!np) {
+		dev_err(chg->dev, "no charger OF node\n");
+		return -ENODEV;
+	}
+
+	if (of_property_read_u32(np, "fast_charge_timer",
+				 &chg->fast_charge_timer))
+		chg->fast_charge_timer = 4; // 4 hours
+
+	if (of_property_read_u32(np, "fast_charge_current",
+				 &chg->fast_charge_current))
+		chg->fast_charge_current = 450; // 450mA
+
+	if (of_property_read_u32(np, "charge_termination_voltage",
+				 &chg->termination_voltage))
+		chg->termination_voltage = 4200; // 4200mV
+
+	if (of_property_read_u32(np, "topoff_timer", &chg->topoff_timer))
+		chg->topoff_timer = 30; // 30 min
+
+	if (of_property_read_u32(np, "topoff_current",
+				 &chg->topoff_current))
+		chg->topoff_current = 150; // 150mA
+
+	if (of_property_read_u32(np, "restart_threshold",
+				 &chg->restart_threshold))
+		chg->restart_threshold = 150; // 150mV
+
+	if (of_property_read_u32(np, "default_current_limit",
+				 &chg->default_current_limit))
+		chg->default_current_limit = 500; // 500mA
+
+	if (of_property_read_u32(np, "input_current_limit_chgin",
+				 &chg->input_current_limit_chgin))
+		chg->input_current_limit_chgin = chg->default_current_limit;
+
+	of_property_read_variable_u32_array(np, "thermal-charge-table",
+					    (u32 *)chg->thermal_opp_table,
+					    0, sizeof(chg->thermal_opp_table) / 4);
+
+	chg->vbus_limit = devm_regulator_get_optional(chg->dev, "vbus-limit");
+	if (IS_ERR(chg->vbus_limit)) {
+		if (PTR_ERR(chg->vbus_limit) == -EPROBE_DEFER)
+			return -EPROBE_DEFER;
+
+		chg->vbus_limit = NULL;
+	}
+
+	return 0;
+}
+
+static const struct power_supply_desc psy_chg_desc = {
+	.name = "max77818-charger",
+	.type = POWER_SUPPLY_TYPE_USB,
+	.properties = max77818_charger_props,
+	.num_properties = ARRAY_SIZE(max77818_charger_props),
+	.get_property = max77818_charger_get_property,
+	.set_property = max77818_charger_set_property,
+	.property_is_writeable = max77818_charger_property_is_writeable,
+};
+
+static int max77818_tcd_get_max_state(struct thermal_cooling_device *cdev,
+				      unsigned long *state)
+{
+	*state = MAX77818_THERMAL_STATE_HOT;
+	return 0;
+}
+
+static int max77818_tcd_get_cur_state(struct thermal_cooling_device *cdev,
+				      unsigned long *state)
+{
+	struct max77818_charger *chg = cdev->devdata;
+
+	*state = chg->tcd_state;
+	return 0;
+}
+
+static int max77818_tcd_set_cur_state(struct thermal_cooling_device *cdev,
+				      unsigned long state)
+{
+	struct max77818_charger *chg = cdev->devdata;
+	int mA_new, mA_now;
+	int mV_new, mV_now;
+	int chgin_current_max;
+	int ret;
+
+	WARN_ON(state >= ARRAY_SIZE(chg->thermal_opp_table));
+
+	mA_new = chg->thermal_opp_table[state].current_limit;
+	mV_new = chg->thermal_opp_table[state].voltage_limit;
+
+	ret = max77818_get_chgcc_limit(chg, &mA_now);
+	if (ret)
+		return ret;
+
+	ret = max77818_get_chgcv_limit(chg, &mV_now);
+	if (ret)
+		return ret;
+
+	chg->tcd_state = state;
+
+	if (mA_now == mA_new && mV_now == mV_new)
+		goto done;
+
+	dev_info(chg->dev, "Thermal regulation (%lu): %dmA/%dmV -> %dmA/%dmV\n",
+		 state, mA_now, mV_now, mA_new, mV_new);
+
+	/* if we increase mA, increase the vbus limit first */
+	if (chg->vbus_limit && (mA_new > mA_now))
+		regulator_set_current_limit(chg->vbus_limit, 0, mA_new * 1000);
+
+	if (mA_now != mA_new) {
+		ret = max77818_set_chgcc_limit(chg, mA_new);
+		if (ret)
+			return ret;
+	}
+
+	if (mV_now != mV_new) {
+		ret = max77818_set_chgcv_limit(chg, mV_new);
+		if (ret)
+			return ret;
+	}
+
+	chgin_current_max = min(mA_new, chg->input_current_limit_chgin_req);
+	ret = max77818_charger_set_chgin_current_limit(chg, chgin_current_max);
+	if (ret)
+		return ret;
+
+	/* if we decrease mA, reduce the vbus limit last */
+	if (chg->vbus_limit && (mA_new < mA_now)) {
+		/* delay to let the current settle before limiting the regulator */
+		usleep_range(1000, 2000);
+		regulator_set_current_limit(chg->vbus_limit, 0, mA_new * 1000);
+	}
+
+done:
+	return 0;
+}
+
+static const struct thermal_cooling_device_ops max77818_tcd_ops = {
+	.get_max_state = max77818_tcd_get_max_state,
+	.get_cur_state = max77818_tcd_get_cur_state,
+	.set_cur_state = max77818_tcd_set_cur_state,
+};
+
+static irqreturn_t max77818_charger_isr(int irq, void *data)
+{
+	struct max77818_charger *chg = data;
+	int chgcc_limit;
+	u32 val;
+
+	/* CHG_INT register bits are R/C */
+	regmap_read(chg->regmap, REG_CHG_INT, &val);
+
+	if (val & BIT_CHGIN) {
+		/*
+		 * Datasheet specifies a 150 ms delay from CHGIN OK (INOKB H → L) to
+		 * Start Switching.  Testing on boards suggests that 200 ms is more
+		 * reliable for "status" property to be updated with uevent.
+		 *
+		 * Also datesheet seems specify the delay only for charger attaching,
+		 * but testing suggests that the delay is needed for charger detaching
+		 * as well.
+		 */
+
+		/* Set a temporary high current limit while processing the CHGIN interrupt
+		 * The charger overshoots the current above ~1A when it starts switching, which
+		 * would trigger the current limit. This works around the issue by first setting
+		 * it to the higher fast charge limit, and then back to the same
+		 * as limited chgcc per temperature.
+		 */
+
+		if (chg->vbus_limit)
+			regulator_set_current_limit(chg->vbus_limit, 0,
+						    chg->fast_charge_current * 1000);
+
+		msleep(200);
+
+		if (max77818_charger_battery_present(chg) &&
+		    !max77818_get_chgcc_limit(chg, &chgcc_limit) && chg->vbus_limit)
+			regulator_set_current_limit(chg->vbus_limit, 0, chgcc_limit * 1000);
+	}
+
+	if (val & BIT_CHG)
+		dev_info(chg->dev, "charge state event\n");
+
+	power_supply_changed(chg->psy_chg);
+
+	return IRQ_HANDLED;
+}
+
+static int max77818_charger_init_interrupt(struct max77818_dev *max77818,
+					   struct max77818_charger *chg)
+{
+	u32 int_mask = BIT_CHGIN | BIT_CHG;
+	struct device *dev = chg->dev;
+	int irq;
+	int ret;
+
+	/* Unmask needed interrupts */
+	regmap_update_bits(chg->regmap, REG_CHG_INT_MASK, 0xff, ~int_mask);
+
+	/* Register irq handler for the charger interrupt */
+	irq = regmap_irq_get_virq(max77818->irqc_intsrc, MAX77818_CHGR_INT);
+	if (irq <= 0) {
+		dev_err(dev, "failed to get virq: %d\n", irq);
+		return -ENODEV;
+	}
+
+	ret = devm_request_threaded_irq(dev, irq, NULL,
+					max77818_charger_isr,
+					0, "charger", chg);
+	if (ret) {
+		dev_err(dev, "failed to request charger irq: %d\n", ret);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int max77818_charger_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct max77818_dev *max77818 = dev_get_drvdata(dev->parent);
+	struct power_supply_config psy_cfg = {};
+	struct max77818_charger *chg;
+	int ret;
+
+	chg = devm_kzalloc(dev, sizeof(*chg), GFP_KERNEL);
+	if (!chg)
+		return -ENOMEM;
+
+	platform_set_drvdata(pdev, chg);
+	chg->dev = dev;
+	chg->regmap = max77818->regmap_chg;
+
+	mutex_init(&chg->lock);
+
+	ret = max77818_charger_parse_dt(chg);
+	if (ret)
+		return ret;
+
+	psy_cfg.drv_data = chg;
+	psy_cfg.fwnode = dev_fwnode(dev);
+
+	ret = max77818_charger_initialize(chg);
+	if (ret)
+		dev_warn(dev, "failed to init charger: %d\n", ret);
+
+	chg->psy_chg = devm_power_supply_register(dev, &psy_chg_desc, &psy_cfg);
+	if (IS_ERR(chg->psy_chg)) {
+		ret = PTR_ERR(chg->psy_chg);
+		dev_err(dev, "failed to register supply: %d\n", ret);
+		return ret;
+	}
+
+	ret = max77818_charger_init_interrupt(max77818, chg);
+	if (ret) {
+		dev_err(dev, "Failed to init interrupt: %d\n", ret);
+		return ret;
+	}
+
+	chg->tcd = devm_thermal_of_child_cooling_device_register(dev, dev->of_node, "max77818-cooling",
+							   chg, &max77818_tcd_ops);
+	if (IS_ERR(chg->tcd))
+		return dev_err_probe(dev, PTR_ERR(chg->tcd), "failed to register cooling device\n");
+
+	return 0;
+}
+
+static int max77818_charger_suspend(struct device *dev)
+{
+	struct max77818_charger *chg = dev_get_drvdata(dev);
+	int current_limit;
+
+	/* Cache charge termination voltage - FGCC might change it if activated */
+	max77818_get_chgcv_limit(chg, &chg->termination_voltage_cached);
+
+	/* Set a low current limit during suspend.
+	 * This is to avoid having thermal wakeup in all power modes
+	 */
+	current_limit = chg->thermal_opp_table[MAX77818_THERMAL_STATE_GLACIAL].current_limit;
+	max77818_charger_set_chgin_current_limit(chg, current_limit);
+
+	if (chg->vbus_limit) {
+		/* delay to let the current settle before limiting the regulator */
+		usleep_range(1000, 2000);
+		regulator_set_current_limit(chg->vbus_limit, 0,
+					    current_limit * 1000);
+	}
+
+	return 0;
+}
+
+static int max77818_charger_resume(struct device *dev)
+{
+	struct max77818_charger *chg = dev_get_drvdata(dev);
+	int current_max, chgcc_limit;
+
+	/* restore and truncate to chgcc to follow the temperature jeita settings */
+	current_max = chg->input_current_limit_chgin_req;
+	if (!max77818_get_chgcc_limit(chg, &chgcc_limit))
+		current_max = min(chgcc_limit, current_max);
+
+	/* Restore charge termination voltage - FGCC might have changed it */
+	max77818_set_chgcv_limit(chg, chg->termination_voltage_cached);
+
+	if (chg->vbus_limit)
+		regulator_set_current_limit(chg->vbus_limit, 0,
+					    chgcc_limit * 1000);
+
+	max77818_charger_set_chgin_current_limit(chg, current_max);
+
+	return 0;
+}
+
+static const struct dev_pm_ops max77818_chg_pm = {
+	.suspend = max77818_charger_suspend,
+	.resume = max77818_charger_resume,
+};
+
+static const struct platform_device_id max77818_charger_id_table[] = {
+	{ MAX77818_CHARGER_NAME },
+	{ }
+};
+MODULE_DEVICE_TABLE(platform, max77818_charger_id_table);
+
+static struct of_device_id max77818_charger_of_match[] = {
+	{ .compatible = "maxim,max77818-charger" },
+	{ },
+};
+MODULE_DEVICE_TABLE(of, max77818_charger_of_match);
+
+static struct platform_driver max77818_charger_driver = {
+	.driver = {
+		.name = MAX77818_CHARGER_NAME,
+		.owner = THIS_MODULE,
+		.of_match_table = max77818_charger_of_match,
+		.pm = &max77818_chg_pm,
+	},
+	.probe = max77818_charger_probe,
+	.id_table = max77818_charger_id_table,
+};
+module_platform_driver(max77818_charger_driver);
+
+MODULE_LICENSE("GPL v2");
+MODULE_DESCRIPTION("MAX77818 Charger Driver");
+MODULE_AUTHOR("TaiEup Kim <clark.kim@maximintegrated.com>");
